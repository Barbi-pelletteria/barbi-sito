# Copia questo file in ".dev.vars" per lo sviluppo locale con
# "npx wrangler pages dev dist" (il sito gira su Cloudflare Pages da D-016,
# non più su Netlify — questo file si chiamava ".env" quando serviva a
# "netlify dev", il nome ".dev.vars" è quello che Wrangler legge da solo).
# Sul progetto vero, le stesse chiavi vanno in Cloudflare Pages:
# Workers & Pages → barbi-sito → Settings → Environment variables
# (mai committate in questo repo).

# --- B2: Stripe (modalità TEST — chiavi che iniziano con pk_test_/sk_test_) ---
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_INSERISCI_QUI_LA_TUA_CHIAVE
STRIPE_SECRET_KEY=sk_test_INSERISCI_QUI_LA_TUA_CHIAVE

# --- B4: Google Analytics 4 ---
# Measurement ID della property GA4, formato G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- D-025: Brevo (invio email dei moduli contatto/reso/su misura) ---
# Chiave API transazionale, da dashboard.brevo.com → Impostazioni → Chiavi API
BREVO_API_KEY=INSERISCI_QUI_LA_TUA_CHIAVE_BREVO
