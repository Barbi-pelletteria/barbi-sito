---
// Otto domande, nell'ordine e con i testi del QG (D-029 § 4.9 e § 4.14).
// Le risposte stanno in un solo elenco, usato sia per la pagina sia per il
// FAQPage JSON-LD: se una cambia, cambiano insieme.
import Layout from '../layouts/Layout.astro';

const faq = [
  {
    d: 'Com’è possibile questo prezzo per un portafoglio lavorato a mano?',
    r: 'Perché lo compri direttamente da chi lo realizza. Tra il laboratorio di Stefano e te non ci sono distributori, negozi o ricarichi di marchio. Il prezzo comprende già la spedizione.',
  },
  {
    d: 'Che pelle usate?',
    r: 'Pelle di capra conciata al vegetale, spessore 1,2-1,3 mm. Stefano la descrive così: «conciata e tinta naturalmente, senza protezioni chimiche: materiale vivo e delicato». Vivo, perché con l’uso cambia tono e diventa unico. Delicato, perché teme acqua, oli e sole più di una pelle trattata industrialmente: per questo vale la pena saperla curare.',
  },
  {
    d: 'Come si cura?',
    r: 'Tienilo lontano da acqua, creme e fonti di calore, e conservalo all’asciutto. Le istruzioni complete sono nella scheda di ogni portafoglio, alla voce «Cura della pelle».',
    link: { testo: 'Cura della pelle', href: '/prodotto/sottile/#cura' },
  },
  {
    d: 'Posso regalarlo con le iniziali?',
    r: 'Sì. Le iniziali vengono impresse sulla pelle prima della spedizione, per 10 € in più e senza giorni di attesa aggiuntivi. Un pezzo personalizzato non può essere reso, perché realizzato su tua richiesta.',
  },
  {
    d: 'Quanto ci mette ad arrivare?',
    r: 'Spediamo in tutta Italia con GLS o Poste Italiane, gratis. La consegna richiede 1-3 giorni lavorativi dalla spedizione.',
  },
  {
    d: 'Posso restituirlo?',
    r: 'Hai 14 giorni dalla consegna per il recesso, come previsto dalla legge. Tutti i passaggi sono nella pagina Diritto di recesso.',
    link: { testo: 'Diritto di recesso', href: '/diritto-di-recesso/' },
  },
  {
    d: 'Come posso pagare?',
    r: 'Con carta di credito o di debito, su una pagina di pagamento protetta Stripe: i dati della carta non passano mai dal nostro sito.',
  },
  {
    d: 'Realizzate anche pezzi su misura?',
    r: 'Sì: un colore diverso, una combinazione particolare, un’idea tua. Raccontala a Stefano dalla pagina Su misura.',
    link: { testo: 'Su misura', href: '/prodotto-personalizzato/' },
  },
];

// Nella pagina, la parte della risposta che nomina una pagina del sito
// diventa un link a quella pagina (stesso testo, solo cliccabile).
function conLink(voce) {
  if (!voce.link) return [voce.r];
  const i = voce.r.indexOf(voce.link.testo);
  if (i < 0) return [voce.r];
  return [voce.r.slice(0, i), voce.link, voce.r.slice(i + voce.link.testo.length)];
}

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((v) => ({
    '@type': 'Question',
    name: v.d,
    acceptedAnswer: { '@type': 'Answer', text: v.r },
  })),
};
---
<Layout title="Domande frequenti" description="Pelle, cura, iniziali, spedizione, recesso e pagamenti: le risposte alle domande più frequenti sui portafogli Barbi.">
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>
  <div class="contenitore">
    <section class="pagina-testo faq">
      <h1>Domande frequenti</h1>

      {faq.map((v) => (
        <article class="faq__voce">
          <h2>{v.d}</h2>
          <p>{conLink(v).map((parte) => (typeof parte === 'string' ? parte : <a href={parte.href}>{parte.testo}</a>))}</p>
        </article>
      ))}
    </section>
  </div>
</Layout>

<style>
  .faq h1 { margin-bottom: 40px; }
  .faq__voce { margin-bottom: 44px; padding-bottom: 44px; border-bottom: 1px solid var(--line); }
  .faq__voce:last-of-type { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .faq__voce h2 { font-size: clamp(20px, 2.4vw, 24px); margin: 0 0 14px; }
</style>
