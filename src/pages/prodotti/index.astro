---
// Hub delle categorie, aggiunto il 27/08/2026 su richiesta diretta del
// Founder: "vendiamo anche tanto altro" (non solo portafogli). Portachiavi
// e borse sono reali — il racconto le cita già — ma restano vuote finché
// non arrivano pezzi veri in laboratorio: zero prodotti finti.
import Layout from '../../layouts/Layout.astro';
import { categorie, getProdottiByCategoria } from '../../data/prodotti.js';

const conteggi = categorie.map((c) => ({ ...c, quantita: getProdottiByCategoria(c.slug).length }));
---
<Layout title="Prodotti">
  <div class="contenitore">
    <section class="sec">
      <div class="sec-top">
        <h1>Prodotti</h1>
        <p>Quello che facciamo in laboratorio, per categoria.</p>
      </div>

      <div class="categorie-grid">
        {conteggi.map((c) => (
          <a href={`/${c.slug}/`} class:list={['categoria-card', { 'categoria-card--vuota': c.quantita === 0 }]}>
            <h2>{c.nome}</h2>
            <p>{c.quantita > 0 ? `${c.quantita} modell${c.quantita === 1 ? 'o' : 'i'} disponibil${c.quantita === 1 ? 'e' : 'i'}` : 'In arrivo'}</p>
          </a>
        ))}
      </div>

      <p class="prodotti__su-misura">Non trovi quello che cerchi? <a href="/prodotto-personalizzato/">Chiedi un pezzo su misura</a>.</p>
    </section>
  </div>
</Layout>

<style>
  h1 { font-size: clamp(30px, 4.4vw, 44px); max-width: none; margin: 0 auto 12px; }

  .prodotti__su-misura {
    text-align: center; margin: 40px 0 0; color: var(--ink2); font-size: 16.5px;
  }
  .prodotti__su-misura a { color: var(--brass-testo); }

  .categorie-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 740px) { .categorie-grid { grid-template-columns: 1fr; } }

  .categoria-card {
    display: block; padding: 34px 26px; border: 1px solid var(--line);
    text-decoration: none; color: inherit; text-align: center;
  }
  .categoria-card:hover { border-color: var(--brass); }
  .categoria-card h2 { font-size: 25px; margin: 0 0 10px; }
  .categoria-card p {
    margin: 0; font-family: var(--f-label); font-size: 11px; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; color: var(--brass-testo);
  }
  .categoria-card--vuota p { color: var(--ink3); }
</style>
