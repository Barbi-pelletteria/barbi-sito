---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Pagina non trovata">
  <section class="contenitore pagina-stretta">
    <h1>Pagina non trovata</h1>
    <p>La pagina che cerchi non esiste o è stata spostata.</p>
    <p><a class="pulsante" href="/">Torna alla home</a></p>
  </section>
</Layout>

<style>
  .pagina-stretta { max-width: 62ch; padding: 80px 0; }
  .pagina-stretta h1 { font-size: clamp(28px, 4vw, 40px); max-width: none; }
  .pagina-stretta p { color: var(--ink2); margin: 0 0 22px; }
</style>
