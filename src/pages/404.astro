---
import Layout from '../layouts/Layout.astro';
// Testi D-029 § 4.13 (QG).
---
<Layout title="Pagina non trovata" description="La pagina che cerchi non esiste. I portafogli Barbi sì: scopri la collezione.">
  <div class="contenitore">
    <section class="pagina-stretta">
      <h1>Questa pagina non esiste.</h1>
      <p>I portafogli sì.</p>
      <p><a class="pulsante" href="/portafogli/">Scopri la collezione</a></p>
    </section>
  </div>
</Layout>

<style>
  .pagina-stretta { max-width: 660px; margin: 0 auto; padding: 100px 0; text-align: center; }
  .pagina-stretta h1 { font-size: clamp(30px, 4.4vw, 44px); }
  .pagina-stretta p { color: var(--ink2); margin: 0 0 28px; }
</style>
