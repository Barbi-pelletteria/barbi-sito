---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Checkout">
  <div class="contenitore">
    <section class="pagina-checkout">
      <h1>Checkout</h1>
      <p class="nota-test">Ambiente di test — nessun pagamento reale. Usa la carta Stripe di test 4242 4242 4242 4242, qualunque data futura, qualunque CVC.</p>

      <div id="checkout-vuoto" hidden>
        <p class="checkout__vuoto-testo">Il carrello è vuoto.</p>
        <a class="pulsante" href="/portafogli/">Vai al catalogo</a>
      </div>

      <div id="checkout-contenuto" hidden>
        <ul id="riepilogo-righe" class="riepilogo-righe"></ul>
        <p class="checkout__totale">Totale <span id="checkout-totale"></span></p>
        <button class="pulsante" id="btn-paga">Procedi al pagamento</button>
        <p id="errore-checkout" class="errore-checkout" hidden></p>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { getCart } from '../scripts/cart.js';
  import { getProdottoBySlug, getColore, formatEuro, INIZIALI_CENTESIMI } from '../data/prodotti.js';
  import { trackEvent } from '../scripts/analytics.js';

  const cart = getCart();
  const vuoto = document.getElementById('checkout-vuoto');
  const contenuto = document.getElementById('checkout-contenuto');
  const lista = document.getElementById('riepilogo-righe');
  const totaleEl = document.getElementById('checkout-totale');
  const btnPaga = document.getElementById('btn-paga');
  const errore = document.getElementById('errore-checkout');

  function unitCentesimi(prodotto, riga) {
    return prodotto.prezzoCentesimi + (riga.iniziali ? INIZIALI_CENTESIMI : 0);
  }

  if (cart.length === 0) {
    vuoto.hidden = false;
  } else {
    contenuto.hidden = false;
    let totale = 0;
    cart.forEach((riga) => {
      const prodotto = getProdottoBySlug(riga.slug);
      if (!prodotto) return;
      const colore = getColore(prodotto, riga.colore);
      const unit = unitCentesimi(prodotto, riga);
      totale += unit * riga.quantita;
      const dettaglio = [
        colore ? colore.nome : riga.colore,
        riga.iniziali ? `iniziali: ${riga.iniziali}` : null,
      ].filter(Boolean).join(' · ');
      const li = document.createElement('li');
      li.textContent = `${prodotto.nome} (${dettaglio}) × ${riga.quantita} — ${formatEuro(unit * riga.quantita)}`;
      lista.appendChild(li);
    });
    totaleEl.textContent = formatEuro(totale);

    // GA4 — begin_checkout: parte solo se il consenso ai cookie è stato dato.
    trackEvent('begin_checkout', {
      currency: 'EUR',
      value: totale / 100,
      items: cart.map((r) => ({ item_id: r.slug, quantity: r.quantita })),
    });
  }

  btnPaga?.addEventListener('click', async () => {
    btnPaga.disabled = true;
    btnPaga.textContent = 'Attendere…';
    errore.hidden = true;

    try {
      const items = cart
        .map((r) => {
          const prodotto = getProdottoBySlug(r.slug);
          if (!prodotto) return null;
          const colore = getColore(prodotto, r.colore);
          return {
            slug: r.slug,
            nome: prodotto.nome,
            colore: colore ? colore.nome : r.colore,
            iniziali: r.iniziali || '',
            quantita: r.quantita,
            prezzoCentesimi: prodotto.prezzoCentesimi,
            inizialiCentesimi: r.iniziali ? INIZIALI_CENTESIMI : 0,
          };
        })
        .filter(Boolean);

      const risposta = await fetch('/.netlify/functions/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items, siteUrl: window.location.origin }),
      });

      let dati = null;
      const isJson = (risposta.headers.get('content-type') || '').includes('application/json');
      if (isJson) {
        dati = await risposta.json();
      }

      if (!risposta.ok || !dati || !dati.url) {
        const messaggioServer = dati && dati.error;
        throw new Error(
          messaggioServer ||
            'Impossibile contattare la funzione di pagamento (probabile: il sito non gira ancora su Netlify, o mancano le chiavi Stripe di test).'
        );
      }

      window.location.href = dati.url;
    } catch (err) {
      errore.textContent = `Errore: ${err.message}. Controlla che le chiavi Stripe di test siano configurate su Netlify (vedi SETUP.md).`;
      errore.hidden = false;
      btnPaga.disabled = false;
      btnPaga.textContent = 'Procedi al pagamento';
    }
  });
</script>

<!--
  is:global: le voci del riepilogo nascono da createElement nello script qui
  sopra e gli stili con ambito di Astro non le raggiungono.
-->
<style is:global>
  .pagina-checkout { max-width: 660px; padding: 64px 0; }
  .pagina-checkout h1 { font-size: clamp(30px, 4.4vw, 44px); max-width: none; margin: 0 0 26px; }

  .nota-test {
    font-family: var(--f-label); font-size: 12px; line-height: 1.7; letter-spacing: .04em;
    color: var(--ink3); background: var(--sunk); border-left: 2px solid var(--line2);
    padding: 14px 16px; margin: 0 0 30px;
  }
  .checkout__vuoto-testo { color: var(--ink2); margin: 0 0 26px; }

  .riepilogo-righe { list-style: none; padding: 0; margin: 0 0 30px; }
  .riepilogo-righe li {
    padding: 16px 0; border-bottom: 1px solid var(--line);
    font-size: 17px; color: var(--ink2); font-variant-numeric: tabular-nums;
  }

  .checkout__totale {
    margin: 0 0 26px; font-family: var(--f-display); font-size: 27px;
    font-variant-numeric: tabular-nums;
  }

  /*
    La tavolozza non prevede un rosso e l'ottone è l'unico accento: l'errore
    si distingue col filetto in ottone e il testo a piena leggibilità, senza
    inventare un colore che il marchio non ha.
  */
  .errore-checkout {
    margin-top: 22px; font-size: 16.5px; color: var(--ink);
    border-left: 2px solid var(--brass); padding: 14px 16px; background: var(--sunk);
  }
</style>
