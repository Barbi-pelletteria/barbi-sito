---
// Scheda prodotto, struttura e testi D-029 § 4.3/4.4 (QG). Ordine dei
// blocchi dall'alto: galleria → eyebrow → nome → prezzo → frase breve →
// colore → disponibilità → iniziali → pulsante (o "Avvisami" a vendita
// spenta) → tre righe di servizio → punti di forza → descrizione →
// fisarmoniche (Dettagli e misure / Cura della pelle / Spedizione e resi)
// → rimando all'altro modello.
//
// Rispetto alla versione precedente spariscono: la riga "Reso · Garanzia"
// (art. 23 lett. l, Parte 3), il pulsante spento "Disponibile a breve" e
// la nota "La vendita online non è ancora attiva…" (sostituiti dal campo
// Avvisami), il confronto spessori (non nell'ordine dei blocchi del
// pacchetto — il dato vive nei punti di forza), l'elenco capienza (dentro
// "Dettagli e misure"). Tabella e "Cura della pelle" restano invariati,
// dentro le fisarmoniche. La fodera in poliestere resta dichiarata.
//
// La galleria è un'unica striscia a scorrimento (scroll-snap): da
// computer se ne vede una foto alla volta e le miniature sotto la fanno
// scorrere; da telefono (D-029 § 2.2, vedi CSS) si sfoglia col dito, con
// i puntini al posto delle miniature.
import Layout from '../../layouts/Layout.astro';
import FotoSegnaposto from '../../components/FotoSegnaposto.astro';
import { galleriaProdotto } from '../../data/immagini.js';
import {
  prodotti,
  getProdottoBySlug,
  curaProdotto,
  avvisoIniziali,
  formatEuroBreve,
  VENDITA_ATTIVA,
  EMAIL_CONTATTO,
  INIZIALI_CENTESIMI,
  MACRO_PELLE,
  CONSENSO_NEWSLETTER,
} from '../../data/prodotti.js';

export function getStaticPaths() {
  return prodotti.map((p) => ({ params: { slug: p.slug }, props: { prodotto: p } }));
}

const { prodotto } = Astro.props;
const stockTotale = prodotto.colori.reduce((t, c) => t + c.stock, 0);
const esauritoTutto = stockTotale === 0;
const primoDisponibile = prodotto.colori.find((c) => c.stock > 0)?.slug || '';
const coloreIniziale = prodotto.colori.find((c) => c.slug === primoDisponibile) || prodotto.colori[0];
const altro = getProdottoBySlug(prodotto.rimando.slug);

// Galleria completa per il colore iniziale (server-side, per il primo
// caricamento) e per tutti gli altri colori (dentro datiClient, per lo
// scambio via JS quando si cambia colore).
const galleriaIniziale = galleriaProdotto(prodotto, coloreIniziale);
const galleriaPerColore = Object.fromEntries(
  prodotto.colori.map((c) => [c.slug, galleriaProdotto(prodotto, c)])
);

// Dati minimi che servono allo script lato client.
const datiClient = {
  slug: prodotto.slug,
  nome: prodotto.nome,
  prezzoCentesimi: prodotto.prezzoCentesimi,
  inizialiCentesimi: INIZIALI_CENTESIMI,
  colori: prodotto.colori.map((c) => ({ slug: c.slug, nome: c.nome, stock: c.stock })),
  venditaAttiva: VENDITA_ATTIVA,
  galleria: galleriaPerColore,
};

const mailtoPrenota = `mailto:${EMAIL_CONTATTO}?subject=${encodeURIComponent(
  'Prenotazione portafoglio ' + prodotto.nome
)}`;

// Tre righe di servizio (§ 4.3, QG). Icone: segni lineari a tratto unico,
// stesso linguaggio dell'icona carrello in testata — nessun simbolo
// "inventato" al posto di un contenuto, solo il segnale della riga.
const RIGHE_SERVIZIO = [
  { icona: 'spedizione', testo: 'Spedizione gratuita, consegna in 1-3 giorni dalla spedizione' },
  { icona: 'carta', testo: 'Pagamento con carta, protetto da Stripe' },
  { icona: 'recesso', testo: 'Recesso entro 14 giorni e garanzia legale di 24 mesi, come previsto dalla legge' },
];
const ICONE = {
  spedizione: '<path d="M1.5 6.5h12v10h-12z"/><path d="M13.5 10h4.5l3 3.5v3h-7.5z"/><circle cx="5.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
  carta: '<rect x="2" y="5.5" width="20" height="13" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/>',
  recesso: '<path d="M4 12a8 8 0 1 1 2.4 5.7"/><path d="M4 18v-6h6"/>',
  spessore: '<path d="M3 16.5 16.5 3l4.5 4.5L7.5 21z"/><path d="m7 12.5 2 2M10 9.5l2 2M13 6.5l2 2"/>',
  pelle: '<path d="M4 20c0-9 5-14 16-16-1 11-6 16-14 16"/><path d="M4 20c4-5 8-8 12-11"/>',
  bordi: '<path d="M20 3c-3 0-9 6-11 9l3 3c3-2 9-8 8-12z"/><path d="M9 12c-2 0-4 1-4 4 0 2-1 3-2 3 3 1 7 0 8-3z"/>',
  tasche: '<rect x="3" y="7" width="14" height="10" rx="1.5"/><path d="M7 4h14v10"/>',
  portamonete: '<circle cx="12" cy="12" r="8"/><path d="M12 8v8M9.5 10.5h5M9.5 13.5h5"/>',
};

// Dati strutturati Product (PACCHETTO_AUDIT_SITO blocco C), valori veri.
// "availability" resta PreOrder finché VENDITA_ATTIVA è false.
const prodottoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: prodotto.nome,
  description: prodotto.sommario,
  image: new URL(galleriaIniziale[0]?.jpg || '/marchio-pelle.jpg', Astro.site).href,
  brand: { '@type': 'Brand', name: 'Barbi Pelletteria' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: (prodotto.prezzoCentesimi / 100).toFixed(2),
    availability: VENDITA_ATTIVA
      ? (esauritoTutto ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock')
      : 'https://schema.org/PreOrder',
    url: `${Astro.site}prodotto/${prodotto.slug}/`,
  },
};
---
<Layout
  title={prodotto.nome}
  description={prodotto.metaDescription}
  ogImage={galleriaIniziale[0]?.jpg}
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(prodottoJsonLd)} />
  </Fragment>
  <div class="contenitore">
    <div class="pdp">
      <div class="pdp-col-foto">
        {galleriaIniziale.length > 0 ? (
          <div class="pdp-galleria" id="pdp-galleria">
            <div class="pdp-track" id="pdp-track" aria-label={`Foto del portafoglio ${prodotto.nome}`}>
              {galleriaIniziale.map((f, i) => (
                <picture class="pdp-slide">
                  <source srcset={f.webp} type="image/webp" />
                  <img src={f.jpg} alt={f.alt} width={f.width} height={f.height} loading={i === 0 ? 'eager' : 'lazy'} />
                </picture>
              ))}
            </div>
            <div class="pdp-puntini" id="pdp-puntini" aria-hidden="true"></div>
            {galleriaIniziale.length > 1 && (
              <div class="pdp-miniature" id="pdp-miniature" role="group" aria-label="Altre immagini del prodotto">
                {galleriaIniziale.map((f, i) => (
                  <button
                    type="button"
                    class:list={['pdp-miniatura', { on: i === 0 }]}
                    data-index={i}
                    aria-current={i === 0 ? 'true' : undefined}
                    aria-label={f.alt}
                  >
                    <img src={f.webp} alt="" width="72" height="90" loading={i === 0 ? 'eager' : 'lazy'} />
                  </button>
                ))}
              </div>
            )}
          </div>
        ) : (
          <FotoSegnaposto id="foto-pdp" etichetta={`Foto — ${prodotto.nome}, ${coloreIniziale.nome.toLowerCase()}`} />
        )}
      </div>

      <div class="pdp-col-info">
        <p class="p-kick pdp-kick">{prodotto.occhiello}</p>
        <h1>{prodotto.nome}</h1>
        <div class="p-price pdp-prezzo">{formatEuroBreve(prodotto.prezzoCentesimi)}<em>spedizione inclusa</em></div>
        <p class="pdp-frase">{prodotto.fraseBreve}</p>

        <!--
          Le pastiglie colore stanno fuori dal form di acquisto (che esiste solo
          quando VENDITA_ATTIVA è vero) così restano visibili anche a vendita
          spenta. Nessun dato di magazzino viene ricalcolato qui.
        -->
        <fieldset class="colori">
          <legend class="sr-only">Colore</legend>
          <p class="pdp-colore">Colore: <span id="colore-nome">{coloreIniziale.nome}</span></p>
          <div class="swatches pdp-swatches">
            {prodotto.colori.map((c) => (
              <label class="sw-wrap">
                <input
                  type="radio"
                  name="colore"
                  value={c.slug}
                  data-stock={c.stock}
                  disabled={c.stock === 0}
                  checked={c.slug === primoDisponibile}
                />
                <span
                  class="sw"
                  data-c={c.slug}
                  title={c.nome}
                  style={MACRO_PELLE[c.slug] ? `background-image:url(${MACRO_PELLE[c.slug]})` : undefined}
                ></span>
              </label>
            ))}
          </div>
        </fieldset>
        <!-- Solo se lo stock reale del colore è ≤ 5 (§ 4.3), mai numeri finti. -->
        <p class="pdp-scorte" id="pdp-scorte" hidden></p>

        <!--
          Il riquadro delle iniziali resta visibile anche a vendita spenta.
          La casella da spuntare è legata a VENDITA_ATTIVA — ricompare da
          sola quando l'interruttore passa a true.
        -->
        <div class="opt">
          <label class:list={['opt__label', { 'opt__label--statico': !VENDITA_ATTIVA }]}>
            {VENDITA_ATTIVA && <input type="checkbox" id="iniziali-checkbox" />}
            <span>
              <span class="t">Aggiungi le tue iniziali · +{formatEuroBreve(INIZIALI_CENTESIMI)}</span>
              <span class="n">{avvisoIniziali}</span>
            </span>
          </label>
          {VENDITA_ATTIVA && (
            <>
              <label for="iniziali" class="sr-only">Iniziali</label>
              <input type="text" id="iniziali" name="iniziali" maxlength="3" autocomplete="off" placeholder="es. G.B." class="opt__input" hidden />
              <!--
                Anteprima simbolica, CSS puro (PACCHETTO_VETRINA punto 8):
                colore reale dello swatch selezionato, iniziali "impresse" via
                text-shadow. Non è una foto della pelle: lo dice anche il testo
                sotto, apposta.
              -->
              <div class="iniziali-anteprima" id="iniziali-anteprima" data-c={coloreIniziale.slug} hidden>
                <span id="iniziali-anteprima-testo">AB</span>
              </div>
              <p class="iniziali-anteprima__nota" id="iniziali-anteprima-nota" hidden>Anteprima simbolica del colore e delle iniziali — non è una foto della pelle vera.</p>
            </>
          )}
        </div>

        {/*
          [VENDITA ACCESA] pulsante "Aggiungi al carrello · 49 €", diventa
          "· 59 €" con le iniziali (§ 4.3).
          [VENDITA SPENTA] al posto del pulsante: campo email + "Avvisami
          quando è disponibile" — stesso invio Brevo della newsletter
          (functions/api/iscrivi-newsletter.js, double opt-in D-026),
          stessa casella di consenso. La classe .footer-news__form è quella
          che il gestore in Layout.astro intercetta: il modulo si comporta
          esattamente come quello del footer, colori a parte (qui su fondo
          chiaro, vedi CSS sotto).
        */}
        {VENDITA_ATTIVA ? (
          <form class="acquisto" id="form-acquisto" onsubmit="return false">
            <div class="acquisto__riga">
              <label for="quantita">Quantità</label>
              <input type="number" id="quantita" name="quantita" value="1" min="1" />
              <button class="buy" type="button" id="btn-aggiungi">Aggiungi al carrello · <span id="btn-prezzo">{formatEuroBreve(prodotto.prezzoCentesimi)}</span></button>
            </div>
            <p id="disponibilita" class="avviso" hidden></p>
          </form>
        ) : (
          <div class="avvisami" id="avvisami">
            <form class="footer-news__form avvisami__form" aria-label="Avvisami quando è disponibile">
              <label for="avvisami-email" class="sr-only">Email</label>
              <input type="email" id="avvisami-email" name="email" placeholder="La tua email" autocomplete="email" required />
              <button type="submit" class="pulsante" id="btn-avvisami">Avvisami quando è disponibile</button>
              <p class="footer-news__nascosto"><label>Non compilare questo campo <input name="nl-azienda" /></label></p>
              <label class="footer-news__consenso">
                <input type="checkbox" name="consenso" required />
                <span>{CONSENSO_NEWSLETTER}</span>
              </label>
              <p class="footer-news__consenso-nota"><a href="/privacy/">Leggi come trattiamo i tuoi dati</a>.</p>
              <p class="footer-news__messaggio" role="status" hidden></p>
            </form>
            <p class="avvisami__nota">Vuoi prenotarlo subito? Scrivi a <a href={mailtoPrenota}>{EMAIL_CONTATTO}</a></p>
          </div>
        )}

        {esauritoTutto && VENDITA_ATTIVA && (
          <p class="avviso">Al momento tutti i colori sono esauriti.</p>
        )}

        <ul class="servizio">
          {RIGHE_SERVIZIO.map((r) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONE[r.icona]} />
              <span>{r.testo}</span>
            </li>
          ))}
        </ul>

        <div class="punti">
          {prodotto.puntiForza.map((p) => (
            <div class="punto">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONE[p.icona]} />
              <div>
                <h2 class="punto__titolo">{p.titolo}</h2>
                <p>{p.testo}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="pdp-descrizione">
          {prodotto.descrizione.map((par) => <p>{par}</p>)}
        </div>

        <details class="fisarmonica">
          <summary>Dettagli e misure</summary>
          <div class="fisarmonica__corpo">
            <table>
              {prodotto.specifiche.map(([voce, valore]) => (
                <tr><th>{voce}</th><td>{valore}</td></tr>
              ))}
            </table>
          </div>
        </details>

        <details class="fisarmonica" id="cura">
          <summary>Cura della pelle</summary>
          <div class="fisarmonica__corpo">
            <p>{curaProdotto.intro}</p>
            <ul>
              {curaProdotto.punti.map((p) => <li>{p}</li>)}
            </ul>
            <p>{curaProdotto.chiusura}</p>
          </div>
        </details>

        <details class="fisarmonica">
          <summary>Spedizione e resi</summary>
          <div class="fisarmonica__corpo">
            <p>Spediamo in tutta Italia con GLS o Poste Italiane, gratis. La consegna richiede 1-3 giorni lavorativi dalla spedizione. Hai 14 giorni per il recesso, come previsto dalla legge; i pezzi con iniziali sono esclusi perché realizzati su tua richiesta.</p>
            <p><a class="link-freccia" href="/diritto-di-recesso/">Tutti i dettagli →</a></p>
          </div>
        </details>

        <p class="pdp-rimando"><a href={`/prodotto/${altro.slug}/`}>{prodotto.rimando.testo}</a></p>
      </div>
    </div>
  </div>

  {/*
    Barra fissa in basso, solo da telefono (D-029 § 2.2): compare quando
    il pulsante principale non è sullo schermo, sparisce quando rientra
    (IntersectionObserver, script sotto). A sinistra nome + prezzo
    aggiornato con le iniziali, a destra il pulsante. [VENDITA SPENTA] il
    pulsante porta al campo "Avvisami" nella pagina. Da computer non
    esiste (display:none), non è solo nascosta.
  */}
  <div class="barra-fissa" id="barra-fissa" hidden>
    <div class="barra-fissa__testo">
      <span class="barra-fissa__nome">{prodotto.nome}</span>
      <span class="barra-fissa__prezzo" id="barra-prezzo">{formatEuroBreve(prodotto.prezzoCentesimi)}</span>
    </div>
    {VENDITA_ATTIVA ? (
      <button type="button" class="pulsante barra-fissa__btn" id="barra-btn">Aggiungi al carrello</button>
    ) : (
      <a class="pulsante barra-fissa__btn" id="barra-btn" href="#avvisami">Avvisami</a>
    )}
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
</Layout>

<script type="application/json" id="prodotto-dati" is:inline set:html={JSON.stringify(datiClient)}></script>

<script>
  import { addToCart, getQuantitaColore } from '../../scripts/cart.js';
  import { trackEvent } from '../../scripts/analytics.js';
  import { formatEuroBreve } from '../../data/prodotti.js';

  const nodo = document.getElementById('prodotto-dati');
  const prodotto = nodo ? JSON.parse(nodo.textContent) : null;

  if (prodotto) {
    // GA4 — view_item (parte solo se il consenso ai cookie è stato dato).
    trackEvent('view_item', {
      currency: 'EUR',
      value: prodotto.prezzoCentesimi / 100,
      items: [{ item_id: prodotto.slug, item_name: prodotto.nome }],
    });

    // Le pastiglie stanno fuori dal form, quindi la ricerca è sul documento:
    // c'è comunque un solo selettore colore per pagina.
    function coloreSelezionato() {
      return document.querySelector('input[name="colore"]:checked');
    }
    function stockColore(slug) {
      const c = prodotto.colori.find((x) => x.slug === slug);
      return c ? c.stock : 0;
    }
    // Pezzi ancora aggiungibili per il colore scelto (stock meno quelli già nel carrello).
    function residuo(slug) {
      return Math.max(0, stockColore(slug) - getQuantitaColore(prodotto.slug, slug));
    }

    // Prezzo mostrato sul pulsante (e sulla barra fissa mobile): base, più
    // le iniziali se la casella è spuntata.
    const checkboxIniziali = document.getElementById('iniziali-checkbox');
    function prezzoCorrente() {
      return prodotto.prezzoCentesimi + (checkboxIniziali?.checked ? prodotto.inizialiCentesimi : 0);
    }
    function aggiornaPrezzoBottone() {
      const el = document.getElementById('btn-prezzo');
      if (el) el.textContent = formatEuroBreve(prezzoCorrente());
      document.dispatchEvent(new CustomEvent('pdp:prezzo', { detail: { centesimi: prezzoCorrente() } }));
    }

    const form = document.getElementById('form-acquisto');
    if (form) {
      const btn = document.getElementById('btn-aggiungi');
      const inputQ = document.getElementById('quantita');
      const inputIniziali = document.getElementById('iniziali');
      const disponibilita = document.getElementById('disponibilita');
      const toast = document.getElementById('toast');
      let toastTimer = null;

      function mostraToast(messaggio) {
        if (!toast) return;
        toast.textContent = messaggio;
        toast.hidden = false;
        toast.classList.add('toast--visibile');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('toast--visibile');
          setTimeout(() => { toast.hidden = true; }, 200);
        }, 2500);
      }

      function aggiorna() {
        const scelto = coloreSelezionato();
        if (!scelto) {
          btn.disabled = true;
          return;
        }
        const rimasti = residuo(scelto.value);
        inputQ.max = String(Math.max(1, rimasti));
        if (parseInt(inputQ.value, 10) > rimasti) inputQ.value = String(Math.max(1, rimasti));
        btn.disabled = rimasti === 0;
        if (rimasti === 0) {
          disponibilita.textContent = 'Questo colore è esaurito.';
          disponibilita.hidden = false;
        } else {
          disponibilita.hidden = true;
        }
      }

      document.querySelectorAll('input[name="colore"]').forEach((el) => {
        el.addEventListener('change', aggiorna);
      });
      inputQ.addEventListener('input', aggiorna);
      aggiorna();

      function aggiungi() {
        const scelto = coloreSelezionato();
        if (!scelto) return;
        const colore = scelto.value;
        const rimasti = residuo(colore);
        let quantita = Math.max(1, parseInt(inputQ.value, 10) || 1);

        if (rimasti === 0) {
          disponibilita.textContent = 'Questo colore è esaurito.';
          disponibilita.hidden = false;
          return;
        }
        if (quantita > rimasti) {
          quantita = rimasti;
          inputQ.value = String(rimasti);
          disponibilita.textContent = `Puoi aggiungerne al massimo ${rimasti} in questo colore.`;
          disponibilita.hidden = false;
        }

        const iniziali = (inputIniziali.value || '').trim().toUpperCase();
        addToCart({ slug: prodotto.slug, colore, iniziali, quantita });

        trackEvent('add_to_cart', {
          currency: 'EUR',
          items: [{ item_id: prodotto.slug, quantity: quantita }],
        });

        const nomeColore = prodotto.colori.find((x) => x.slug === colore)?.nome || colore;
        mostraToast(`${prodotto.nome} — ${nomeColore} aggiunto al carrello.`);
        aggiorna();
      }
      btn.addEventListener('click', aggiungi);
      // La barra fissa mobile (vedi script più sotto) riusa lo stesso gesto.
      document.addEventListener('pdp:aggiungi', aggiungi);

      // Il campo iniziali compare solo se la casella è spuntata.
      checkboxIniziali?.addEventListener('change', () => {
        inputIniziali.hidden = !checkboxIniziali.checked;
        if (!checkboxIniziali.checked) inputIniziali.value = '';
        aggiornaPrezzoBottone();
      });
      aggiornaPrezzoBottone();
    }

    // Sotto qui solo la vista: nome colore, scorte, didascalia del
    // segnaposto foto, galleria immagini, anteprima iniziali. Non tocca
    // stock, carrello o VENDITA_ATTIVA.
    const coloreNome = document.getElementById('colore-nome');
    const scorte = document.getElementById('pdp-scorte');
    const didascalia = document.querySelector('#foto-pdp b'); // solo se niente foto — segnaposto
    const anteprima = document.getElementById('iniziali-anteprima');
    const anteprimaTesto = document.getElementById('iniziali-anteprima-testo');
    const anteprimaNota = document.getElementById('iniziali-anteprima-nota');

    // Galleria: un'unica striscia a scorrimento. Cambiare colore
    // ricostruisce striscia, miniature e puntini da zero: il numero di
    // scatti può variare da un colore all'altro (vedi FOTO_SITO/LEGGIMI.md).
    const track = document.getElementById('pdp-track');
    const miniature = document.getElementById('pdp-miniature');
    const puntini = document.getElementById('pdp-puntini');
    let indiceCorrente = 0;

    function evidenzia(i) {
      indiceCorrente = i;
      miniature?.querySelectorAll('.pdp-miniatura').forEach((b, j) => {
        b.classList.toggle('on', j === i);
        if (j === i) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
      puntini?.querySelectorAll('span').forEach((p, j) => p.classList.toggle('on', j === i));
    }

    function vaiAScatto(i, animato = true) {
      if (!track) return;
      track.scrollTo({ left: i * track.clientWidth, behavior: animato ? 'smooth' : 'auto' });
      evidenzia(i);
    }

    function costruisciGalleria(scatti) {
      if (!track) return;
      track.innerHTML = '';
      scatti.forEach((s, i) => {
        const pic = document.createElement('picture');
        pic.className = 'pdp-slide';
        const src = document.createElement('source');
        src.srcset = s.webp;
        src.type = 'image/webp';
        const img = document.createElement('img');
        img.src = s.jpg;
        img.alt = s.alt;
        img.width = s.width;
        img.height = s.height;
        img.loading = i === 0 ? 'eager' : 'lazy';
        pic.append(src, img);
        track.appendChild(pic);
      });
      if (miniature) {
        miniature.innerHTML = '';
        scatti.forEach((s, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'pdp-miniatura';
          b.dataset.index = String(i);
          b.setAttribute('aria-label', s.alt);
          const img = document.createElement('img');
          img.src = s.webp;
          img.alt = '';
          img.width = 72;
          img.height = 90;
          img.loading = i === 0 ? 'eager' : 'lazy';
          b.appendChild(img);
          miniature.appendChild(b);
        });
      }
      if (puntini) {
        puntini.innerHTML = '';
        scatti.forEach(() => puntini.appendChild(document.createElement('span')));
      }
      vaiAScatto(0, false);
    }

    // Delega sul contenitore: le miniature vengono ricreate a ogni cambio
    // colore, un listener per bottone si perderebbe ogni volta.
    miniature?.addEventListener('click', (e) => {
      const b = e.target.closest('.pdp-miniatura');
      if (!b || !miniature.contains(b)) return;
      vaiAScatto(parseInt(b.dataset.index || '0', 10));
    });
    // Sfogliando col dito (o con lo scroll) la miniatura/il puntino attivo
    // seguono la foto visibile.
    let scrollTimer = null;
    track?.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        if (i !== indiceCorrente) evidenzia(i);
      }, 80);
    }, { passive: true });

    // Soglia scorte basse (§ 4.3): 5 pezzi o meno, sui numeri veri.
    const SOGLIA_SCORTE_BASSE = 5;

    function aggiornaVista() {
      const scelto = document.querySelector('input[name="colore"]:checked');
      if (!scelto) return;
      const c = prodotto.colori.find((x) => x.slug === scelto.value);
      if (!c) return;
      if (coloreNome) coloreNome.textContent = c.nome;
      if (scorte) {
        const bassa = c.stock > 0 && c.stock <= SOGLIA_SCORTE_BASSE;
        scorte.hidden = !bassa;
        // Accordo del verbo col numero (1 → "resta"), non un testo diverso.
        if (bassa) scorte.textContent = `${c.stock === 1 ? 'Ne resta' : 'Ne restano'} ${c.stock} in ${c.nome}`;
      }
      if (didascalia) {
        didascalia.textContent = `Foto — ${prodotto.nome}, ${c.nome.toLowerCase()}`;
      }
      costruisciGalleria(prodotto.galleria?.[c.slug] || []);
      if (anteprima) anteprima.setAttribute('data-c', c.slug);
    }
    document.querySelectorAll('input[name="colore"]').forEach((el) => {
      el.addEventListener('change', aggiornaVista);
    });
    aggiornaVista();

    // Barra fissa mobile (D-029 § 2.2): visibile solo quando il pulsante
    // principale (acquisto o Avvisami) non è nello schermo. Il CSS la
    // tiene display:none da computer, qui si gestisce solo [hidden].
    const barra = document.getElementById('barra-fissa');
    const barraBtn = document.getElementById('barra-btn');
    const barraPrezzo = document.getElementById('barra-prezzo');
    const pulsantePrincipale = document.getElementById('btn-aggiungi') || document.getElementById('btn-avvisami');
    if (barra && pulsantePrincipale && 'IntersectionObserver' in window) {
      const oss = new IntersectionObserver((voci) => {
        voci.forEach((v) => { barra.hidden = v.isIntersecting; });
      }, { threshold: 0 });
      oss.observe(pulsantePrincipale);
    }
    document.addEventListener('pdp:prezzo', (e) => {
      if (barraPrezzo) barraPrezzo.textContent = formatEuroBreve(e.detail.centesimi);
    });
    barraBtn?.addEventListener('click', (e) => {
      if (barraBtn.tagName === 'BUTTON') {
        document.dispatchEvent(new CustomEvent('pdp:aggiungi'));
        return;
      }
      // Vendita spenta: al campo Avvisami, col cursore già dentro.
      e.preventDefault();
      const campo = document.getElementById('avvisami-email');
      document.getElementById('avvisami')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => campo?.focus({ preventScroll: true }), 400);
    });

    // Anteprima "impressione" delle iniziali (PACCHETTO_VETRINA punto 8).
    if (anteprima && anteprimaTesto) {
      const inputIn = document.getElementById('iniziali');
      function aggiornaAnteprimaIniziali() {
        const valore = (inputIn?.value || '').trim().toUpperCase();
        const mostra = !inputIn?.hidden && valore.length > 0;
        anteprima.hidden = !mostra;
        if (anteprimaNota) anteprimaNota.hidden = !mostra;
        if (mostra) anteprimaTesto.textContent = valore;
      }
      inputIn?.addEventListener('input', aggiornaAnteprimaIniziali);
      checkboxIniziali?.addEventListener('change', aggiornaAnteprimaIniziali);
      aggiornaAnteprimaIniziali();
    }
  }
</script>

<!--
  is:global per galleria, puntini e barra fissa: gli elementi della galleria
  vengono ricreati via JS a ogni cambio colore (e al primo caricamento) e
  gli stili con ambito di Astro non li raggiungono — misurato: senza, la
  striscia rendeva 1574px di altezza invece di una foto per volta. Stessa
  ragione già documentata in carrello.astro. I nomi delle classi esistono
  solo in questa pagina.
-->
<style is:global>
  /* Galleria: striscia a scorrimento orizzontale con aggancio (scroll-snap),
     una foto per volta. Barra di scorrimento nascosta: si naviga con le
     miniature (computer) o col dito (telefono). width/height reali
     dichiarati sull'<img> evitano il salto di layout al caricamento. */
  .pdp-track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; border: 1px solid var(--line); background: var(--raise);
  }
  .pdp-track::-webkit-scrollbar { display: none; }
  .pdp-slide { flex: 0 0 100%; scroll-snap-align: start; display: block; }
  .pdp-slide img { display: block; width: 100%; height: auto; }

  .pdp-puntini { display: none; }

  .pdp-miniature {
    display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px;
    padding: 0; border: 0; list-style: none;
  }
  .pdp-miniatura {
    display: block; width: 72px; height: 90px; padding: 0; margin: 0;
    border: 1px solid var(--line2); background: var(--sunk); cursor: pointer;
    flex: 0 0 auto; position: relative;
  }
  .pdp-miniatura img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pdp-miniatura.on { border-color: var(--brass); border-width: 2px; }
  .pdp-miniatura:hover:not(.on) { border-color: var(--brass-testo); }
  .pdp-miniatura:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }

  /* Da telefono (D-029 § 2.2): si sfoglia col dito, una sola immagine
     visibile, puntini al posto della griglia di miniature. Riquadro 4/5
     (a 390px: 346×432px) invece dell'altezza naturale della foto (~458px):
     con questo eyebrow, nome e prezzo stanno nel primo schermo a 390×844
     (misurato, vedi resoconto). object-fit:cover ritaglia pochi px sopra
     e sotto, non deforma. */
  @media (max-width: 800px) {
    .pdp-slide { aspect-ratio: 4 / 5; }
    .pdp-slide img { height: 100%; object-fit: cover; }
    .pdp-miniature { display: none; }
    .pdp-puntini { display: flex; justify-content: center; gap: 8px; margin-top: 12px; min-height: 8px; }
    .pdp-puntini span { width: 8px; height: 8px; border-radius: 50%; background: var(--line2); transition: background 150ms ease; }
    .pdp-puntini span.on { background: var(--brass-testo); }
  }

  /* Barra fissa in basso, solo da telefono (D-029 § 2.2). z-index sotto il
     banner cookie (50) e sopra la testata sticky (40). */
  .barra-fissa { display: none; }
  @media (max-width: 800px) {
    .barra-fissa {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 45;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
      background: var(--raise); border-top: 1px solid var(--line);
      box-shadow: 0 -4px 16px rgba(33, 27, 23, .10);
    }
    .barra-fissa[hidden] { display: none; }
    .barra-fissa__testo { display: flex; flex-direction: column; min-width: 0; }
    .barra-fissa__nome { font-family: var(--f-display); font-size: 17px; line-height: 1.2; }
    .barra-fissa__prezzo { font-family: var(--f-label); font-size: 13px; letter-spacing: .04em; color: var(--ink2); font-variant-numeric: tabular-nums; }
    .barra-fissa__btn { flex: 0 0 auto; padding: 14px 18px; font-size: 11.5px; min-height: 48px; }
  }
</style>

<style>
  .pdp { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; padding: 70px 0; align-items: start; }
  /* padding-bottom da telefono: spazio per la barra fissa, che altrimenti
     coprirebbe il rimando finale. */
  @media (max-width: 800px) { .pdp { grid-template-columns: 1fr; gap: 28px; padding: 32px 0 100px; } }

  .pdp-kick { margin-top: 0; }
  .pdp h1 {
    font-size: clamp(30px, 4.4vw, 44px);
    margin: 8px 0 0;
    max-width: none;
    text-align: left;
  }
  .pdp-prezzo { font-size: 27px; }
  .pdp-frase { margin: 16px 0 0; color: var(--ink2); font-size: 17.5px; line-height: 1.6; }

  .colori { border: 0; padding: 0; margin: 26px 0 0; }
  .pdp-colore {
    margin: 0 0 10px; font-family: var(--f-label); font-size: 11px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--ink3);
  }
  .pdp-swatches { margin-top: 0; }
  .pdp-scorte { margin: 12px 0 0; font-size: 15px; color: var(--brass-testo); font-weight: 500; }

  .sw-wrap { position: relative; display: inline-block; line-height: 0; }
  /* inset:0 copre esattamente .sw (44px, la soglia di area toccabile). */
  .sw-wrap input {
    position: absolute; inset: 0; margin: 0;
    opacity: 0; cursor: pointer;
  }
  .sw-wrap input:disabled { cursor: not-allowed; }
  .sw-wrap input:checked + .sw::after {
    content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--brass);
  }
  .sw-wrap input:disabled + .sw { opacity: .32; }
  .sw-wrap input:focus-visible + .sw { outline: 2px solid var(--brass); outline-offset: 4px; }

  .opt { margin-top: 22px; padding: 17px; border: 1px solid var(--line); background: var(--raise); }
  .opt__label { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; }
  .opt__label--statico { cursor: default; }
  .opt input[type="checkbox"] { margin: 4px 0 0; width: 20px; height: 20px; accent-color: var(--brass); flex: 0 0 auto; }
  .opt .t { font-family: var(--f-label); font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .opt .n { display: block; margin-top: 8px; font-size: 16.5px; color: var(--ink2); line-height: 1.5; }
  .opt__input {
    margin-top: 14px; width: 9rem; padding: 11px; border: 1px solid var(--line2);
    background: var(--sunk); color: var(--ink); font-family: var(--f-label);
    font-size: 14px; letter-spacing: .1em; text-transform: uppercase;
  }

  /* Anteprima iniziali (PACCHETTO_VETRINA punto 8): riquadro nel colore
     reale scelto, lettere "impresse" solo via text-shadow. */
  .iniziali-anteprima {
    display: flex; align-items: center; justify-content: center;
    width: 88px; height: 58px; margin-top: 14px; border: 1px solid var(--line2);
  }
  .iniziali-anteprima[hidden] { display: none; }
  .iniziali-anteprima[data-c="blu"] { background: var(--blu); }
  .iniziali-anteprima[data-c="bordeaux"] { background: var(--bordeaux); }
  .iniziali-anteprima[data-c="marrone"] { background: var(--marrone); }
  .iniziali-anteprima span {
    font-family: var(--f-display); font-size: 23px; letter-spacing: .07em;
    text-transform: uppercase; color: rgba(255, 255, 255, .16);
    text-shadow:
      -1px -1px 1px rgba(255, 255, 255, .5),
      1px 1.5px 1.5px rgba(0, 0, 0, .55);
  }
  .iniziali-anteprima__nota {
    margin: 8px 0 0; font-size: 12.5px; font-style: italic; color: var(--ink3);
    max-width: 22rem;
  }

  .buy { margin-top: 26px; width: 100%; }
  .acquisto__riga { display: flex; align-items: center; gap: 14px; margin-top: 26px; flex-wrap: wrap; }
  .acquisto__riga label {
    font-family: var(--f-label); font-size: 10.5px; font-weight: 600;
    letter-spacing: .16em; text-transform: uppercase; color: var(--ink3);
  }
  .acquisto__riga input {
    width: 5rem; padding: 15px 12px; border: 1px solid var(--line2);
    background: var(--sunk); color: var(--ink); font-size: 16px;
    font-variant-numeric: tabular-nums;
  }
  .acquisto__riga .buy { width: auto; flex: 1 1 12rem; margin-top: 0; }
  .avviso { margin-top: 14px; font-size: 16.5px; color: var(--ink2); }

  /* Avvisami (vendita spenta): stesso modulo del footer, ma su fondo
     chiaro — le classi .footer-news__* sono pensate per il fondo scuro,
     qui si riprendono con i colori del resto della scheda. */
  .avvisami { margin-top: 26px; padding: 20px; border: 1px solid var(--line); background: var(--raise); }
  .avvisami .footer-news__form input[type="email"] {
    background: var(--sunk); border-color: var(--line2); color: var(--ink); font-size: 16px;
  }
  .avvisami .footer-news__form input[type="email"]::placeholder { color: var(--ink3); }
  .avvisami .footer-news__form .pulsante { flex: 1 1 auto; }
  .avvisami .footer-news__consenso { color: var(--ink2); font-size: 13.5px; }
  .avvisami .footer-news__consenso-nota { color: var(--ink3); }
  .avvisami .footer-news__consenso-nota a { color: var(--brass-testo); }
  .avvisami .footer-news__messaggio { color: var(--ink); }
  .avvisami__nota { margin: 16px 0 0; font-size: 15.5px; color: var(--ink2); }
  .avvisami__nota a { color: var(--brass-testo); overflow-wrap: anywhere; }

  /* Tre righe di servizio: icona + testo, senza link (art. 23 lett. l:
     recesso e garanzia come informazione, "come previsto dalla legge"). */
  .servizio {
    list-style: none; margin: 26px 0 0; padding: 18px 0 6px; border-top: 1px solid var(--line);
    display: grid; gap: 10px;
  }
  .servizio li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; line-height: 1.5; color: var(--ink2); }
  .servizio svg { width: 20px; height: 20px; flex: 0 0 auto; margin-top: 2px; color: var(--brass-testo); }

  /* Punti di forza (formato "highlights"): 4 riquadri icona + titolo + riga. */
  .punti { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 34px; }
  @media (max-width: 480px) { .punti { grid-template-columns: 1fr; } }
  .punto {
    display: flex; gap: 12px; align-items: flex-start;
    padding: 16px; border: 1px solid var(--line); background: var(--raise);
  }
  .punto svg { width: 22px; height: 22px; flex: 0 0 auto; margin-top: 2px; color: var(--brass-testo); }
  .punto__titolo { font-family: var(--f-display); font-weight: 500; font-size: 17px; margin: 0 0 4px; line-height: 1.25; }
  .punto p { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--ink2); }

  .pdp-descrizione { margin-top: 34px; }
  .pdp-descrizione p { margin: 0 0 16px; }

  /* Fisarmoniche: <details> nativo, accessibile senza JS. Il summary è
     alto almeno 44px (bersaglio tocco). */
  .fisarmonica { border-top: 1px solid var(--line); }
  .fisarmonica:last-of-type { border-bottom: 1px solid var(--line); }
  .fisarmonica summary {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 52px; padding: 12px 0; cursor: pointer; list-style: none;
    font-family: var(--f-display); font-size: 19px;
  }
  .fisarmonica summary::-webkit-details-marker { display: none; }
  .fisarmonica summary::after {
    content: '+'; font-family: var(--f-label); font-size: 20px; line-height: 1;
    color: var(--brass-testo); flex: 0 0 auto;
  }
  .fisarmonica[open] summary::after { content: '−'; }
  .fisarmonica summary:hover { color: var(--brass-testo); }
  .fisarmonica__corpo { padding: 0 0 22px; }
  .fisarmonica__corpo p { margin: 0 0 12px; color: var(--ink2); font-size: 17px; }
  .fisarmonica__corpo ul { margin: 0 0 12px; padding-left: 20px; color: var(--ink2); font-size: 17px; }
  .fisarmonica__corpo li { margin-bottom: 6px; }

  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 11px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  th {
    font-family: var(--f-label); font-size: 9.5px; font-weight: 600; letter-spacing: .15em;
    text-transform: uppercase; color: var(--ink3); width: 11rem; padding-right: 18px;
  }
  td { color: var(--ink2); font-size: 17px; font-variant-numeric: tabular-nums; }
  @media (max-width: 520px) {
    th { width: auto; display: block; border: 0; padding-bottom: 2px; }
    td { display: block; padding-top: 0; }
  }

  .pdp-rimando { margin: 30px 0 0; font-size: 17px; }
  .pdp-rimando a { color: var(--brass-testo); text-decoration: none; display: inline-block; padding: 8px 0; }
  .pdp-rimando a:hover { text-decoration: underline; }
</style>
