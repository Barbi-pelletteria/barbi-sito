---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Citazione from '../components/Citazione.astro';
import ComeNasce from '../components/ComeNasce.astro';
import ConfrontoSpessore from '../components/ConfrontoSpessore.astro';
import { prodotti } from '../data/prodotti.js';
---
<Layout title="Home">
  <!-- 2 · titolo grande centrato, una parola in corsivo ottone -->
  <div class="contenitore">
    <section class="hero">
      <p class="eyebrow">Laboratorio di pelletteria</p>
      <h1>Trentaquattro anni di mestiere, in <em>un portafoglio</em></h1>
      <p class="lede">Stefano Barbi lavora la pelle dal 1992.<br />Per molti di quegli anni l’ha fatto per marchi che portavano il nome di qualcun altro.<br />Dal 2023 decide di dare vita al proprio cognome.</p>
      <a class="pulsante hero-cta" href="/prodotti/">Scopri i prodotti</a>
    </section>
  </div>

  <!-- 3 · fascia foto 16:9 a tutta larghezza -->
  <div class="hero-frame"><span>Foto — un portafoglio nella luce del laboratorio</span></div>

  <!-- 4 · fascia rassicurazione -->
  <div class="strip">
    <div>Spedizione gratuita</div>
    <div>Consegna 1-3 giorni</div>
    <div>14 giorni per il reso</div>
    <div>Garanzia 2 anni</div>
  </div>

  <!-- 5 · i due prodotti -->
  <div class="contenitore">
    <section class="sec">
      <div class="sec-top">
        <h2>Due modelli, <em>fatti a mano</em></h2>
        <p>Quello che c’è davvero in laboratorio oggi. Non un catalogo: un banco di lavoro.</p>
      </div>

      <div class="grid2">
        {prodotti.map((p) => <ProductCard prodotto={p} />)}
      </div>

      <ConfrontoSpessore prodotti={prodotti} class="confronto-home" />

      <p class="prossimamente">Presto anche borse e portachiavi. <a href="/prodotti/">Guarda tutti i prodotti</a>.</p>
    </section>
  </div>

  <!--
    Rifinitura 27/08/2026: il racconto lungo in sei capitoli è stato tolto
    da qui — resta solo su /chi-siamo/ (PACCHETTO_RIFINITURA, punto 3). La
    home si chiude con la citazione breve (che ora porta un link a
    /chi-siamo/) e con "Come nasce un portafoglio", che resta perché è
    visivo e breve, non un secondo racconto da leggere.
  -->

  <!-- 6 · la citazione di Stefano, con link alla storia -->
  <Citazione />

  <!-- 7 · come nasce un portafoglio -->
  <ComeNasce />
</Layout>

<style>
  .hero { padding: 74px 0 0; text-align: center; }
  /*
    Rifinitura 27/08/2026: chi apre il sito vuole comprare — un tasto grande
    verso il catalogo entra nel primo schermo, senza aspettare lo scroll
    fino alle due schede prodotto più in basso.
  */
  .hero-cta { margin-top: 40px; font-size: 13.5px; padding: 19px 34px; }

  .hero-frame {
    margin-top: 52px;
    aspect-ratio: 16 / 9;
    position: relative;
    background:
      radial-gradient(120% 90% at 50% 42%, rgba(var(--brass-rgb), .10), transparent 62%),
      var(--sunk);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
  }
  .hero-frame span {
    font-family: var(--f-label); font-size: 10.5px; font-weight: 600;
    letter-spacing: .2em; text-transform: uppercase; color: var(--ink2);
  }

  .strip { display: flex; flex-wrap: wrap; border-bottom: 1px solid var(--line); }
  .strip div {
    flex: 1 1 200px; padding: 17px 0; text-align: center;
    font-family: var(--f-label); font-size: 11px; font-weight: 500;
    letter-spacing: .11em; text-transform: uppercase; color: var(--ink2);
  }
  .strip div + div { border-left: 1px solid var(--line); }
  @media (max-width: 680px) {
    .strip div { flex: 1 1 50%; padding: 13px 6px; font-size: 9.5px; letter-spacing: .07em; }
    .strip div:nth-child(odd) + div { border-left: 1px solid var(--line); }
    .strip div:nth-child(3), .strip div:nth-child(4) { border-top: 1px solid var(--line); }
    .strip div:nth-child(3) { border-left: 0; }
  }

  .confronto-home { margin: 56px auto 0; }

  /* Un accenno, non una sezione (PACCHETTO_VETRINA punto 7): la home resta
     sfoltita, niente card intere per categorie ancora vuote. */
  .prossimamente {
    text-align: center; margin: 44px 0 0; color: var(--ink3); font-size: 15px;
  }
  .prossimamente a { color: var(--brass-testo); }
</style>
