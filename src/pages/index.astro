---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { categorie, prodotti } from '../data/prodotti.js';
---
<Layout title="Home">
  <section class="sezione contenitore hero">
    <h1>Pelletteria artigianale, fatta a mano dal 1992</h1>
    <p class="hero__testo">
      Portafogli, borse e portachiavi lavorati a mano nel laboratorio di Stefano Barbi.
    </p>
    <a class="pulsante" href="/portafogli/">Vedi i portafogli</a>
  </section>

  <section class="sezione contenitore">
    <h2>Categorie</h2>
    <div class="griglia-categorie">
      {categorie.map((cat) => (
        <a class="scheda-categoria" href={`/${cat.slug}/`}>{cat.nome}</a>
      ))}
    </div>
  </section>

  <section class="sezione contenitore">
    <h2>In evidenza</h2>
    <div class="griglia-prodotti">
      {prodotti.map((p) => <ProductCard prodotto={p} />)}
    </div>
  </section>
</Layout>

<style>
  .hero { text-align: center; padding-top: 4.5rem; padding-bottom: 4rem; }
  .hero h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); max-width: 720px; margin-left: auto; margin-right: auto; }
  .hero__testo { max-width: 520px; margin: 0 auto 1.75rem; color: var(--testo-tenue); font-size: 1.05rem; }

  .griglia-categorie {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .scheda-categoria {
    display: block;
    text-align: center;
    padding: 1.5rem 1rem;
    border: 1px solid var(--bordo);
    border-radius: 6px;
    text-decoration: none;
    color: var(--testo);
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.15rem;
    background: #fff;
  }
  .scheda-categoria:hover { border-color: var(--cuoio); color: var(--cuoio); }

  .griglia-prodotti {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }
</style>
