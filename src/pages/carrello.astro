---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Carrello">
  <section class="contenitore pagina-carrello">
    <h1>Il tuo carrello</h1>

    <div id="carrello-vuoto" hidden>
      <p class="carrello-vuoto__testo">Il carrello è vuoto.</p>
      <a class="pulsante" href="/portafogli/">Vai al catalogo</a>
    </div>

    <table id="tabella-carrello" class="tabella-carrello" hidden>
      <thead>
        <tr>
          <th>Prodotto</th>
          <th>Prezzo</th>
          <th>Quantità</th>
          <th>Subtotale</th>
          <th><span class="sr-only">Azioni</span></th>
        </tr>
      </thead>
      <tbody id="righe-carrello"></tbody>
    </table>

    <div id="riepilogo-carrello" class="riepilogo-carrello" hidden>
      <p class="riepilogo-carrello__totale">Totale <span id="totale-carrello"></span></p>
      <a class="pulsante" id="btn-vai-checkout" href="/checkout/">Vai al pagamento</a>
    </div>
  </section>
</Layout>

<script>
  import { getCart, updateQuantita, removeFromCart, lineKey } from '../scripts/cart.js';
  import { getProdottoBySlug, getColore, formatEuro, INIZIALI_CENTESIMI } from '../data/prodotti.js';

  function prezzoRiga(prodotto, riga) {
    return prodotto.prezzoCentesimi + (riga.iniziali ? INIZIALI_CENTESIMI : 0);
  }

  // Massimo aggiungibile per una riga: stock del colore meno i pezzi di altre
  // righe con lo stesso modello+colore (es. stesso colore con e senza iniziali).
  function maxRiga(cart, prodotto, riga) {
    const colore = getColore(prodotto, riga.colore);
    const stock = colore ? colore.stock : 0;
    const altri = cart
      .filter((r) => r.slug === riga.slug && r.colore === riga.colore && r !== riga)
      .reduce((t, r) => t + r.quantita, 0);
    return Math.max(0, stock - altri);
  }

  function render() {
    const cart = getCart();
    const vuoto = document.getElementById('carrello-vuoto');
    const tabella = document.getElementById('tabella-carrello');
    const riepilogo = document.getElementById('riepilogo-carrello');
    const corpo = document.getElementById('righe-carrello');
    const totaleEl = document.getElementById('totale-carrello');

    if (cart.length === 0) {
      vuoto.hidden = false;
      tabella.hidden = true;
      riepilogo.hidden = true;
      return;
    }

    vuoto.hidden = true;
    tabella.hidden = false;
    riepilogo.hidden = false;
    corpo.innerHTML = '';
    let totale = 0;

    cart.forEach((riga) => {
      const prodotto = getProdottoBySlug(riga.slug);
      if (!prodotto) return;
      const colore = getColore(prodotto, riga.colore);
      const unit = prezzoRiga(prodotto, riga);
      const sub = unit * riga.quantita;
      totale += sub;
      const key = lineKey(riga.slug, riga.colore, riga.iniziali);
      const maxQ = maxRiga(cart, prodotto, riga);

      const dettaglio = [
        colore ? colore.nome : riga.colore,
        riga.iniziali ? `iniziali: ${riga.iniziali}` : null,
      ].filter(Boolean).join(' · ');

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>
          <span class="riga-nome">${prodotto.nome}</span><br>
          <span class="riga-dettaglio">${dettaglio}</span>
        </td>
        <td>${formatEuro(unit)}</td>
        <td>
          <input type="number" min="1" max="${maxQ}" value="${riga.quantita}" data-key="${key}" class="input-quantita" aria-label="Quantità" />
        </td>
        <td>${formatEuro(sub)}</td>
        <td><button class="link-rimuovi" data-key="${key}">Rimuovi</button></td>
      `;
      corpo.appendChild(tr);
    });

    totaleEl.textContent = formatEuro(totale);

    corpo.querySelectorAll('.input-quantita').forEach((el) => {
      el.addEventListener('change', (e) => {
        const key = e.target.getAttribute('data-key');
        const max = parseInt(e.target.getAttribute('max'), 10) || 1;
        let q = Math.max(1, parseInt(e.target.value, 10) || 1);
        if (q > max) q = max;
        updateQuantita(key, q);
        render();
      });
    });
    corpo.querySelectorAll('.link-rimuovi').forEach((el) => {
      el.addEventListener('click', (e) => {
        removeFromCart(e.target.getAttribute('data-key'));
        render();
      });
    });
  }

  render();
  window.addEventListener('barbi:cart-changed', render);
</script>

<!--
  is:global obbligatorio: le righe della tabella nascono da innerHTML nello
  script qui sopra, e gli stili con ambito di Astro non le raggiungono (non
  hanno l'attributo di scope). I selettori sono tutti sotto classi che
  esistono solo in questa pagina, quindi non sporcano il resto del sito.
-->
<style is:global>
  .pagina-carrello { padding: 44px 0; }
  .pagina-carrello h1 { font-size: clamp(28px, 4vw, 40px); max-width: none; }
  .carrello-vuoto__testo { color: var(--ink2); margin: 0 0 20px; }

  .tabella-carrello { width: 100%; border-collapse: collapse; margin-top: 26px; font-size: 15px; }
  .tabella-carrello th {
    font-family: var(--f-d); font-size: 11px; font-weight: 600; letter-spacing: .1em;
    text-transform: uppercase; color: var(--ink3); text-align: left;
    padding: 0 12px 9px 0; border-bottom: 1px solid var(--line2);
  }
  .tabella-carrello td {
    text-align: left; padding: 14px 12px 14px 0; border-bottom: 1px solid var(--line);
    vertical-align: top; font-variant-numeric: tabular-nums; color: var(--ink2);
  }
  .tabella-carrello .riga-nome { font-family: var(--f-d); font-weight: 600; font-size: 15px; color: var(--ink); }
  .tabella-carrello .riga-dettaglio { font-family: var(--f-d); font-size: 12.5px; color: var(--ink3); }

  .input-quantita {
    width: 4rem; padding: 8px; border: 1px solid var(--line);
    background: var(--card); color: var(--ink); font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .link-rimuovi {
    background: none; border: 0; padding: 0; cursor: pointer;
    font-family: var(--f-d); font-size: 12.5px; color: var(--ink3); text-decoration: underline;
  }
  .link-rimuovi:hover { color: var(--ink); }

  .riepilogo-carrello {
    margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--line2);
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 16px;
  }
  .riepilogo-carrello__totale {
    margin: 0; font-family: var(--f-d); font-weight: 700; font-size: 22px;
    letter-spacing: -.02em; font-variant-numeric: tabular-nums;
  }

  @media (max-width: 560px) {
    .tabella-carrello, .tabella-carrello tbody, .tabella-carrello tr, .tabella-carrello td { display: block; width: 100%; }
    .tabella-carrello thead { display: none; }
    .tabella-carrello tr { padding: 16px 0; border-bottom: 1px solid var(--line); }
    .tabella-carrello td { border: 0; padding: 2px 0; }
  }
</style>
