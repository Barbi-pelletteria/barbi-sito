---
import Layout from '../layouts/Layout.astro';
// Testi D-029 § 4.10 (QG). Recesso e garanzia solo come informazione,
// con "come previsto dalla legge" (art. 23 lett. l Codice del Consumo).
---
<Layout title="Spedizioni e resi" description="Spedizione gratuita in tutta Italia con GLS o Poste Italiane, consegna in 1-3 giorni lavorativi dalla spedizione. Recesso entro 14 giorni come previsto dalla legge.">
  <div class="contenitore">
    <section class="pagina-testo">
      <h1>Spedizioni e resi</h1>
      <p>Spediamo in tutta Italia con GLS o Poste Italiane. La spedizione è gratuita: il prezzo che vedi è quello finale.</p>
      <p>La consegna richiede 1-3 giorni lavorativi dalla spedizione.</p>

      <h2>Recesso</h2>
      <p>Hai 14 giorni dalla consegna per recedere dall’acquisto, come previsto dalla legge. Come fare, tempi del rimborso e modulo sono nella pagina <a href="/diritto-di-recesso/">Diritto di recesso</a>.</p>
    </section>
  </div>
</Layout>
