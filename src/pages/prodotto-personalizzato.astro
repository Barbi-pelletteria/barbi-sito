---
// Richiesta di un pezzo su misura. Dal 30/08/2026 (PACCHETTO_AUDIT_SITO
// punto B6) usa un modulo reale invece di un mailto: — invio via
// functions/api/invia-modulo.js (Cloudflare Pages Function + Brevo,
// D-025). Testi D-029 § 4.6 e § 4.14 (QG): la voce di menu "Su misura"
// punta qui. Placeholder dei campi tolti: il pacchetto dà solo le
// etichette, e un placeholder è testo in più che nessuno ha scritto.
import Layout from '../layouts/Layout.astro';
import { EMAIL_CONTATTO } from '../data/prodotti.js';
---
<Layout title="Su misura" description="Un colore o un'idea che non trovi in collezione? Stefano Barbi realizza anche pezzi in pelle su richiesta. Raccontaci cosa hai in mente.">
  <div class="contenitore">
    <section class="pagina-testo">
      <h1>Su misura</h1>
      <p>Un colore che non trovi in collezione, una combinazione particolare, un’idea tua: Stefano realizza anche pezzi su richiesta. Raccontaci cosa hai in mente — ti risponde lui, di persona, di solito entro un giorno lavorativo.</p>

      <form
        name="su-misura"
        method="POST"
        action="/api/invia-modulo"
        class="form-personalizzato"
      >
        <input type="hidden" name="form-name" value="su-misura" />
        <p class="form-personalizzato__nascosto"><label>Non compilare questo campo <input name="pp-azienda" /></label></p>

        <label for="pp-cosa">Cosa desideri</label>
        <input type="text" id="pp-cosa" name="cosa" autocomplete="off" required />

        <label for="pp-nome">Il tuo nome</label>
        <input type="text" id="pp-nome" name="nome" autocomplete="name" required />

        <label for="pp-email">La tua email</label>
        <input type="email" id="pp-email" name="email" autocomplete="email" required />

        <label for="pp-dettagli">Altri dettagli <span class="form-personalizzato__facoltativo">(facoltativo)</span></label>
        <textarea id="pp-dettagli" name="dettagli" rows="4"></textarea>

        <button type="submit" class="pulsante">Invia la richiesta a Stefano</button>
      </form>

      <p class="riga-email">Preferisci scrivere direttamente? <a href={`mailto:${EMAIL_CONTATTO}`}>{EMAIL_CONTATTO}</a></p>
    </section>
  </div>
</Layout>

<style>
  .form-personalizzato {
    display: flex; flex-direction: column; gap: 6px;
    margin: 34px 0; padding: 26px; border: 1px solid var(--line); background: var(--raise);
  }
  .form-personalizzato label {
    font-family: var(--f-label); font-size: 10.5px; font-weight: 600; letter-spacing: .12em;
    text-transform: uppercase; color: var(--ink3); margin: 18px 0 2px;
  }
  .form-personalizzato label:first-of-type { margin-top: 0; }
  .form-personalizzato__facoltativo { text-transform: none; letter-spacing: 0; font-weight: 500; }
  .form-personalizzato input, .form-personalizzato textarea {
    width: 100%; padding: 13px 14px; border: 1px solid var(--line2);
    background: var(--sunk); color: var(--ink); font-family: var(--f-text); font-size: 16.5px;
    resize: vertical;
  }
  .form-personalizzato .pulsante { margin-top: 22px; align-self: flex-start; }
  .form-personalizzato__nascosto { position: absolute; left: -9999px; }
  .riga-email { color: var(--ink2); }
</style>
