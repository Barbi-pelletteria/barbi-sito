---
import Layout from '../layouts/Layout.astro';
import { EMAIL_CONTATTO } from '../data/prodotti.js';
---
<Layout title="Contatti">
  <section class="sezione contenitore pagina-testo">
    <h1>Contatti</h1>
    <p>Per informazioni sui portafogli, sugli ordini o sui resi, scrivi a:</p>
    <p><a href={`mailto:${EMAIL_CONTATTO}`}>{EMAIL_CONTATTO}</a></p>

    <h2>Dove</h2>
    <p>
      Barbi Stefano — impresa individuale<br />
      Via Nazionale delle Puglie 98, 80026 Casoria (NA)
    </p>
  </section>
</Layout>

<style>
  .pagina-testo { max-width: 720px; }
  .pagina-testo h2 { margin-top: 2rem; }
</style>
