---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Ordine confermato">
  <section class="contenitore pagina-stretta">
    <div id="conferma-ok" hidden>
      <h1>Grazie, ordine ricevuto.</h1>
      <p>Questo è un ambiente di test: nessun addebito reale è avvenuto.</p>
      <p id="riferimento-ordine" class="riferimento"></p>
      <p><a class="pulsante" href="/">Torna alla home</a></p>
    </div>
    <div id="conferma-mancante" hidden>
      <h1>Nessun ordine da confermare</h1>
      <p>Questa pagina si apre solo dopo un pagamento completato dal checkout.</p>
      <p><a class="pulsante" href="/portafogli/">Vai al catalogo</a></p>
    </div>
  </section>
</Layout>

<script>
  import { clearCart } from '../scripts/cart.js';
  import { trackEvent } from '../scripts/analytics.js';

  const params = new URLSearchParams(window.location.search);
  const sessionId = params.get('session_id');
  const value = params.get('value');
  const currency = params.get('currency') || 'EUR';

  const ok = document.getElementById('conferma-ok');
  const mancante = document.getElementById('conferma-mancante');
  const riferimento = document.getElementById('riferimento-ordine');

  if (sessionId) {
    ok.hidden = false;
    riferimento.textContent = `Riferimento test: ${sessionId}`;

    // GA4 — purchase, con valore (B4). Valore tecnico di collaudo, vedi
    // src/data/prodotti.js — non è un prezzo reale comunicato al cliente.
    trackEvent('purchase', {
      transaction_id: sessionId,
      currency,
      value: value ? parseFloat(value) : undefined,
    });

    clearCart();
  } else {
    mancante.hidden = false;
  }
</script>

<style>
  .pagina-stretta { max-width: 62ch; padding: 80px 0; }
  .pagina-stretta h1 { font-size: clamp(28px, 4vw, 40px); max-width: none; }
  .pagina-stretta p { color: var(--ink2); margin: 0 0 22px; }
  .riferimento {
    font-family: var(--f-d); font-size: 12.5px; color: var(--ink3);
    background: var(--sunk); border-left: 2px solid var(--line2);
    padding: 12px 14px; word-break: break-all;
  }
</style>
