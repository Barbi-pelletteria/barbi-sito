---
// PACCHETTO_AUDIT_SITO, blocco C: description ora obbligatoria e specifica
// per pagina (non più un default silenzioso identico ovunque — se una
// pagina non la passa esplicitamente, l'errore di build lo dice subito
// invece di lasciare il default a coprire la dimenticanza). canonical e
// Open Graph/Twitter si costruiscono da qui, una sola volta: restano corretti
// anche mentre il noindex resta attivo, pronti per il giorno in cui si toglie.
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage = '/marchio-pelle.jpg' } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
import Marchio from '../components/Marchio.astro';
import { EMAIL_CONTATTO, VENDITA_ATTIVA } from '../data/prodotti.js';

// Voce "Home" nel menu (richiesta diretta del Founder, 31/08/2026): oggi
// si torna alla home solo cliccando il marchio, un'interazione che molti
// utenti non scoprono da soli. Il marchio resta cliccabile (non si tocca),
// "Home" si affianca come primo elemento, esplicito.
// aria-current="page" sulla voce attiva: pattern nuovo, non esisteva prima
// per nessuna voce del menu — introdotto qui per tutte, non solo per Home,
// altrimenti "segnalata come le altre" non avrebbe un'altra voce da cui
// prendere esempio. "/" confrontato per uguaglianza esatta (altrimenti
// ogni pagina inizia per "/" ed è sempre "attiva"); le altre per prefisso,
// così un'eventuale sotto-pagina futura resta coerente.
const percorso = Astro.url.pathname;
const eAttivo = (href) => (href === '/' ? percorso === '/' : percorso.startsWith(href));

const titoloCompleto = `${title} · Barbi Pelletteria`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{titoloCompleto}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="noindex, nofollow" />
  <!--
    robots noindex volutamente attivo: FATTO QUANDO (B3) dice
    "raggiungibile pubblicamente ma non linkato da nessuna parte,
    non ancora annunciato". Rimuovere questo meta tag solo quando si
    decide di far indicizzare il sito davvero (non è un compito di questo pacchetto).
  -->

  <!-- Open Graph e Twitter Card: oggi servono già quando un link viene
       condiviso su WhatsApp/Instagram (il noindex blocca solo i motori di
       ricerca, non le anteprime social), e restano pronti per l'indicizzazione. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Barbi Pelletteria" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:title" content={titoloCompleto} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titoloCompleto} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Font self-hostati (31/08→02/09/2026): prima Google Fonts, un CDN
       esterno che riceve l'IP del visitatore prima di qualunque consenso —
       lo stesso problema GDPR di GA4, ma senza nemmeno un banner a
       coprirlo. I file .woff2 sono in public/fonts/, dichiarati sotto in
       @font-face (vedi <style>). Nessun preconnect esterno più necessario. -->

  <!--
    GA4 NON viene caricato qui: parte solo dopo il consenso esplicito dato
    tramite il banner cookie in fondo alla pagina. Vedi src/scripts/consent.js.
  -->

  <!-- Dati strutturati specifici di pagina (Product, FAQPage): iniettati
       dalla pagina stessa tramite questo slot, non da qui — solo alcune
       pagine ne hanno bisogno e solo la pagina conosce i valori veri. -->
  <slot name="structured-data" />
</head>
<body>
  <a class="salta-contenuto" href="#contenuto">Vai al contenuto</a>

  <header class="nav">
    <div class="nav-in">
      <a href="/" class="nav-marchio" aria-label="Barbi Pelletteria, dal 1992">
        <img src="/marchio-pelle-lettere.png" alt="Barbi" width="1010" height="280" />
      </a>
      <nav class="nav-right" aria-label="Menu principale">
        <a href="/" class="hideable" aria-current={eAttivo('/') ? 'page' : undefined}>Home</a>
        <a href="/portafogli/" class="hideable" aria-current={eAttivo('/portafogli/') ? 'page' : undefined}>Prodotti</a>
        <a href="/chi-siamo/" class="hideable" aria-current={eAttivo('/chi-siamo/') ? 'page' : undefined}>Il laboratorio</a>
        <a href="/contatti/" class="hideable" aria-current={eAttivo('/contatti/') ? 'page' : undefined}>Contatti</a>
        {/* PACCHETTO_AUDIT_SITO punto A2: niente contatore "(0)" finché non
            si può comprendere nulla — mostrarlo contraddice il resto del
            sito, che dice "vendita non ancora attiva". */}
        {VENDITA_ATTIVA ? (
          <a href="/carrello/" aria-current={eAttivo('/carrello/') ? 'page' : undefined}>Carrello (<span id="contatore-carrello">0</span>)</a>
        ) : (
          <a href="/carrello/" aria-current={eAttivo('/carrello/') ? 'page' : undefined}>Carrello</a>
        )}
        <button type="button" class="nav-burger" id="nav-burger" aria-expanded="false" aria-controls="nav-menu-mobile" aria-label="Apri il menu">
          <span></span><span></span><span></span>
        </button>
      </nav>
    </div>
    <nav class="nav-menu-mobile" id="nav-menu-mobile" aria-label="Menu principale, mobile" hidden>
      <a href="/" aria-current={eAttivo('/') ? 'page' : undefined}>Home</a>
      <a href="/portafogli/" aria-current={eAttivo('/portafogli/') ? 'page' : undefined}>Prodotti</a>
      <a href="/chi-siamo/" aria-current={eAttivo('/chi-siamo/') ? 'page' : undefined}>Il laboratorio</a>
      <a href="/contatti/" aria-current={eAttivo('/contatti/') ? 'page' : undefined}>Contatti</a>
    </nav>
  </header>

  <main id="contenuto">
    <slot />
  </main>

  <footer class="site-footer">
    <Marchio size="piede" />
    <nav class="flinks" aria-label="Informazioni e supporto">
      <a href="/faq/">Domande frequenti</a>
      <a href="/termini-e-condizioni/">Informazioni legali</a>
      <a href="/spedizioni-e-resi/">Spedizioni</a>
      <a href="/diritto-di-recesso/">Recesso e resi</a>
      <a href="/termini-e-condizioni/#garanzia">Garanzia</a>
      <a href="/termini-e-condizioni/#pagamenti-e-prezzi">Pagamenti</a>
      <a href="/privacy/">Privacy e cookie</a>
    </nav>
    <p class="fine">
      Barbi Stefano<br />
      Partita IVA 10311791213 · REA NA-1097798 · <a href={`mailto:${EMAIL_CONTATTO}`}>{EMAIL_CONTATTO}</a>
    </p>
  </footer>

  {gaId && (
    <div id="cookie-banner" class="cookie-banner" role="dialog" aria-live="polite" aria-label="Informativa cookie" data-ga-id={gaId} hidden>
      <p class="cookie-banner__testo">
        Questo sito usa Google Analytics per contare le visite in forma anonima.
        Parte solo se lo accetti. Vedi la <a href="/privacy/">privacy e cookie</a>.
      </p>
      <div class="cookie-banner__azioni">
        <button type="button" class="pulsante" id="cookie-accetta">Accetta</button>
        <button type="button" class="pulsante pulsante-secondario" id="cookie-rifiuta">Rifiuta</button>
      </div>
    </div>
  )}

  <script>
    // Consenso preventivo: legge il Measurement ID dal banner (se presente) e
    // carica GA4 solo dopo un "Accetta". Nessuna richiesta di rete prima.
    import { getConsent, setConsent, loadAnalytics } from '../scripts/consent.js';

    const banner = document.getElementById('cookie-banner');
    const gaId = banner?.getAttribute('data-ga-id') || '';

    if (gaId) {
      const scelta = getConsent();
      if (scelta === 'accepted') {
        loadAnalytics(gaId);
      } else if (scelta !== 'rejected') {
        banner.hidden = false;
      }

      document.getElementById('cookie-accetta')?.addEventListener('click', () => {
        setConsent('accepted');
        banner.hidden = true;
        loadAnalytics(gaId);
      });
      document.getElementById('cookie-rifiuta')?.addEventListener('click', () => {
        setConsent('rejected');
        banner.hidden = true;
      });
    }
  </script>

  <script>
    import { getCartCount } from '../scripts/cart.js';
    function aggiornaContatore() {
      const el = document.getElementById('contatore-carrello');
      if (el) el.textContent = String(getCartCount());
    }
    aggiornaContatore();
    window.addEventListener('barbi:cart-changed', aggiornaContatore);
  </script>

  <script>
    // Tasto menu mobile: mostra/nasconde il pannello con le sezioni che
    // da computer stanno nella barra in alto (Prodotti, Il laboratorio,
    // Contatti), nascoste su schermi stretti per mancanza di spazio.
    // PACCHETTO_INTERFACCIA punto 3: chiusura al click fuori e con Esc,
    // focus sulla prima voce all'apertura — mancavano.
    const burger = document.getElementById('nav-burger');
    const menuMobile = document.getElementById('nav-menu-mobile');

    function apriMenuMobile() {
      menuMobile.hidden = false;
      burger.setAttribute('aria-expanded', 'true');
      menuMobile.querySelector('a')?.focus();
    }
    function chiudiMenuMobile(restituisciFocus) {
      menuMobile.hidden = true;
      burger.setAttribute('aria-expanded', 'false');
      if (restituisciFocus) burger.focus();
    }

    burger?.addEventListener('click', () => {
      if (menuMobile.hidden) apriMenuMobile();
      else chiudiMenuMobile(false);
    });
    document.addEventListener('click', (e) => {
      if (menuMobile.hidden) return;
      if (menuMobile.contains(e.target) || burger.contains(e.target)) return;
      chiudiMenuMobile(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menuMobile.hidden) chiudiMenuMobile(true);
    });
  </script>

  <style is:global>
    /* ─────────────────────────────────────────────────────────────────
       Font self-hostati da public/fonts/ (prima Google Fonts CDN).
       Stessi tre pesi/stili già in uso, verificati uno per uno nel
       codice prima di scaricare — non un peso in più.
       Sottoinsieme "latin" soltanto: gli unici caratteri che il sito usa
       sono lettere accentate italiane (à, è, é, ì, ò, ù — già dentro
       Latin-1, non serve "latin-ext") e punteggiatura tipografica
       (', —, … — dentro lo stesso intervallo Unicode del sottoinsieme
       "latin" per questi font). Cirillico, vietnamita, simboli, math:
       mai referenziati da nessuna pagina, non scaricati.
       Scoperta non richiesta ma verificata (hash SHA-256 dei file,
       non solo l'URL): Google serve OGGI lo stesso identico file per
       Archivo 500/600, per Fraunces 400/700 normale e per Lora 400/500
       normale — stesso identico peso visivo per pesi nominalmente
       diversi. Replicato fedelmente qui (stesso file, due dichiarazioni
       @font-face) invece di "corretto": il vincolo era rendering
       identico a prima, non migliore. */
    @font-face {
      font-family: "Fraunces";
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url("/fonts/fraunces-400-700.woff2") format("woff2");
    }
    @font-face {
      font-family: "Fraunces";
      font-style: italic;
      font-weight: 400;
      font-display: swap;
      src: url("/fonts/fraunces-400italic.woff2") format("woff2");
    }
    @font-face {
      font-family: "Lora";
      font-style: normal;
      font-weight: 400 500;
      font-display: swap;
      src: url("/fonts/lora-400-500.woff2") format("woff2");
    }
    @font-face {
      font-family: "Lora";
      font-style: italic;
      font-weight: 400;
      font-display: swap;
      src: url("/fonts/lora-400italic.woff2") format("woff2");
    }
    @font-face {
      font-family: "Archivo";
      font-style: normal;
      font-weight: 500 600;
      font-display: swap;
      src: url("/fonts/archivo-500-600.woff2") format("woff2");
    }

    /* ─────────────────────────────────────────────────────────────────
       Tema unico, chiaro e caldo. È la scelta di un marchio, non una
       preferenza di sistema: niente @media (prefers-color-scheme),
       niente [data-theme]. Stesso asse cromatico di prima (crema/ottone),
       solo con la luminosità invertita — cambiati il 27/08/2026 su
       richiesta del Founder (troppo scuro), vedi RESOCONTO_RIFINITURA.

       L'ottone è il colore dello strumento che imprime le iniziali:
       per questo è l'unico accento, e va usato con parsimonia. Come
       BORDO/FILETTO/CORNICE/RIBATTINO resta --brass anche sui fondi
       chiari (contrasto ~2:1, ok per un elemento non testuale). Come
       TESTO userebbe un ottone illeggibile: per quello c'è --brass-testo,
       la stessa famiglia di colore ma scura. Scurita ulteriormente il
       30/08/2026 su richiesta diretta del Founder ("falle più scure,
       marrone scuro") — resta la stessa tinta di --brass, solo molto
       più marrone/scura (contrasto verificato ~8,4:1 su --raise, ben
       sopra la soglia 4,5:1).
       Tutti i colori stanno qui e da nessun'altra parte. ─────────────── */
    :root {
      --ground: #F2EAE0;
      --raise: #FBF6EC;
      --sunk: #E3D8C7;
      --ink: #211B17;
      --ink2: #5C4F45;
      --ink3: #6E6355;
      --line: #CFC3B4;
      --line2: #BBAFA0;
      --brass: #C6A15B;
      --brass-testo: #5C4520;
      --blu: #7E97C6;
      --bordeaux: #C97F8B;
      --marrone: #6B4226;

      /* Gli stessi due colori in componenti separate: servono per gli aloni
         e i filetti trasparenti (rgba). Stanno qui perché anche una
         trasparenza è un colore, e i colori non si scrivono nei componenti. */
      --brass-rgb: 198, 161, 91;
      --ink-rgb: 33, 27, 23;

      /* Cambiati dal Bodoni/EB Garamond originali su richiesta del Founder:
         "un font più visibile ed artigianale" — Bodoni Moda è un Didone con
         contrasto estremo fra pieni e filetti, elegante ma poco leggibile ed
         effetto moda-editoriale, non artigianale. Fraunces è un serif con
         asse "soft" pensato apposta per marchi di piccola manifattura/artigianato
         (ceramiche, caffè, pelletteria): più visibile, meno rigido, stesso
         registro premium. Lora accompagna nel testo lungo con lo stesso spirito
         più caldo e leggibile di Fraunces, al posto del più sottile EB Garamond. */
      --f-display: "Fraunces", Georgia, serif;
      --f-text: "Lora", Georgia, serif;
      --f-label: "Archivo", system-ui, sans-serif;

      color-scheme: light;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--ground);
      color: var(--ink);
      font-family: var(--f-text);
      font-size: 19px;
      line-height: 1.68;
      -webkit-text-size-adjust: 100%;
    }
    a { color: inherit; }
    img { max-width: 100%; display: block; }

    /* ---- impaginazione ---- */
    .contenitore { max-width: 1120px; margin: 0 auto; padding: 0 22px; }
    .narrow { max-width: 660px; margin-left: auto; margin-right: auto; }
    .sec { padding: 78px 0; }
    .sec-top { text-align: center; margin-bottom: 44px; }
    .sec-top p { margin: 0 auto; color: var(--ink2); max-width: 50ch; font-size: 18px; }

    /* ---- titoli: Bodoni in peso 400 e grande. La magrezza è il pregio. ---- */
    h1, h2 {
      font-family: var(--f-display);
      font-weight: 400;
      margin: 0 0 12px;
      text-wrap: balance;
    }
    h1 {
      font-size: clamp(34px, 6.4vw, 68px);
      line-height: 1.08;
      letter-spacing: -.005em;
      margin: 0 auto 22px;
      max-width: 19ch;
    }
    h2 { font-size: clamp(27px, 3.7vw, 42px); line-height: 1.14; }
    /* Una parola in corsivo e in ottone. Una sola. */
    h1 em, h2 em { font-style: italic; color: var(--brass-testo); }
    h3 { font-family: var(--f-display); font-weight: 400; font-size: 23px; margin: 0 0 6px; }

    .lede { font-size: clamp(18px, 2.1vw, 21px); color: var(--ink2); max-width: 52ch; margin: 0 auto; line-height: 1.6; }

    .eyebrow {
      font-family: var(--f-label); font-size: 10.5px; font-weight: 600;
      letter-spacing: .24em; text-indent: .24em; text-transform: uppercase;
      color: var(--brass-testo); margin: 0 0 22px;
    }

    /* ---- testata ---- */
    /* Sfondo in pelle vera (foto), su richiesta diretta del Founder — deroga
       esplicita a C-11 (CORREZIONI.md), registrata in DECISIONI.md. Non un
       colore piatto: marchio-pelle-texture.jpg è un ritaglio della stessa
       foto (zona senza scritta), specchiato una volta per ripetersi senza
       taglio netto (repeat-x), così tutta la barra è coperta dalla stessa
       texture, non solo la zona del logo. #16110E (colore medio della pelle,
       campionato via canvas) resta sotto come sfondo di riserva mentre la
       texture carica. Testo e tasto menu passano da --ink2/--ink a un
       chiaro per il nuovo fondo scuro — contrasto verificato, non a occhio. */
    .nav {
      background-color: #16110E;
      background-image: url('/marchio-pelle-texture.jpg');
      background-repeat: repeat-x;
      background-position: left top;
      background-size: auto 100%;
      border-bottom: 1px solid var(--brass);
    }
    .nav-in { max-width: 1120px; margin: 0 auto; padding: 14px 22px; display: flex; align-items: center; gap: 28px; }
    .nav-marchio { display: block; }
    .nav-marchio img { display: block; height: 46px; width: auto; }
    .nav-right { margin-left: auto; display: flex; gap: 24px; align-items: center; }
    .nav a {
      font-family: var(--f-label); font-size: 12.5px; font-weight: 500; letter-spacing: .05em;
      text-transform: uppercase; color: var(--raise); text-decoration: none; white-space: nowrap;
    }
    /* Area cliccabile delle voci di menu: 21px di altezza reale (misurata)
       prima di questa riga, sotto la soglia AA di WCAG 2.2 (24×24px).
       Corretta a >=32px solo con padding verticale, non toccando
       font-size: essendo figlie dirette di un contenitore flex
       (.nav-right), le <a> qui sono "blockificate" per specifica CSS — il
       padding verticale si applica davvero alla loro box, non è il caso
       (diverso) di un elemento inline isolato dove il padding verticale
       non tocca l'altezza di riga. Selettore ristretto a `.nav-right a`,
       non il più ampio `.nav a`: quest'ultimo prende anche `.nav-marchio`
       (il logo), dove il padding avrebbe allargato la barra intera da
       74px a 90px — misurato, non solo temuto, prima di restringere il
       selettore. L'altezza della barra non cambia: il logo (46px) resta
       comunque l'elemento più alto della riga. */
    .nav-right a { padding: 8px 0; }
    .nav a:hover { color: var(--brass); }
    /* Voce attiva: stesso trattamento di :hover ma persistente, più il
       peso del testo — un colore da solo non basta (non-color indicator),
       serve anche a chi non distingue i due toni su un fondo scuro/testurizzato. */
    .nav a[aria-current="page"] { color: var(--brass); font-weight: 600; }

    /* Tasto menu mobile (tre lineette): invisibile da computer, il menu
       a comparsa sotto sostituisce i link .hideable nascosti in basso. */
    .nav-burger {
      display: none;
      flex-direction: column; justify-content: center; align-items: stretch;
      gap: 5px; width: 30px; height: 30px; padding: 0; margin: 0;
      background: none; border: 0; cursor: pointer;
    }
    .nav-burger span { display: block; height: 2px; background: var(--raise); }

    /* display:none di base, senza condizioni: a computer il pannello non
       esiste mai, qualunque sia lo stato di [hidden] — nessun conflitto
       di specificità possibile (unica dichiarazione di display in gioco). */
    .nav-menu-mobile { display: none; }

    @media (max-width: 680px) {
      .nav a.hideable { display: none; }
      .nav-in { gap: 14px; padding: 12px 22px; }
      .nav-marchio img { height: 36px; }
      .nav-burger { display: flex; }
      .nav-menu-mobile {
        display: flex; flex-direction: column;
        border-top: 1px solid var(--line);
        background: var(--raise);
      }
      /* stessa causa del bug banner cookie (C-13): serve sempre questa
         regola più specifica, altrimenti [hidden] non vince su display:flex. */
      .nav-menu-mobile[hidden] { display: none; }
      /* PACCHETTO_INTERFACCIA punto 3, causa reale trovata: .nav a
         (globale, sopra) imposta color:var(--raise) per l'header scuro —
         qui si eredita su un pannello che invece ha sfondo --raise chiaro,
         testo su testo, contrasto 1:1 (misurato). Serve un colore scuro
         esplicito, non ereditato. */
      .nav-menu-mobile a {
        padding: 16px 22px; border-bottom: 1px solid var(--line);
        color: var(--ink);
      }
      .nav-menu-mobile a:last-child { border-bottom: 0; }
      .nav-menu-mobile a:hover, .nav-menu-mobile a:focus-visible { color: var(--brass-testo); }
      .nav-menu-mobile a[aria-current="page"] { color: var(--brass-testo); font-weight: 600; }
    }

    /* ---- pastiglie colore (scheda + pagina prodotto) ---- */
    .swatches { display: flex; gap: 11px; margin-top: 20px; align-items: center; flex-wrap: wrap; }
    /* PACCHETTO_INTERFACCIA punto 2 — causa reale trovata: sulla pagina
       prodotto .sw è uno <span> (pattern radio+span, diverso dal <button>
       usato sulle schede). Uno span resta display:inline di default, e un
       elemento inline IGNORA width/height per specifica CSS — non è un
       problema di flex che comprime, è che 26px (poi 44px) non venivano
       proprio applicati: misurato display:inline con getComputedStyle,
       dimensione reale 2×26px contro i 44×44 dichiarati. Sui <button>
       delle schede il difetto era mascherato perché i bottoni sono già
       block-level di default. display:inline-block è la correzione alla
       radice; aspect-ratio e flex:0 0 auto restano come seconda difesa nel
       caso .sw finisca in un contenitore flex che tenti comunque di
       comprimerlo. 44px è anche la soglia minima di area toccabile. */
    .sw {
      display: inline-block;
      width: 44px; height: 44px; aspect-ratio: 1; flex: 0 0 auto;
      border-radius: 50%; cursor: pointer; position: relative;
      border: 1px solid rgba(var(--ink-rgb), .22); padding: 0; appearance: none; -webkit-appearance: none;
      background-size: cover; background-position: center;
    }
    .sw[data-c="blu"] { background-color: var(--blu); }
    .sw[data-c="bordeaux"] { background-color: var(--bordeaux); }
    .sw[data-c="marrone"] { background-color: var(--marrone); }
    /* PACCHETTO_INTERFACCIA punto 1: la macro (quando esiste, vedi
       MACRO_PELLE in prodotti.js) arriva come background-image inline,
       scritto solo quando il percorso non è null — finché è null non c'è
       nessuno stile inline e resta la tinta piatta qui sopra, invariata.
       Il ritaglio è già quadrato-poi-cerchio: object-fit non si applica a
       un background, l'equivalente qui è background-size:cover (sopra) su
       un elemento già border-radius:50%. */
    .sw.on::after { content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--brass); }
    .sw:disabled { opacity: .32; cursor: not-allowed; }
    .sw-label {
      font-family: var(--f-label); font-size: 11px; letter-spacing: .08em;
      text-transform: uppercase; color: var(--ink3); margin-left: 8px;
    }

    /* ---- pulsanti ---- */
    .buy, .pulsante {
      display: inline-block;
      font-family: var(--f-label); font-size: 12.5px; font-weight: 600;
      letter-spacing: .16em; text-transform: uppercase;
      background: var(--brass); color: var(--ink);
      border: 1px solid var(--brass); padding: 17px 26px;
      text-decoration: none; text-align: center; cursor: pointer;
    }
    .buy:hover, .pulsante:hover { filter: brightness(1.08); }
    .buy:disabled, .pulsante:disabled, .pulsante[aria-disabled="true"] { opacity: .45; cursor: not-allowed; filter: none; }
    .buy.soon, .pulsante-secondario { background: transparent; color: var(--brass-testo); }

    /* ---- prezzo, ricorre su scheda e pagina prodotto ---- */
    .p-price { font-family: var(--f-display); font-size: 23px; margin-top: 12px; font-variant-numeric: tabular-nums; }
    .p-price em { font-style: italic; font-size: 15px; color: var(--ink3); margin-left: 10px; }
    .p-kick {
      font-family: var(--f-label); font-size: 10px; font-weight: 600; letter-spacing: .19em;
      text-transform: uppercase; color: var(--brass-testo); margin: 22px 0 0;
    }

    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 46px; }
    @media (max-width: 740px) { .grid2 { grid-template-columns: 1fr; gap: 56px; } }

    /* ---- pagine di solo testo: legali, contatti ---- */
    .pagina-testo { max-width: 660px; padding: 64px 0; }
    .pagina-testo h1 { font-size: clamp(30px, 4.4vw, 44px); max-width: none; margin: 0 0 26px; text-align: left; }
    .pagina-testo h2 { font-size: clamp(22px, 2.6vw, 27px); margin: 44px 0 12px; }
    .pagina-testo p { margin: 0 0 20px; }
    .pagina-testo li { margin-bottom: 8px; }
    /* :not(.pulsante) impedisce a questa regola di vincere sul colore del
       testo bottone quando un .pulsante sta dentro una pagina di testo (es.
       "Compila il modulo di recesso"): senza, .pagina-testo a (0,1,1) batte
       .pulsante (0,1,0) per specificità e il bottone diventa illeggibile
       (ottone su ottone). */
    .pagina-testo a:not(.pulsante) { color: var(--brass-testo); }

    .riquadro { border: 1px solid var(--line); background: var(--raise); padding: 26px; margin-top: 34px; }
    .riquadro h2 { margin-top: 0; }
    .riquadro :last-child { margin-bottom: 0; }

    .segnaposto { color: var(--ink3); font-style: italic; font-size: 0.95em; }

    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }

    .salta-contenuto {
      position: absolute; left: -999px; top: 0;
      background: var(--brass); color: var(--ink);
      padding: 12px 16px; z-index: 100;
      font-family: var(--f-label); font-size: 12px; font-weight: 600;
      letter-spacing: .1em; text-transform: uppercase;
    }
    .salta-contenuto:focus { left: 12px; top: 12px; }

    /* ---- piè di pagina ---- */
    .site-footer { border-top: 1px solid var(--line2); padding: 52px 22px 70px; text-align: center; margin-top: 20px; }
    .flinks {
      display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 26px; margin-top: 32px;
      font-family: var(--f-label); font-size: 11px; letter-spacing: .09em; text-transform: uppercase;
    }
    .flinks a { color: var(--ink2); text-decoration: none; }
    .flinks a:hover { color: var(--brass); }
    .fine {
      margin: 28px 0 0; font-family: var(--f-label); font-size: 10.5px;
      letter-spacing: .05em; color: var(--ink3); line-height: 1.9;
    }
    .fine a { color: var(--ink3); }

    /* ---- banner cookie ---- */
    .cookie-banner {
      position: fixed; left: 16px; right: 16px; bottom: 16px;
      max-width: 660px; margin: 0 auto;
      background: var(--raise); border: 1px solid var(--line2);
      padding: 20px 22px; z-index: 50;
      display: flex; flex-wrap: wrap; align-items: center;
      gap: 14px 20px; justify-content: space-between;
    }
    /* .cookie-banner{display:flex} e [hidden]{display:none} hanno la
       stessa specificità (0,1,0): senza questa regola più specifica,
       banner.hidden = true da JS non nasconde nulla — vince sempre flex. */
    .cookie-banner[hidden] { display: none; }
    .cookie-banner__testo { margin: 0; font-size: 16.5px; color: var(--ink2); flex: 1 1 260px; line-height: 1.5; }
    .cookie-banner__testo a { color: var(--brass-testo); }
    .cookie-banner__azioni { display: flex; gap: 10px; }
    .cookie-banner__azioni .pulsante { padding: 12px 18px; font-size: 11px; }

    :where(a, button, input, .sw):focus-visible { outline: 2px solid var(--brass); outline-offset: 4px; }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</body>
</html>
