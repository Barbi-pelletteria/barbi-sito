---
// PACCHETTO_AUDIT_SITO, blocco C: description ora obbligatoria e specifica
// per pagina (non più un default silenzioso identico ovunque — se una
// pagina non la passa esplicitamente, l'errore di build lo dice subito
// invece di lasciare il default a coprire la dimenticanza). canonical e
// Open Graph/Twitter si costruiscono da qui, una sola volta: restano corretti
// anche mentre il noindex resta attivo, pronti per il giorno in cui si toglie.
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage = '/marchio-pelle.jpg' } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
import Marchio from '../components/Marchio.astro';
import { EMAIL_CONTATTO, VENDITA_ATTIVA } from '../data/prodotti.js';

// Voce "Home" nel menu (richiesta diretta del Founder, 31/08/2026): oggi
// si torna alla home solo cliccando il marchio, un'interazione che molti
// utenti non scoprono da soli. Il marchio resta cliccabile (non si tocca),
// "Home" si affianca come primo elemento, esplicito.
// aria-current="page" sulla voce attiva: pattern nuovo, non esisteva prima
// per nessuna voce del menu — introdotto qui per tutte, non solo per Home,
// altrimenti "segnalata come le altre" non avrebbe un'altra voce da cui
// prendere esempio. "/" confrontato per uguaglianza esatta (altrimenti
// ogni pagina inizia per "/" ed è sempre "attiva"); le altre per prefisso,
// così un'eventuale sotto-pagina futura resta coerente.
const percorso = Astro.url.pathname;
const eAttivo = (href) => (href === '/' ? percorso === '/' : percorso.startsWith(href));

const titoloCompleto = `${title} · Barbi Pelletteria`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{titoloCompleto}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="noindex, nofollow" />
  <!--
    robots noindex volutamente attivo: FATTO QUANDO (B3) dice
    "raggiungibile pubblicamente ma non linkato da nessuna parte,
    non ancora annunciato". Rimuovere questo meta tag solo quando si
    decide di far indicizzare il sito davvero (non è un compito di questo pacchetto).
  -->

  <!-- Open Graph e Twitter Card: oggi servono già quando un link viene
       condiviso su WhatsApp/Instagram (il noindex blocca solo i motori di
       ricerca, non le anteprime social), e restano pronti per l'indicizzazione. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Barbi Pelletteria" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:title" content={titoloCompleto} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titoloCompleto} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Font self-hostati (31/08→02/09/2026): prima Google Fonts, un CDN
       esterno che riceve l'IP del visitatore prima di qualunque consenso —
       lo stesso problema GDPR di GA4, ma senza nemmeno un banner a
       coprirlo. I file .woff2 sono in public/fonts/, dichiarati sotto in
       @font-face (vedi <style>). Nessun preconnect esterno più necessario. -->

  <!--
    GA4 NON viene caricato qui: parte solo dopo il consenso esplicito dato
    tramite il banner cookie in fondo alla pagina. Vedi src/scripts/consent.js.
  -->

  <!-- Dati strutturati specifici di pagina (Product, FAQPage): iniettati
       dalla pagina stessa tramite questo slot, non da qui — solo alcune
       pagine ne hanno bisogno e solo la pagina conosce i valori veri. -->
  <slot name="structured-data" />
</head>
<body>
  <a class="salta-contenuto" href="#contenuto">Vai al contenuto</a>

  <header class="nav" id="nav-header">
    <div class="nav-in">
      <a href="/" class="nav-marchio" aria-label="Barbi Pelletteria, dal 1992">
        <Marchio size="normale" />
      </a>
      {/* Nav CENTRATA (richiesta esplicita) — non più allineata a destra:
          grid a tre colonne (1fr auto 1fr) invece di flex+margin-left:auto,
          perché logo e carrello hanno larghezze diverse fra loro — con un
          flex centrato "a occhio" la voce centrale non sarebbe stata
          davvero in mezzo alla barra, solo in mezzo allo spazio residuo. */}
      <nav class="nav-right" aria-label="Menu principale">
        <a href="/" class="hideable" aria-current={eAttivo('/') ? 'page' : undefined}>Home</a>
        <a href="/portafogli/" class="hideable" aria-current={eAttivo('/portafogli/') ? 'page' : undefined}>Prodotti</a>
        <a href="/chi-siamo/" class="hideable" aria-current={eAttivo('/chi-siamo/') ? 'page' : undefined}>Il laboratorio</a>
        <a href="/contatti/" class="hideable" aria-current={eAttivo('/contatti/') ? 'page' : undefined}>Contatti</a>
      </nav>
      <div class="nav-servizio">
        {/* PACCHETTO_AUDIT_SITO punto A2: niente contatore "(0)" finché non
            si può comprendere nulla — mostrarlo contraddice il resto del
            sito, che dice "vendita non ancora attiva". */}
        {VENDITA_ATTIVA ? (
          <a href="/carrello/" class="nav-carrello" aria-current={eAttivo('/carrello/') ? 'page' : undefined}>Carrello (<span id="contatore-carrello">0</span>)</a>
        ) : (
          <a href="/carrello/" class="nav-carrello" aria-current={eAttivo('/carrello/') ? 'page' : undefined}>Carrello</a>
        )}
        <button type="button" class="nav-burger" id="nav-burger" aria-expanded="false" aria-controls="nav-menu-mobile" aria-label="Apri il menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
    <nav class="nav-menu-mobile" id="nav-menu-mobile" aria-label="Menu principale, mobile" hidden>
      <a href="/" aria-current={eAttivo('/') ? 'page' : undefined}>Home</a>
      <a href="/portafogli/" aria-current={eAttivo('/portafogli/') ? 'page' : undefined}>Prodotti</a>
      <a href="/chi-siamo/" aria-current={eAttivo('/chi-siamo/') ? 'page' : undefined}>Il laboratorio</a>
      <a href="/contatti/" aria-current={eAttivo('/contatti/') ? 'page' : undefined}>Contatti</a>
    </nav>
  </header>

  <main id="contenuto">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-in">
      <!--
        Quattro colonne (rifinitura 15/09/2026, punto 5): logo+riga
        descrittiva, nav reale, link legali reali, newsletter. La riga
        descrittiva è presa dalla description della pagina (stessa frase
        già scritta e verificata per i meta tag), non un nuovo testo
        inventato per l'occasione.
      -->
      <div class="footer-grid">
        <div class="footer-col footer-col--marchio">
          <div class="footer-badge-riga">
            <Marchio size="piede" />
          </div>
          <p class="footer-col__desc">Portafogli in pelle conciata al vegetale, fatti a mano dal 1992.</p>
          <a href="https://www.instagram.com/barbi_pelletteria/" class="footer-col__social" target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
        <nav class="footer-col" aria-label="Navigazione">
          <p class="footer-col__titolo">Il sito</p>
          <a href="/">Home</a>
          <a href="/portafogli/">Prodotti</a>
          <a href="/chi-siamo/">Il laboratorio</a>
          <a href="/contatti/">Contatti</a>
        </nav>
        <nav class="footer-col" aria-label="Informazioni e supporto">
          <p class="footer-col__titolo">Informazioni</p>
          <a href="/faq/">Domande frequenti</a>
          <a href="/termini-e-condizioni/">Informazioni legali</a>
          <a href="/spedizioni-e-resi/">Spedizioni</a>
          <a href="/diritto-di-recesso/">Recesso e resi</a>
          <a href="/termini-e-condizioni/#garanzia">Garanzia</a>
          <a href="/termini-e-condizioni/#pagamenti-e-prezzi">Pagamenti</a>
          <a href="/privacy/">Privacy e cookie</a>
        </nav>
        <div class="footer-col footer-news">
          <p class="footer-news__titolo">Resta aggiornato</p>
          <p class="footer-news__testo">Nuovi colori, nuovi pezzi, e quando riparte la vendita online.</p>
          <!--
            Iscrizione a lista Brevo con double opt-in (D-026, chiude F-33):
            functions/api/iscrivi-newsletter.js. Non è un invio email come i
            moduli di contatto (invia-modulo.js) — qui il submit è
            intercettato via fetch (vedi script più sotto), niente
            navigazione a una pagina a sé, il modulo stesso mostra l'esito.
          -->
          <form class="footer-news__form" aria-label="Iscrizione alla newsletter">
            <label for="footer-news-email" class="sr-only">Email</label>
            <input type="email" id="footer-news-email" name="email" placeholder="La tua email" autocomplete="email" required />
            <button type="submit" class="pulsante pulsante--piccolo">Iscriviti</button>
            <p class="footer-news__nascosto"><label>Non compilare questo campo <input name="nl-azienda" /></label></p>
            <label class="footer-news__consenso">
              <input type="checkbox" name="consenso" required />
              <span>Accetto di ricevere email promozionali da Barbi Pelletteria (novità, nuovi colori, riapertura della vendita).</span>
            </label>
            <p class="footer-news__consenso-nota"><a href="/privacy/">Leggi come trattiamo i tuoi dati</a>.</p>
            <p class="footer-news__messaggio" role="status" hidden></p>
          </form>
        </div>
      </div>
      <p class="fine">
        Barbi Stefano<br />
        Partita IVA 10311791213 · REA NA-1097798 · <a href={`mailto:${EMAIL_CONTATTO}`}>{EMAIL_CONTATTO}</a>
      </p>
    </div>
  </footer>

  <!--
    Banner iscrizione (2026-09-22, richiesta diretta): stesso modulo
    del footer sopra, non un secondo modulo diverso — riusa le stesse
    classi .footer-news__* (stessi colori/dimensioni già verificati) e
    lo stesso invio reale via functions/api/iscrivi-newsletter.js
    (D-026, vedi script più sotto). Si apre da solo all'apertura del
    sito, si ricorda la chiusura con localStorage (stessa tecnica già
    usata per il consenso cookie sotto) così non si ripresenta a ogni
    pagina per chi l'ha già chiuso una volta.
  -->
  <div id="banner-newsletter" class="banner-newsletter" role="dialog" aria-modal="true" aria-label="Iscrizione alla newsletter" hidden>
    <div class="banner-newsletter__pannello">
      <button type="button" class="banner-newsletter__chiudi" id="banner-newsletter-chiudi" aria-label="Chiudi">
        <span aria-hidden="true">&times;</span>
      </button>
      <p class="footer-news__titolo">Resta aggiornato</p>
      <p class="footer-news__testo">Nuovi colori, nuovi pezzi, e quando riparte la vendita online.</p>
      <form class="footer-news__form" id="banner-newsletter-form" aria-label="Iscrizione alla newsletter">
        <label for="banner-newsletter-email" class="sr-only">Email</label>
        <input type="email" id="banner-newsletter-email" name="email" placeholder="La tua email" autocomplete="email" required />
        <button type="submit" class="pulsante pulsante--piccolo">Iscriviti</button>
        <p class="footer-news__nascosto"><label>Non compilare questo campo <input name="nl-azienda" /></label></p>
        <label class="footer-news__consenso">
          <input type="checkbox" name="consenso" required />
          <span>Accetto di ricevere email promozionali da Barbi Pelletteria (novità, nuovi colori, riapertura della vendita).</span>
        </label>
        <p class="footer-news__consenso-nota"><a href="/privacy/">Leggi come trattiamo i tuoi dati</a>.</p>
        <p class="footer-news__messaggio" role="status" hidden></p>
      </form>
    </div>
  </div>

  {gaId && (
    <div id="cookie-banner" class="cookie-banner" role="dialog" aria-live="polite" aria-label="Informativa cookie" data-ga-id={gaId} hidden>
      <p class="cookie-banner__testo">
        Questo sito usa Google Analytics per contare le visite in forma anonima.
        Parte solo se lo accetti. Vedi la <a href="/privacy/">privacy e cookie</a>.
      </p>
      <div class="cookie-banner__azioni">
        <button type="button" class="pulsante" id="cookie-accetta">Accetta</button>
        <button type="button" class="pulsante pulsante-secondario" id="cookie-rifiuta">Rifiuta</button>
      </div>
    </div>
  )}

  <script>
    // Consenso preventivo: legge il Measurement ID dal banner (se presente) e
    // carica GA4 solo dopo un "Accetta". Nessuna richiesta di rete prima.
    import { getConsent, setConsent, loadAnalytics } from '../scripts/consent.js';

    const banner = document.getElementById('cookie-banner');
    const gaId = banner?.getAttribute('data-ga-id') || '';

    if (gaId) {
      const scelta = getConsent();
      if (scelta === 'accepted') {
        loadAnalytics(gaId);
      } else if (scelta !== 'rejected') {
        banner.hidden = false;
      }

      document.getElementById('cookie-accetta')?.addEventListener('click', () => {
        setConsent('accepted');
        banner.hidden = true;
        loadAnalytics(gaId);
      });
      document.getElementById('cookie-rifiuta')?.addEventListener('click', () => {
        setConsent('rejected');
        banner.hidden = true;
      });
    }
  </script>

  <script>
    // Banner iscrizione: si apre da solo se non è già stato chiuso in
    // precedenza (localStorage, stessa tecnica del consenso cookie sopra
    // — non deve ripresentarsi a ogni pagina). Chiusura con la X, Esc o
    // clic fuori dal pannello: stesso pattern già usato per il menu
    // mobile (PACCHETTO_INTERFACCIA punto 3), non inventato qui.
    // Ritardo di 5s prima di aprirsi (richiesta esplicita, "non voglio che
    // esca proprio subito"): prima appariva al caricamento della pagina.
    const BANNER_NEWSLETTER_KEY = 'barbi:newsletter-banner-chiuso';
    const BANNER_NEWSLETTER_RITARDO_MS = 5000;
    const bannerNewsletter = document.getElementById('banner-newsletter');

    function chiudiBannerNewsletter() {
      if (!bannerNewsletter) return;
      bannerNewsletter.hidden = true;
      try {
        window.localStorage.setItem(BANNER_NEWSLETTER_KEY, '1');
      } catch {
        /* ignora */
      }
    }

    if (bannerNewsletter) {
      let giaChiuso = false;
      try {
        giaChiuso = window.localStorage.getItem(BANNER_NEWSLETTER_KEY) === '1';
      } catch {
        /* ignora */
      }
      if (!giaChiuso) {
        setTimeout(() => {
          // Ricontrollato al momento di aprirsi, non solo al caricamento:
          // se nel frattempo (nei 5s) l'ha già chiuso o è tornato sui suoi
          // passi, non deve comunque comparire.
          let chiusoNelFrattempo = false;
          try {
            chiusoNelFrattempo = window.localStorage.getItem(BANNER_NEWSLETTER_KEY) === '1';
          } catch {
            /* ignora */
          }
          if (chiusoNelFrattempo) return;
          bannerNewsletter.hidden = false;
          bannerNewsletter.querySelector('input')?.focus();
        }, BANNER_NEWSLETTER_RITARDO_MS);
      }
    }

    document.getElementById('banner-newsletter-chiudi')?.addEventListener('click', chiudiBannerNewsletter);
    // Niente più chiusura automatica al submit (D-026): con l'iscrizione
    // vera serve un secondo per rispondere, e in caso di errore il banner
    // deve restare aperto per mostrarlo — vedi lo script dedicato più sotto.
    bannerNewsletter?.addEventListener('click', (e) => {
      if (e.target === bannerNewsletter) chiudiBannerNewsletter();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && bannerNewsletter && !bannerNewsletter.hidden) chiudiBannerNewsletter();
    });
  </script>

  <script define:vars={{ emailContatto: EMAIL_CONTATTO }}>
    // Iscrizione newsletter (D-026, chiude F-33): un solo gestore per i due
    // moduli (footer e banner), selezionati insieme via la classe condivisa
    // .footer-news__form — non duplicato. Il submit è intercettato (fetch
    // verso functions/api/iscrivi-newsletter.js), niente navigazione: sono
    // widget dentro la pagina, non pagine a sé come invia-modulo.js.
    // L'iscrizione è double opt-in (Brevo manda una mail di conferma): il
    // messaggio di successo qui dice di controllare la posta, non "fatto".
    function gestisciIscrizioneNewsletter(form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const messaggio = form.querySelector('.footer-news__messaggio');
        const bottone = form.querySelector('button[type="submit"]');
        const datiForm = new FormData(form);

        if (bottone) bottone.disabled = true;
        if (messaggio) messaggio.hidden = true;

        let esito;
        try {
          const risposta = await fetch('/api/iscrivi-newsletter', { method: 'POST', body: datiForm });
          esito = await risposta.json();
        } catch {
          esito = { ok: false, errore: `Errore di connessione. Riprova, o scrivi a ${emailContatto}.` };
        }

        if (esito.ok) {
          form.querySelectorAll('input, .footer-news__consenso, .footer-news__consenso-nota').forEach((el) => {
            el.hidden = true;
          });
          if (bottone) bottone.hidden = true;
          if (messaggio) {
            messaggio.textContent = "Controlla la tua email: c'è un link da cliccare per confermare l'iscrizione.";
            messaggio.hidden = false;
          }
        } else {
          if (bottone) bottone.disabled = false;
          if (messaggio) {
            messaggio.textContent = esito.errore || `Iscrizione non riuscita. Riprova, o scrivi a ${emailContatto}.`;
            messaggio.hidden = false;
          }
        }
      });
    }

    document.querySelectorAll('.footer-news__form').forEach(gestisciIscrizioneNewsletter);
  </script>

  <script>
    // Ombra sticky (rifinitura 15/09/2026): la barra è sempre in cima
    // (position:sticky), l'ombra si aggiunge solo dopo 8px di scroll — è lei
    // a dire "mi sono staccato dal contenuto", non deve esserci sempre.
    // passive:true perché non chiama mai preventDefault: evita che il
    // browser aspetti inutilmente prima di processare lo scroll.
    const header = document.getElementById('nav-header');
    function aggiornaOmbraHeader() {
      header?.classList.toggle('nav--scrolled', window.scrollY > 8);
    }
    aggiornaOmbraHeader();
    window.addEventListener('scroll', aggiornaOmbraHeader, { passive: true });
  </script>

  <script>
    import { getCartCount } from '../scripts/cart.js';
    function aggiornaContatore() {
      const el = document.getElementById('contatore-carrello');
      if (el) el.textContent = String(getCartCount());
    }
    aggiornaContatore();
    window.addEventListener('barbi:cart-changed', aggiornaContatore);
  </script>

  <script>
    // Tasto menu mobile: mostra/nasconde il pannello con le sezioni che
    // da computer stanno nella barra in alto (Prodotti, Il laboratorio,
    // Contatti), nascoste su schermi stretti per mancanza di spazio.
    // PACCHETTO_INTERFACCIA punto 3: chiusura al click fuori e con Esc,
    // focus sulla prima voce all'apertura — mancavano.
    const burger = document.getElementById('nav-burger');
    const menuMobile = document.getElementById('nav-menu-mobile');

    function apriMenuMobile() {
      menuMobile.hidden = false;
      burger.setAttribute('aria-expanded', 'true');
      menuMobile.querySelector('a')?.focus();
    }
    function chiudiMenuMobile(restituisciFocus) {
      menuMobile.hidden = true;
      burger.setAttribute('aria-expanded', 'false');
      if (restituisciFocus) burger.focus();
    }

    burger?.addEventListener('click', () => {
      if (menuMobile.hidden) apriMenuMobile();
      else chiudiMenuMobile(false);
    });
    document.addEventListener('click', (e) => {
      if (menuMobile.hidden) return;
      if (menuMobile.contains(e.target) || burger.contains(e.target)) return;
      chiudiMenuMobile(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menuMobile.hidden) chiudiMenuMobile(true);
    });
  </script>

  <style is:global>
    /* ─────────────────────────────────────────────────────────────────
       Font self-hostati da public/fonts/ (prima Google Fonts CDN).
       Stessi tre pesi/stili già in uso, verificati uno per uno nel
       codice prima di scaricare — non un peso in più.
       Sottoinsieme "latin" soltanto: gli unici caratteri che il sito usa
       sono lettere accentate italiane (à, è, é, ì, ò, ù — già dentro
       Latin-1, non serve "latin-ext") e punteggiatura tipografica
       (', —, … — dentro lo stesso intervallo Unicode del sottoinsieme
       "latin" per questi font). Cirillico, vietnamita, simboli, math:
       mai referenziati da nessuna pagina, non scaricati.
       Scoperta non richiesta ma verificata (hash SHA-256 dei file,
       non solo l'URL): Google serve OGGI lo stesso identico file per
       Archivo 500/600, per Fraunces 400/700 normale e per Lora 400/500
       normale — stesso identico peso visivo per pesi nominalmente
       diversi. Replicato fedelmente qui (stesso file, due dichiarazioni
       @font-face) invece di "corretto": il vincolo era rendering
       identico a prima, non migliore. */
    @font-face {
      font-family: "Fraunces";
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url("/fonts/fraunces-400-700.woff2") format("woff2");
    }
    @font-face {
      font-family: "Fraunces";
      font-style: italic;
      font-weight: 400;
      font-display: swap;
      src: url("/fonts/fraunces-400italic.woff2") format("woff2");
    }
    @font-face {
      font-family: "Lora";
      font-style: normal;
      font-weight: 400 500;
      font-display: swap;
      src: url("/fonts/lora-400-500.woff2") format("woff2");
    }
    @font-face {
      font-family: "Lora";
      font-style: italic;
      font-weight: 400;
      font-display: swap;
      src: url("/fonts/lora-400italic.woff2") format("woff2");
    }
    @font-face {
      font-family: "Archivo";
      font-style: normal;
      font-weight: 500 600;
      font-display: swap;
      src: url("/fonts/archivo-500-600.woff2") format("woff2");
    }

    /* ─────────────────────────────────────────────────────────────────
       Tema unico, chiaro e caldo. È la scelta di un marchio, non una
       preferenza di sistema: niente @media (prefers-color-scheme),
       niente [data-theme]. Stesso asse cromatico di prima (crema/ottone),
       solo con la luminosità invertita — cambiati il 27/08/2026 su
       richiesta del Founder (troppo scuro), vedi RESOCONTO_RIFINITURA.

       L'ottone è il colore dello strumento che imprime le iniziali:
       per questo è l'unico accento, e va usato con parsimonia. Come
       BORDO/FILETTO/CORNICE/RIBATTINO resta --brass anche sui fondi
       chiari (contrasto ~2:1, ok per un elemento non testuale). Come
       TESTO userebbe un ottone illeggibile: per quello c'è --brass-testo,
       la stessa famiglia di colore ma scura. Scurita ulteriormente il
       30/08/2026 su richiesta diretta del Founder ("falle più scure,
       marrone scuro") — resta la stessa tinta di --brass, solo molto
       più marrone/scura (contrasto verificato ~8,4:1 su --raise, ben
       sopra la soglia 4,5:1).
       Tutti i colori stanno qui e da nessun'altra parte. ─────────────── */
    :root {
      --ground: #F2EAE0;
      --raise: #FBF6EC;
      --sunk: #E3D8C7;
      --ink: #211B17;
      --ink2: #5C4F45;
      --ink3: #6E6355;
      --line: #CFC3B4;
      --line2: #BBAFA0;
      --brass: #C6A15B;
      --brass-testo: #5C4520;
      --blu: #7E97C6;
      --bordeaux: #C97F8B;
      --marrone: #6B4226;

      /* Gli stessi due colori in componenti separate: servono per gli aloni
         e i filetti trasparenti (rgba). Stanno qui perché anche una
         trasparenza è un colore, e i colori non si scrivono nei componenti. */
      --brass-rgb: 198, 161, 91;
      --ink-rgb: 33, 27, 23;

      /* Cambiati dal Bodoni/EB Garamond originali su richiesta del Founder:
         "un font più visibile ed artigianale" — Bodoni Moda è un Didone con
         contrasto estremo fra pieni e filetti, elegante ma poco leggibile ed
         effetto moda-editoriale, non artigianale. Fraunces è un serif con
         asse "soft" pensato apposta per marchi di piccola manifattura/artigianato
         (ceramiche, caffè, pelletteria): più visibile, meno rigido, stesso
         registro premium. Lora accompagna nel testo lungo con lo stesso spirito
         più caldo e leggibile di Fraunces, al posto del più sottile EB Garamond. */
      --f-display: "Fraunces", Georgia, serif;
      --f-text: "Lora", Georgia, serif;
      --f-label: "Archivo", system-ui, sans-serif;

      color-scheme: light;
    }

    * { box-sizing: border-box; }
    /* 2026-09-22: provato lo sfondo coccodrillo su tutto il sito, il
       Founder ha preferito tornare a un fondo bianco classico ("no
       proviamo semplicemente un fondo bianco classico") — bianco pieno
       #FFFFFF, non var(--ground) (il crema consueto del sito): chiesto
       esplicitamente "bianco", un colore diverso, non un ritorno silenzioso
       al valore precedente. --ground resta invariata per tutto il resto
       che la usa già (pulsante secondario, pannello menu mobile, ecc.) —
       qui si tocca solo lo sfondo pagina, non il token condiviso. Gli
       asset coccodrillo restano su disco, non cancellati. */
    body {
      margin: 0;
      background: #FFFFFF;
      color: var(--ink);
      font-family: var(--f-text);
      font-size: 19px;
      line-height: 1.68;
      -webkit-text-size-adjust: 100%;
    }
    a { color: inherit; }
    img { max-width: 100%; display: block; }

    /* ---- impaginazione ---- */
    .contenitore { max-width: 1120px; margin: 0 auto; padding: 0 22px; }
    .narrow { max-width: 660px; margin-left: auto; margin-right: auto; }
    .sec { padding: 78px 0; }
    .sec-top { text-align: center; margin-bottom: 44px; }
    .sec-top p { margin: 0 auto; color: var(--ink2); max-width: 50ch; font-size: 18px; }

    /* ---- titoli: Bodoni in peso 400 e grande. La magrezza è il pregio. ---- */
    h1, h2 {
      font-family: var(--f-display);
      font-weight: 400;
      margin: 0 0 12px;
      text-wrap: balance;
    }
    h1 {
      font-size: clamp(34px, 6.4vw, 68px);
      line-height: 1.08;
      letter-spacing: -.005em;
      margin: 0 auto 22px;
      max-width: 19ch;
    }
    h2 { font-size: clamp(27px, 3.7vw, 42px); line-height: 1.14; }
    /* Una parola in corsivo e in ottone. Una sola. */
    h1 em, h2 em { font-style: italic; color: var(--brass-testo); }
    h3 { font-family: var(--f-display); font-weight: 400; font-size: 23px; margin: 0 0 6px; }

    .lede { font-size: clamp(18px, 2.1vw, 21px); color: var(--ink2); max-width: 52ch; margin: 0 auto; line-height: 1.6; }

    .eyebrow {
      font-family: var(--f-label); font-size: 10.5px; font-weight: 600;
      letter-spacing: .24em; text-indent: .24em; text-transform: uppercase;
      color: var(--brass-testo); margin: 0 0 22px;
    }

    /* ---- testata (rifinitura 15/09/2026, D-019 pixel-perfect) ----
       Torna a --ground: la foto di pelle scura (D-015 originale, deroga a
       C-11) è SUPERATA da questa scelta, non affiancata — il riferimento
       vuole un header chiaro e "flottante" che si stacca dal contenuto con
       un'ombra allo scroll, non una fascia scura fissa. marchio-pelle-texture.jpg
       resta sul disco, non cancellato (stesso trattamento già riservato agli
       altri asset superati). Sticky con ombra aggiunta via classe .nav--scrolled
       (script sotto, soglia 8px) invece che sempre presente: è l'ombra che deve
       segnalare "mi sono staccato dal contenuto", non esistere sempre uguale. */
    /* 2026-09-22: torna alla testata di sempre — foto di pelle vera come
       sfondo (D-015 originale, deroga a C-11) invece del fondo chiaro
       piatto introdotto dal redesign del 15/09. Foto sostituita lo
       stesso giorno (seconda richiesta): non più marchio-pelle-texture.jpg
       (repeat-x, texture piccola), ma una foto vera più grande fornita
       dal Founder (Claude outputs/foto-pelle-reale/, verificata non
       ripetuta/sintetica — autocorrelazione senza picchi secondari,
       stesso controllo già usato per distinguere D-018 da D-019),
       cover invece di repeat: è una foto con un soggetto (la piega
       centrale), non una texture pensata per ripetersi. #16110E resta
       come sfondo di riserva mentre la foto carica. Sticky + ombra allo
       scroll (rifinitura 15/09) restano: comportamento indipendente dal
       colore della barra, non era oggetto della richiesta. */
    .nav {
      position: sticky; top: 0; z-index: 40;
      background-color: #16110E;
      background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('/pelle/foto-pelle-orizzontale.jpg');
      background-size: cover;
      /* Stessa foto del footer ma un'inquadratura diversa (15% 55%,
         verso sinistra): il footer mostra il nodo centrale, qui si vede
         una piega diversa — altrimenti le due barre, entrambe ritagliate
         "center" dalla stessa immagine, sarebbero praticamente identiche. */
      background-position: 15% 55%;
      border-bottom: 1px solid var(--brass);
      transition: box-shadow 180ms ease;
    }
    @supports (background-image: url('data:image/webp;base64,UklGR')) {
      .nav { background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('/pelle/foto-pelle-orizzontale.webp'); }
    }
    .nav.nav--scrolled { box-shadow: 0 2px 12px rgba(33, 27, 23, .08); }
    /* Grid a tre colonne, non flex: logo e servizio (carrello) hanno
       larghezze diverse, un flex "centrato a occhio" con margin-left:auto
       non mette davvero la nav in mezzo alla BARRA, solo in mezzo allo
       spazio che resta — 1fr auto 1fr centra sempre la colonna di mezzo
       sull'intera larghezza, qualunque sia la larghezza dei lati. */
    .nav-in {
      max-width: 1120px; margin: 0 auto; padding: 14px 22px;
      display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 28px;
      min-height: 56px;
    }
    @media (min-width: 681px) { .nav-in { min-height: 62px; } }
    /* 2026-09-22: il marchio in testata torna al componente Marchio (nome +
       filetti + dicitura), come nel footer — non più l'immagine
       marchio-pelle-lettere*.png, richiesta esplicita dopo aver visto il
       footer ("mi piace il logo così, lo voglio sia nel footer che
       nell'header"). Bianco pieno anche sui filetti (prima erano sempre
       --brass, mai passati per una custom property: aggiunta
       --marchio-colore-filetto in Marchio.astro apposta, un solo punto
       dove viene usato oggi oltre al footer, nessun rischio di cambiare
       colore altrove per sbaglio). */
    .nav-marchio {
      display: flex; align-items: center; gap: 12px; text-decoration: none; justify-self: start;
      --marchio-colore-nome: #FFFFFF;
      --marchio-colore-filetto: #FFFFFF;
      /* Dimenticata nel primo giro: senza, .marchio__sub eredita il suo
         fallback pensato per fondo chiaro (--ink3, bruno scuro) — su
         pelle scura sarebbe stato quasi invisibile. Stesso valore già
         verificato nel footer, non un nuovo colore inventato qui. */
      --marchio-colore-sub: rgba(251, 246, 236, .72);
    }
    /* Badge decorativo, non un simbolo nuovo: un riquadro di colore con la
       stessa cucitura tratteggiata del resto del sito, vuoto — l'identità
       la porta il nome accanto, non un'icona inventata (vincolo fermo dal
       primo brief, mai caduto). ~40px per non superare la nav accanto,
       misurato dopo. */
    .header-badge {
      display: block; width: 40px; height: 40px; flex: 0 0 auto;
      background: var(--marrone);
      border: 1px dashed rgba(251, 246, 236, .45);
      border-radius: 6px;
      box-shadow: inset 0 0 0 3px rgba(0, 0, 0, .1);
    }
    .nav-right { grid-column: 2; justify-self: center; display: flex; gap: 28px; align-items: center; }
    .nav-servizio { grid-column: 3; justify-self: end; display: flex; gap: 18px; align-items: center; }
    .nav a {
      font-family: var(--f-label); font-size: 12.5px; font-weight: 500; letter-spacing: .05em;
      text-transform: uppercase; color: var(--raise); text-decoration: none; white-space: nowrap;
    }
    /* Sottolineatura che si espande da sinistra invece del bottone cucito:
       i bottoni cuciti restano riservati alle call-to-action (richiesta
       esplicita), altrimenti perdono forza distintiva. scaleX invece di
       width: anima la GPU, non il layout — nessun reflow ad ogni hover.
       Solo .nav-right (le voci editoriali): il carrello, in .nav-servizio,
       resta un link di servizio — hover di colore, niente riga in crescita. */
    .nav-right a { position: relative; padding: 8px 0; }
    .nav-right a::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 4px;
      height: 1.5px; background: var(--brass);
      transform: scaleX(0); transform-origin: left;
      transition: transform 180ms ease;
    }
    .nav-right a:hover::after,
    .nav-right a[aria-current="page"]::after { transform: scaleX(1); }
    .nav a:hover { color: var(--brass); }
    /* Voce attiva: stessa sottolineatura permanente + peso del testo — un
       colore/una riga da soli non bastano (non-color indicator). */
    .nav a[aria-current="page"] { color: var(--brass); font-weight: 600; }
    .nav-carrello { padding: 8px 0; }

    /* Tasto menu mobile (tre lineette): invisibile da computer, il menu
       a comparsa sotto sostituisce i link .hideable nascosti in basso. */
    .nav-burger {
      display: none;
      flex-direction: column; justify-content: center; align-items: stretch;
      gap: 5px; width: 30px; height: 30px; padding: 0; margin: 0;
      background: none; border: 0; cursor: pointer;
    }
    .nav-burger span { display: block; height: 2px; background: var(--raise); }

    /* display:none di base, senza condizioni: a computer il pannello non
       esiste mai, qualunque sia lo stato di [hidden] — nessun conflitto
       di specificità possibile (unica dichiarazione di display in gioco). */
    .nav-menu-mobile { display: none; }

    @media (max-width: 680px) {
      .nav a.hideable { display: none; }
      .nav-in { gap: 10px; padding: 10px 20px; min-height: 64px; }
      .header-badge { width: 32px; height: 32px; }
      .nav-burger { display: flex; }
      /* "A schermo intero" (richiesta esplicita): non più un pannello che
         si apre sotto la barra in flusso normale, un overlay fisso che
         copre tutto sotto l'header. inset dinamico sull'altezza reale della
         barra (64px qui) così non lascia né buchi né sovrapposizioni se
         l'altezza dell'header cambia in futuro. */
      .nav-menu-mobile {
        display: flex; flex-direction: column;
        position: fixed; top: 64px; left: 0; right: 0; bottom: 0;
        background: var(--ground);
        overflow-y: auto;
      }
      /* stessa causa del bug banner cookie (C-13): serve sempre questa
         regola più specifica, altrimenti [hidden] non vince su display:flex. */
      .nav-menu-mobile[hidden] { display: none; }
      /* Voci grandi, facili da toccare (richiesta esplicita, min 48px di
         area tocco reale — qui 22px di padding verticale + il testo danno
         più margine di quel minimo, non il minimo esatto). */
      .nav-menu-mobile a {
        padding: 22px 24px; border-bottom: 1px solid var(--line);
        color: var(--ink); font-size: 15px; letter-spacing: .04em;
      }
      .nav-menu-mobile a:last-child { border-bottom: 0; }
      .nav-menu-mobile a:hover, .nav-menu-mobile a:focus-visible { color: var(--brass-testo); }
      .nav-menu-mobile a[aria-current="page"] { color: var(--brass-testo); font-weight: 600; }
    }

    /* ---- pastiglie colore (scheda + pagina prodotto) ---- */
    .swatches { display: flex; gap: 11px; margin-top: 20px; align-items: center; flex-wrap: wrap; }
    /* PACCHETTO_INTERFACCIA punto 2 — causa reale trovata: sulla pagina
       prodotto .sw è uno <span> (pattern radio+span, diverso dal <button>
       usato sulle schede). Uno span resta display:inline di default, e un
       elemento inline IGNORA width/height per specifica CSS — non è un
       problema di flex che comprime, è che 26px (poi 44px) non venivano
       proprio applicati: misurato display:inline con getComputedStyle,
       dimensione reale 2×26px contro i 44×44 dichiarati. Sui <button>
       delle schede il difetto era mascherato perché i bottoni sono già
       block-level di default. display:inline-block è la correzione alla
       radice; aspect-ratio e flex:0 0 auto restano come seconda difesa nel
       caso .sw finisca in un contenitore flex che tenti comunque di
       comprimerlo. 44px è anche la soglia minima di area toccabile. */
    .sw {
      display: inline-block;
      width: 44px; height: 44px; aspect-ratio: 1; flex: 0 0 auto;
      border-radius: 50%; cursor: pointer; position: relative;
      border: 1px solid rgba(var(--ink-rgb), .22); padding: 0; appearance: none; -webkit-appearance: none;
      background-size: cover; background-position: center;
    }
    .sw[data-c="blu"] { background-color: var(--blu); }
    .sw[data-c="bordeaux"] { background-color: var(--bordeaux); }
    .sw[data-c="marrone"] { background-color: var(--marrone); }
    /* PACCHETTO_INTERFACCIA punto 1: la macro (quando esiste, vedi
       MACRO_PELLE in prodotti.js) arriva come background-image inline,
       scritto solo quando il percorso non è null — finché è null non c'è
       nessuno stile inline e resta la tinta piatta qui sopra, invariata.
       Il ritaglio è già quadrato-poi-cerchio: object-fit non si applica a
       un background, l'equivalente qui è background-size:cover (sopra) su
       un elemento già border-radius:50%. */
    .sw.on::after { content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--brass); }
    .sw:disabled { opacity: .32; cursor: not-allowed; }
    .sw-label {
      font-family: var(--f-label); font-size: 11px; letter-spacing: .08em;
      text-transform: uppercase; color: var(--ink3); margin-left: 8px;
    }

    /* ---- pulsanti, un solo sorgente di verità ----
       2026-09-22: il Founder ha chiuso l'intera linea di sperimentazione
       "texture di pelle sui pulsanti" (D-018→D-023) — "non mi piace,
       torniamo ai pulsanti classici, togliamo questi pulsanti". Tornano
       a tinta piena: ottone per l'azione primaria (stesso linguaggio
       visivo già consolidato per swatch attivo/voce di menu attiva,
       D-015 rivista — ora esteso a TUTTI i pulsanti primari, non solo a
       quelli di incasso: un solo trattamento, non due da distinguere),
       bordo tratteggiato su fondo chiaro per il secondario. Gli asset
       (texture-pulsante-*.png/webp, incluse le 8 famiglie D-023) restano
       su disco, non cancellati — stesso trattamento riservato a ogni
       altro asset superato in questo progetto. */
    .buy, .pulsante {
      display: inline-block;
      font-family: var(--f-label); font-size: 12.5px; font-weight: 600;
      letter-spacing: .16em; text-transform: uppercase;
      color: var(--ink);
      background-color: var(--brass);
      border: 1px solid var(--brass); border-radius: 4px; padding: 17px 26px;
      text-decoration: none; text-align: center; cursor: pointer;
    }
    .buy:hover, .pulsante:hover { filter: brightness(1.08); }
    .buy:disabled, .pulsante:disabled, .pulsante[aria-disabled="true"] { opacity: .45; cursor: not-allowed; filter: none; }
    /* 2026-09-22: "tutti i pulsanti devono essere di questo colore" (foto
       del pulsante ottone allegata) — il secondario perde la distinzione
       bordo tratteggiato/fondo chiaro, diventa uguale al primario. Resta
       una classe a parte (non unificata con .buy/.pulsante) solo perché
       riscrivere ~7 file per usare un'unica classe sarebbe un rischio
       inutile per un risultato visivo già identico — non perché ci sia
       ancora una differenza voluta. Alias --secondario/-secondario: il
       sito usa già "-secondario" a singolo trattino in quei punti. */
    .buy.soon, .pulsante-secondario, .pulsante--secondario {
      background-color: var(--brass);
      color: var(--ink);
      border: 1px solid var(--brass); border-radius: 4px;
    }
    .buy.soon:hover, .pulsante-secondario:hover, .pulsante--secondario:hover { filter: brightness(1.08); }
    /* --grande (hero): stesso identico componente, solo più spazio interno.
       --piccolo: per contesti compatti, non usato nel banner cookie
       (già suo). */
    .pulsante--grande { padding: 16px 36px; font-size: 13.5px; }
    .pulsante--piccolo { padding: 10px 18px; font-size: 11px; }

    /* ---- prezzo, ricorre su scheda e pagina prodotto ---- */
    .p-price { font-family: var(--f-display); font-size: 23px; margin-top: 12px; font-variant-numeric: tabular-nums; }
    .p-price em { font-style: italic; font-size: 15px; color: var(--ink3); margin-left: 10px; }
    .p-kick {
      font-family: var(--f-label); font-size: 10px; font-weight: 600; letter-spacing: .19em;
      text-transform: uppercase; color: var(--brass-testo); margin: 22px 0 0;
    }

    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 46px; }
    @media (max-width: 740px) { .grid2 { grid-template-columns: 1fr; gap: 56px; } }

    /* ---- pagine di solo testo: legali, contatti ---- */
    .pagina-testo { max-width: 660px; padding: 64px 0; }
    .pagina-testo h1 { font-size: clamp(30px, 4.4vw, 44px); max-width: none; margin: 0 0 26px; text-align: left; }
    .pagina-testo h2 { font-size: clamp(22px, 2.6vw, 27px); margin: 44px 0 12px; }
    .pagina-testo p { margin: 0 0 20px; }
    .pagina-testo li { margin-bottom: 8px; }
    /* :not(.pulsante) impedisce a questa regola di vincere sul colore del
       testo bottone quando un .pulsante sta dentro una pagina di testo (es.
       "Compila il modulo di recesso"): senza, .pagina-testo a (0,1,1) batte
       .pulsante (0,1,0) per specificità e il bottone diventa illeggibile
       (ottone su ottone). */
    .pagina-testo a:not(.pulsante) { color: var(--brass-testo); }

    .riquadro { border: 1px solid var(--line); background: var(--raise); padding: 26px; margin-top: 34px; }
    .riquadro h2 { margin-top: 0; }
    .riquadro :last-child { margin-bottom: 0; }

    .segnaposto { color: var(--ink3); font-style: italic; font-size: 0.95em; }

    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }

    .salta-contenuto {
      position: absolute; left: -999px; top: 0;
      background: var(--brass); color: var(--ink);
      padding: 12px 16px; z-index: 100;
      font-family: var(--f-label); font-size: 12px; font-weight: 600;
      letter-spacing: .1em; text-transform: uppercase;
    }
    .salta-contenuto:focus { left: 12px; top: 12px; }

    /* ---- piè di pagina (redesign 15/09/2026): fondo scurito con --ink,
       nessun colore nuovo, come richiesto. Le custom property
       --marchio-colore-nome/--marchio-colore-sub esistono in Marchio.astro
       da inizio settembre, costruite apposta per un fondo scuro e rimaste
       inutilizzate da quando il footer usava la foto invece del marchio
       testuale — qui finalmente servono. */
    /* 2026-09-22: stessa foto di pelle vera della testata (orizzontale su
       desktop, verticale su mobile — il footer da telefono è molto più
       alto che largo, l'orizzontale ritagliata lascerebbe vedere solo
       una fetta stretta). Velo nero 35% sopra la foto: senza, il testo
       misurava sotto soglia ovunque (2,6–3,1:1) — vedi DECISIONI.md D-024,
       calibrato sul pixel più chiaro trovato, non a occhio.
       --marchio-colore-nome portato a bianco puro (richiesta esplicita,
       "tutto bianco") — prima era --raise (crema), coerente col resto del
       sito ma meno bianco di quanto chiesto qui. */
    .site-footer {
      --marchio-colore-nome: #FFFFFF;
      --marchio-colore-filetto: #FFFFFF;
      --marchio-colore-sub: rgba(251, 246, 236, .72);
      background-color: var(--ink);
      background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('/pelle/foto-pelle-orizzontale.jpg');
      background-size: cover;
      background-position: center;
      padding: 72px 22px 40px;
      margin-top: 20px;
    }
    @supports (background-image: url('data:image/webp;base64,UklGR')) {
      .site-footer { background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('/pelle/foto-pelle-orizzontale.webp'); }
    }
    .footer-in { max-width: 1120px; margin: 0 auto; }
    /* Quattro colonne desktop (punto 5): logo largo il doppio delle altre
       tre — è il blocco con più contenuto (badge+wordmark+descrizione). */
    .footer-grid {
      display: grid; grid-template-columns: 2fr 1fr 1fr 1.4fr; gap: 40px;
      text-align: left; padding-bottom: 48px; margin-bottom: 32px;
      border-bottom: 1px solid rgba(251, 246, 236, .18);
    }
    .footer-badge-riga { display: flex; align-items: center; gap: 12px; }
    .footer-col__desc { color: rgba(251, 246, 236, .72); font-size: 14px; line-height: 1.6; margin: 16px 0 0; max-width: 32ch; }
    /* Eredita colore/hover/font da ".footer-col a" sopra — stesso trattamento
       degli altri link del footer, nessuno stile nuovo inventato per
       "sembrare" un social link. */
    .footer-col__social { display: inline-block; margin-top: 14px; }
    .footer-col__titolo {
      font-family: var(--f-label); font-size: 10.5px; font-weight: 600; letter-spacing: .16em;
      /* .5 misurava 4,88:1 — passa ma con margine sottile per un testo
         così piccolo; alzato a .58 per un margine reale, stessa logica
         già applicata al placeholder della newsletter. */
      text-transform: uppercase; color: rgba(251, 246, 236, .58); margin: 0 0 16px;
    }
    .footer-col { display: flex; flex-direction: column; }
    .footer-col a {
      color: rgba(251, 246, 236, .78); text-decoration: none;
      font-family: var(--f-label); font-size: 13px; letter-spacing: .02em;
      padding: 6px 0;
    }
    .footer-col a:hover { color: var(--brass); }
    .footer-news__titolo {
      font-family: var(--f-display); font-style: italic; font-size: clamp(20px, 2.4vw, 24px);
      color: var(--raise); margin: 0 0 10px;
    }
    .footer-news__testo { color: rgba(251, 246, 236, .78); font-size: 14px; line-height: 1.5; margin: 0 0 18px; }
    .footer-news__form { display: flex; gap: 8px; flex-wrap: wrap; }
    .footer-news__form input {
      flex: 1 1 160px; min-width: 0; padding: 12px 14px;
      /* Bordo alzato da .3 a .45: misurato 2,61:1 su --ink, sotto la
         soglia 3:1 per i confini di un componente UI (WCAG 1.4.11). */
      background: rgba(251, 246, 236, .06); border: 1px solid rgba(251, 246, 236, .45);
      border-radius: 3px; color: var(--raise); font-size: 13.5px; font-family: var(--f-label);
    }
    /* Placeholder alzato da .5 a .62: misurato 4,53:1 sul fondo del campo,
       troppo vicino alla soglia 4.5:1 per restarci apposta. */
    .footer-news__form input::placeholder { color: rgba(251, 246, 236, .62); }
    .footer-news__form input:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }
    /* Campo anti-spam (honeypot, D-026): fuori schermo per una persona,
       visibile e compilabile per i bot semplici — se arriva pieno,
       iscrivi-newsletter.js scarta l'invio senza dirlo al bot. Stesso
       principio già in uso per i moduli di invia-modulo.js. */
    .footer-news__nascosto { position: absolute; left: -9999px; }
    /* width:100% dentro un contenitore flex-wrap forza la riga a sé,
       sotto il campo email + pulsante invece che affiancata. */
    .footer-news__consenso {
      display: flex; align-items: flex-start; gap: 8px; width: 100%;
      margin-top: 10px; font-size: 12.5px; line-height: 1.4;
      color: rgba(251, 246, 236, .78); cursor: pointer;
    }
    .footer-news__consenso input[type="checkbox"] {
      flex: 0 0 auto; margin-top: 2px; width: 15px; height: 15px;
      accent-color: var(--brass);
    }
    .footer-news__consenso-nota {
      width: 100%; margin: 4px 0 0; font-size: 11.5px;
      color: rgba(251, 246, 236, .62);
    }
    .footer-news__messaggio {
      width: 100%; margin: 10px 0 0; font-size: 13px; line-height: 1.4;
      color: rgba(251, 246, 236, .92);
    }
    .fine {
      text-align: center;
      margin: 0; font-family: var(--f-label); font-size: 10.5px;
      letter-spacing: .05em; color: rgba(251, 246, 236, .6); line-height: 1.9;
    }
    .fine a { color: rgba(251, 246, 236, .6); }
    @media (max-width: 900px) {
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px 24px; }
      .footer-col--marchio { grid-column: 1 / -1; }
    }
    @media (max-width: 680px) {
      /* Foto verticale invece dell'orizzontale: il footer da telefono è
         molto più alto che largo (~994×375px, misurato) — l'orizzontale
         ritagliata a "cover" lascerebbe vedere solo una fetta stretta al
         centro, la verticale è pensata apposta per questa proporzione. */
      .site-footer {
        padding: 48px 20px 32px;
        background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('/pelle/foto-pelle-verticale.jpg');
      }
      .footer-grid { grid-template-columns: 1fr; gap: 36px; padding-bottom: 32px; margin-bottom: 24px; text-align: center; }
      .footer-badge-riga { justify-content: center; }
      .footer-col__desc { margin-left: auto; margin-right: auto; }
      .footer-news__form { justify-content: center; }
    }
    @media (max-width: 680px) {
      @supports (background-image: url('data:image/webp;base64,UklGR')) {
        .site-footer { background-image: linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)), url('/pelle/foto-pelle-verticale.webp'); }
      }
    }

    /* ---- banner cookie ---- */
    .cookie-banner {
      position: fixed; left: 16px; right: 16px; bottom: 16px;
      max-width: 660px; margin: 0 auto;
      background: var(--raise); border: 1px solid var(--line2);
      padding: 20px 22px; z-index: 50;
      display: flex; flex-wrap: wrap; align-items: center;
      gap: 14px 20px; justify-content: space-between;
    }
    /* .cookie-banner{display:flex} e [hidden]{display:none} hanno la
       stessa specificità (0,1,0): senza questa regola più specifica,
       banner.hidden = true da JS non nasconde nulla — vince sempre flex. */
    .cookie-banner[hidden] { display: none; }
    .cookie-banner__testo { margin: 0; font-size: 16.5px; color: var(--ink2); flex: 1 1 260px; line-height: 1.5; }
    .cookie-banner__testo a { color: var(--brass-testo); }
    .cookie-banner__azioni { display: flex; gap: 10px; }
    .cookie-banner__azioni .pulsante { padding: 12px 18px; font-size: 11px; }

    /* ---- banner iscrizione (2026-09-22) ----
       Overlay a tutta pagina con pannello centrato, sopra al banner
       cookie (z-index maggiore): si apre da solo appena il sito viene
       aperto, richiesta diretta. Stesso fondo scuro (foto+velo) già
       verificato per header/footer — stesso contrasto già misurato per
       .footer-news__titolo/__testo/__form, non un contesto nuovo da
       riverificare da zero. */
    .banner-newsletter {
      position: fixed; inset: 0; z-index: 90;
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
      background: rgba(15, 10, 7, .55);
    }
    /* stessa causa del bug banner cookie/menu mobile: serve sempre questa
       regola più specifica, altrimenti [hidden] non vince su display:flex. */
    .banner-newsletter[hidden] { display: none; }
    /* 2026-09-22: "non mi piace lo sfondo con la pelle, fallo di un colore
       unico" — tinta piena (--ink, lo stesso scuro già usato altrove per
       pannelli/toast), non più la foto+velo del footer. */
    .banner-newsletter__pannello {
      position: relative;
      width: 100%; max-width: 420px;
      padding: 40px 32px;
      border-radius: 4px;
      background-color: var(--ink);
      box-shadow: 0 20px 60px rgba(15, 10, 7, .4);
    }
    .banner-newsletter__pannello .footer-news__titolo,
    .banner-newsletter__pannello .footer-news__testo,
    .banner-newsletter__pannello .footer-news__consenso,
    .banner-newsletter__pannello .footer-news__consenso-nota,
    .banner-newsletter__pannello .footer-news__messaggio { text-align: left; }
    .banner-newsletter__chiudi {
      position: absolute; top: 12px; right: 12px;
      width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
      background: none; border: 0; border-radius: 50%;
      color: var(--raise); font-size: 24px; line-height: 1; cursor: pointer;
    }
    .banner-newsletter__chiudi:hover { background: rgba(251, 246, 236, .12); }
    @media (max-width: 480px) {
      .banner-newsletter__pannello { padding: 32px 22px; }
    }

    :where(a, button, input, .sw):focus-visible { outline: 2px solid var(--brass); outline-offset: 4px; }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</body>
</html>
