---
const { title, description = 'Portafogli in pelle conciata al vegetale, fatti a mano.' } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
import Marchio from '../components/Marchio.astro';
import { EMAIL_CONTATTO } from '../data/prodotti.js';
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} · Barbi Pelletteria</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />
  <!--
    robots noindex volutamente attivo: FATTO QUANDO (B3) dice
    "raggiungibile pubblicamente ma non linkato da nessuna parte,
    non ancora annunciato". Rimuovere questo meta tag solo quando si
    decide di far indicizzare il sito davvero (non è un compito di questo pacchetto).
  -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,700;1,400&family=Lora:ital,wght@0,400;0,500;1,400&family=Archivo:wght@500;600&display=swap" rel="stylesheet" />

  <!--
    GA4 NON viene caricato qui: parte solo dopo il consenso esplicito dato
    tramite il banner cookie in fondo alla pagina. Vedi src/scripts/consent.js.
  -->
</head>
<body>
  <a class="salta-contenuto" href="#contenuto">Vai al contenuto</a>

  <header class="nav">
    <div class="nav-in">
      <a href="/" class="nav-marchio" aria-label="Barbi Pelletteria, dal 1992">
        <img src="/marchio-pelle-logo.jpg" alt="" width="1010" height="280" />
        <span class="nav-marchio__sub">Pelletteria · dal 1992</span>
      </a>
      <nav class="nav-right" aria-label="Menu principale">
        <a href="/prodotti/" class="hideable">Prodotti</a>
        <a href="/chi-siamo/" class="hideable">Il laboratorio</a>
        <a href="/contatti/" class="hideable">Contatti</a>
        <a href="/carrello/">Carrello (<span id="contatore-carrello">0</span>)</a>
        <button type="button" class="nav-burger" id="nav-burger" aria-expanded="false" aria-controls="nav-menu-mobile" aria-label="Apri il menu">
          <span></span><span></span><span></span>
        </button>
      </nav>
    </div>
    <nav class="nav-menu-mobile" id="nav-menu-mobile" aria-label="Menu principale, mobile" hidden>
      <a href="/prodotti/">Prodotti</a>
      <a href="/chi-siamo/">Il laboratorio</a>
      <a href="/contatti/">Contatti</a>
    </nav>
  </header>

  <main id="contenuto">
    <slot />
  </main>

  <footer class="site-footer">
    <Marchio size="piede" />
    <nav class="flinks" aria-label="Informazioni e supporto">
      <a href="/faq/">Domande frequenti</a>
      <a href="/termini-e-condizioni/">Informazioni legali</a>
      <a href="/spedizioni-e-resi/">Spedizioni</a>
      <a href="/diritto-di-recesso/">Recesso e resi</a>
      <a href="/termini-e-condizioni/#garanzia">Garanzia</a>
      <a href="/termini-e-condizioni/#pagamenti-e-prezzi">Pagamenti</a>
      <a href="/privacy/">Privacy e cookie</a>
    </nav>
    <p class="fine">
      Barbi Stefano<br />
      Partita IVA 10311791213 · REA NA-1097798 · <a href={`mailto:${EMAIL_CONTATTO}`}>{EMAIL_CONTATTO}</a>
    </p>
  </footer>

  {gaId && (
    <div id="cookie-banner" class="cookie-banner" role="dialog" aria-live="polite" aria-label="Informativa cookie" data-ga-id={gaId} hidden>
      <p class="cookie-banner__testo">
        Questo sito usa Google Analytics per contare le visite in forma anonima.
        Parte solo se lo accetti. Vedi la <a href="/privacy/">privacy e cookie</a>.
      </p>
      <div class="cookie-banner__azioni">
        <button type="button" class="pulsante" id="cookie-accetta">Accetta</button>
        <button type="button" class="pulsante pulsante-secondario" id="cookie-rifiuta">Rifiuta</button>
      </div>
    </div>
  )}

  <script>
    // Consenso preventivo: legge il Measurement ID dal banner (se presente) e
    // carica GA4 solo dopo un "Accetta". Nessuna richiesta di rete prima.
    import { getConsent, setConsent, loadAnalytics } from '../scripts/consent.js';

    const banner = document.getElementById('cookie-banner');
    const gaId = banner?.getAttribute('data-ga-id') || '';

    if (gaId) {
      const scelta = getConsent();
      if (scelta === 'accepted') {
        loadAnalytics(gaId);
      } else if (scelta !== 'rejected') {
        banner.hidden = false;
      }

      document.getElementById('cookie-accetta')?.addEventListener('click', () => {
        setConsent('accepted');
        banner.hidden = true;
        loadAnalytics(gaId);
      });
      document.getElementById('cookie-rifiuta')?.addEventListener('click', () => {
        setConsent('rejected');
        banner.hidden = true;
      });
    }
  </script>

  <script>
    import { getCartCount } from '../scripts/cart.js';
    function aggiornaContatore() {
      const el = document.getElementById('contatore-carrello');
      if (el) el.textContent = String(getCartCount());
    }
    aggiornaContatore();
    window.addEventListener('barbi:cart-changed', aggiornaContatore);
  </script>

  <script>
    // Tasto menu mobile: mostra/nasconde il pannello con le sezioni che
    // da computer stanno nella barra in alto (Prodotti, Il laboratorio,
    // Contatti), nascoste su schermi stretti per mancanza di spazio.
    const burger = document.getElementById('nav-burger');
    const menuMobile = document.getElementById('nav-menu-mobile');
    burger?.addEventListener('click', () => {
      menuMobile.hidden = !menuMobile.hidden;
      burger.setAttribute('aria-expanded', String(!menuMobile.hidden));
    });
  </script>

  <style is:global>
    /* ─────────────────────────────────────────────────────────────────
       Tema unico, chiaro e caldo. È la scelta di un marchio, non una
       preferenza di sistema: niente @media (prefers-color-scheme),
       niente [data-theme]. Stesso asse cromatico di prima (crema/ottone),
       solo con la luminosità invertita — cambiati il 27/08/2026 su
       richiesta del Founder (troppo scuro), vedi RESOCONTO_RIFINITURA.

       L'ottone è il colore dello strumento che imprime le iniziali:
       per questo è l'unico accento, e va usato con parsimonia. Come
       BORDO/FILETTO/CORNICE/RIBATTINO resta --brass anche sui fondi
       chiari (contrasto ~2:1, ok per un elemento non testuale). Come
       TESTO userebbe un ottone illeggibile: per quello c'è --brass-testo,
       la stessa famiglia di colore ma scura. Scurita ulteriormente il
       30/08/2026 su richiesta diretta del Founder ("falle più scure,
       marrone scuro") — resta la stessa tinta di --brass, solo molto
       più marrone/scura (contrasto verificato ~8,4:1 su --raise, ben
       sopra la soglia 4,5:1).
       Tutti i colori stanno qui e da nessun'altra parte. ─────────────── */
    :root {
      --ground: #F2EAE0;
      --raise: #FBF6EC;
      --sunk: #E3D8C7;
      --ink: #211B17;
      --ink2: #5C4F45;
      --ink3: #6E6355;
      --line: #CFC3B4;
      --line2: #BBAFA0;
      --brass: #C6A15B;
      --brass-testo: #5C4520;
      --blu: #7E97C6;
      --bordeaux: #C97F8B;
      --marrone: #6B4226;

      /* Gli stessi due colori in componenti separate: servono per gli aloni
         e i filetti trasparenti (rgba). Stanno qui perché anche una
         trasparenza è un colore, e i colori non si scrivono nei componenti. */
      --brass-rgb: 198, 161, 91;
      --ink-rgb: 33, 27, 23;

      /* Cambiati dal Bodoni/EB Garamond originali su richiesta del Founder:
         "un font più visibile ed artigianale" — Bodoni Moda è un Didone con
         contrasto estremo fra pieni e filetti, elegante ma poco leggibile ed
         effetto moda-editoriale, non artigianale. Fraunces è un serif con
         asse "soft" pensato apposta per marchi di piccola manifattura/artigianato
         (ceramiche, caffè, pelletteria): più visibile, meno rigido, stesso
         registro premium. Lora accompagna nel testo lungo con lo stesso spirito
         più caldo e leggibile di Fraunces, al posto del più sottile EB Garamond. */
      --f-display: "Fraunces", Georgia, serif;
      --f-text: "Lora", Georgia, serif;
      --f-label: "Archivo", system-ui, sans-serif;

      color-scheme: light;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--ground);
      color: var(--ink);
      font-family: var(--f-text);
      font-size: 19px;
      line-height: 1.68;
      -webkit-text-size-adjust: 100%;
    }
    a { color: inherit; }
    img { max-width: 100%; display: block; }

    /* ---- impaginazione ---- */
    .contenitore { max-width: 1120px; margin: 0 auto; padding: 0 22px; }
    .narrow { max-width: 660px; margin-left: auto; margin-right: auto; }
    .sec { padding: 78px 0; }
    .sec-top { text-align: center; margin-bottom: 44px; }
    .sec-top p { margin: 0 auto; color: var(--ink2); max-width: 50ch; font-size: 18px; }

    /* ---- titoli: Bodoni in peso 400 e grande. La magrezza è il pregio. ---- */
    h1, h2 {
      font-family: var(--f-display);
      font-weight: 400;
      margin: 0 0 12px;
      text-wrap: balance;
    }
    h1 {
      font-size: clamp(34px, 6.4vw, 68px);
      line-height: 1.08;
      letter-spacing: -.005em;
      margin: 0 auto 22px;
      max-width: 19ch;
    }
    h2 { font-size: clamp(27px, 3.7vw, 42px); line-height: 1.14; }
    /* Una parola in corsivo e in ottone. Una sola. */
    h1 em, h2 em { font-style: italic; color: var(--brass-testo); }
    h3 { font-family: var(--f-display); font-weight: 400; font-size: 23px; margin: 0 0 6px; }

    .lede { font-size: clamp(18px, 2.1vw, 21px); color: var(--ink2); max-width: 52ch; margin: 0 auto; line-height: 1.6; }

    .eyebrow {
      font-family: var(--f-label); font-size: 10.5px; font-weight: 600;
      letter-spacing: .24em; text-indent: .24em; text-transform: uppercase;
      color: var(--brass-testo); margin: 0 0 22px;
    }

    /* ---- testata ---- */
    /* Sfondo in pelle vera (foto), su richiesta diretta del Founder — deroga
       esplicita a C-11 (CORREZIONI.md), registrata in DECISIONI.md. #16110E
       è il colore medio della pelle nella foto stessa (campionato via
       canvas), non un marrone a caso: dove la foto non copre tutta la barra
       (schermi molto larghi/stretti) il colore continua senza taglio netto.
       Testo e tasto menu passano da --ink2/--ink a un chiaro per il nuovo
       fondo scuro — verificato per contrasto, non solo "sembra giusto". */
    .nav { background: #16110E; border-bottom: 1px solid var(--brass); }
    .nav-in { max-width: 1120px; margin: 0 auto; padding: 14px 22px; display: flex; align-items: center; gap: 28px; }
    .nav-marchio { display: flex; flex-direction: column; gap: 6px; text-decoration: none; }
    .nav-marchio img { display: block; height: 46px; width: auto; }
    .nav-marchio__sub {
      font-family: var(--f-label); font-size: 8px; font-weight: 500;
      letter-spacing: .26em; text-indent: .26em; text-transform: uppercase;
      color: var(--raise); opacity: .75;
    }
    .nav-right { margin-left: auto; display: flex; gap: 24px; align-items: center; }
    .nav a {
      font-family: var(--f-label); font-size: 12.5px; font-weight: 500; letter-spacing: .05em;
      text-transform: uppercase; color: var(--raise); text-decoration: none; white-space: nowrap;
    }
    .nav a:hover { color: var(--brass); }

    /* Tasto menu mobile (tre lineette): invisibile da computer, il menu
       a comparsa sotto sostituisce i link .hideable nascosti in basso. */
    .nav-burger {
      display: none;
      flex-direction: column; justify-content: center; align-items: stretch;
      gap: 5px; width: 30px; height: 30px; padding: 0; margin: 0;
      background: none; border: 0; cursor: pointer;
    }
    .nav-burger span { display: block; height: 2px; background: var(--raise); }

    /* display:none di base, senza condizioni: a computer il pannello non
       esiste mai, qualunque sia lo stato di [hidden] — nessun conflitto
       di specificità possibile (unica dichiarazione di display in gioco). */
    .nav-menu-mobile { display: none; }

    @media (max-width: 680px) {
      .nav a.hideable { display: none; }
      .nav-in { gap: 14px; padding: 12px 22px; }
      .nav-marchio img { height: 36px; }
      .nav-burger { display: flex; }
      .nav-menu-mobile {
        display: flex; flex-direction: column;
        border-top: 1px solid var(--line);
        background: var(--raise);
      }
      /* stessa causa del bug banner cookie (C-13): serve sempre questa
         regola più specifica, altrimenti [hidden] non vince su display:flex. */
      .nav-menu-mobile[hidden] { display: none; }
      .nav-menu-mobile a {
        padding: 16px 22px; border-bottom: 1px solid var(--line);
      }
      .nav-menu-mobile a:last-child { border-bottom: 0; }
    }

    /* ---- pastiglie colore (scheda + pagina prodotto) ---- */
    .swatches { display: flex; gap: 11px; margin-top: 20px; align-items: center; flex-wrap: wrap; }
    .sw {
      width: 26px; height: 26px; border-radius: 50%; cursor: pointer; position: relative;
      border: 1px solid rgba(var(--ink-rgb), .22); padding: 0; appearance: none; -webkit-appearance: none;
    }
    .sw[data-c="blu"] { background: var(--blu); }
    .sw[data-c="bordeaux"] { background: var(--bordeaux); }
    .sw[data-c="marrone"] { background: var(--marrone); }
    .sw.on::after { content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--brass); }
    .sw:disabled { opacity: .32; cursor: not-allowed; }
    .sw-label {
      font-family: var(--f-label); font-size: 11px; letter-spacing: .08em;
      text-transform: uppercase; color: var(--ink3); margin-left: 8px;
    }

    /* ---- pulsanti ---- */
    .buy, .pulsante {
      display: inline-block;
      font-family: var(--f-label); font-size: 12.5px; font-weight: 600;
      letter-spacing: .16em; text-transform: uppercase;
      background: var(--brass); color: var(--ink);
      border: 1px solid var(--brass); padding: 17px 26px;
      text-decoration: none; text-align: center; cursor: pointer;
    }
    .buy:hover, .pulsante:hover { filter: brightness(1.08); }
    .buy:disabled, .pulsante:disabled, .pulsante[aria-disabled="true"] { opacity: .45; cursor: not-allowed; filter: none; }
    .buy.soon, .pulsante-secondario { background: transparent; color: var(--brass-testo); }

    /* ---- prezzo, ricorre su scheda e pagina prodotto ---- */
    .p-price { font-family: var(--f-display); font-size: 23px; margin-top: 12px; font-variant-numeric: tabular-nums; }
    .p-price em { font-style: italic; font-size: 15px; color: var(--ink3); margin-left: 10px; }
    .p-kick {
      font-family: var(--f-label); font-size: 10px; font-weight: 600; letter-spacing: .19em;
      text-transform: uppercase; color: var(--brass-testo); margin: 22px 0 0;
    }

    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 46px; }
    @media (max-width: 740px) { .grid2 { grid-template-columns: 1fr; gap: 56px; } }

    /* ---- pagine di solo testo: legali, contatti ---- */
    .pagina-testo { max-width: 660px; padding: 64px 0; }
    .pagina-testo h1 { font-size: clamp(30px, 4.4vw, 44px); max-width: none; margin: 0 0 26px; text-align: left; }
    .pagina-testo h2 { font-size: clamp(22px, 2.6vw, 27px); margin: 44px 0 12px; }
    .pagina-testo p { margin: 0 0 20px; }
    .pagina-testo li { margin-bottom: 8px; }
    /* :not(.pulsante) impedisce a questa regola di vincere sul colore del
       testo bottone quando un .pulsante sta dentro una pagina di testo (es.
       "Compila il modulo di recesso"): senza, .pagina-testo a (0,1,1) batte
       .pulsante (0,1,0) per specificità e il bottone diventa illeggibile
       (ottone su ottone). */
    .pagina-testo a:not(.pulsante) { color: var(--brass-testo); }

    .riquadro { border: 1px solid var(--line); background: var(--raise); padding: 26px; margin-top: 34px; }
    .riquadro h2 { margin-top: 0; }
    .riquadro :last-child { margin-bottom: 0; }

    .segnaposto { color: var(--ink3); font-style: italic; font-size: 0.95em; }

    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }

    .salta-contenuto {
      position: absolute; left: -999px; top: 0;
      background: var(--brass); color: var(--ink);
      padding: 12px 16px; z-index: 100;
      font-family: var(--f-label); font-size: 12px; font-weight: 600;
      letter-spacing: .1em; text-transform: uppercase;
    }
    .salta-contenuto:focus { left: 12px; top: 12px; }

    /* ---- piè di pagina ---- */
    .site-footer { border-top: 1px solid var(--line2); padding: 52px 22px 70px; text-align: center; margin-top: 20px; }
    .flinks {
      display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 26px; margin-top: 32px;
      font-family: var(--f-label); font-size: 11px; letter-spacing: .09em; text-transform: uppercase;
    }
    .flinks a { color: var(--ink2); text-decoration: none; }
    .flinks a:hover { color: var(--brass); }
    .fine {
      margin: 28px 0 0; font-family: var(--f-label); font-size: 10.5px;
      letter-spacing: .05em; color: var(--ink3); line-height: 1.9;
    }
    .fine a { color: var(--ink3); }

    /* ---- banner cookie ---- */
    .cookie-banner {
      position: fixed; left: 16px; right: 16px; bottom: 16px;
      max-width: 660px; margin: 0 auto;
      background: var(--raise); border: 1px solid var(--line2);
      padding: 20px 22px; z-index: 50;
      display: flex; flex-wrap: wrap; align-items: center;
      gap: 14px 20px; justify-content: space-between;
    }
    /* .cookie-banner{display:flex} e [hidden]{display:none} hanno la
       stessa specificità (0,1,0): senza questa regola più specifica,
       banner.hidden = true da JS non nasconde nulla — vince sempre flex. */
    .cookie-banner[hidden] { display: none; }
    .cookie-banner__testo { margin: 0; font-size: 16.5px; color: var(--ink2); flex: 1 1 260px; line-height: 1.5; }
    .cookie-banner__testo a { color: var(--brass-testo); }
    .cookie-banner__azioni { display: flex; gap: 10px; }
    .cookie-banner__azioni .pulsante { padding: 12px 18px; font-size: 11px; }

    :where(a, button, input, .sw):focus-visible { outline: 2px solid var(--brass); outline-offset: 4px; }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</body>
</html>
