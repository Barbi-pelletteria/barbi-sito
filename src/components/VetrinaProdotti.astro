---
// Griglia prodotti della home (redesign 15/09/2026). Testi delle card:
// D-029 § 4.1 (QG) — eyebrow, nome, prezzo "49 €" + "spedizione inclusa",
// testo, pulsante "Scopri il…". A vendita spenta niente pulsante
// disabilitato ("un pulsante spento sembra un sito rotto"); a vendita
// accesa il secondo pulsante è "Aggiungi al carrello".
//
// Componente a sé, non una modifica di ProductCard: quel componente è
// condiviso con la pagina collezione. Stessa fonte dati (prodotti.js,
// immagini.js), zero duplicazione della logica di lettura.
import { formatEuroBreve, VENDITA_ATTIVA, stockColore, stockVariante, pelleIniziale } from '../data/prodotti.js';
import { getPelle } from '../data/pelli.js';
import { copertinaProdotto, coloreVetrina } from '../data/immagini.js';

const { prodotti } = Astro.props;
---
{/* Con tre modelli (D-030 § 2.4) la griglia passa a tre colonne da
    computer; da telefono resta una card sotto l'altra. */}
<div class:list={['vetrina', { 'vetrina--tre': prodotti.length >= 3 }]}>
  {prodotti.map((p) => {
    const preferito = p.colori.find((c) => c.slug === coloreVetrina[p.slug] && stockColore(p, c.slug) > 0);
    const coloreAttivo = preferito || p.colori.find((c) => stockColore(p, c.slug) > 0) || p.colori[0];
    const foto = copertinaProdotto(p, coloreAttivo);
    const url = `/prodotto/${p.slug}/`;
    return (
      <article class="v-scheda" data-scheda>
        <a href={url} class:list={['v-scheda__foto', `v-scheda__foto--${p.slug}`]} tabindex="-1" aria-hidden="true">
          {foto && (
            <picture>
              <source srcset={foto.webp} type="image/webp" />
              <img src={foto.jpg} alt={foto.alt} width={foto.width} height={foto.height} loading="lazy" />
            </picture>
          )}
        </a>
        <p class="p-kick">{p.occhielloCard}</p>
        <h3 class="v-scheda__nome"><a href={url}>{p.nome}</a></h3>
        <div class="p-price">{formatEuroBreve(p.prezzoCentesimi)}<em>spedizione inclusa</em></div>
        <p class="v-scheda__desc">{p.sommario}</p>
        <div class:list={['v-scheda__bottoni', { 'v-scheda__bottoni--due': VENDITA_ATTIVA }]}>
          <a href={url} class="pulsante">{p.scopri}</a>
          {VENDITA_ATTIVA && (
            <button
              type="button"
              class="pulsante v-aggiungi"
              data-slug={p.slug}
              data-nome={p.nome}
              data-colore={coloreAttivo.slug}
              data-colore-nome={coloreAttivo.nome}
              data-pelle={pelleIniziale(p, coloreAttivo.slug)}
              data-pelle-nome={getPelle(pelleIniziale(p, coloreAttivo.slug))?.nome || ''}
              data-stock={stockVariante(p, coloreAttivo.slug, pelleIniziale(p, coloreAttivo.slug))}
            >Aggiungi al carrello</button>
          )}
        </div>
      </article>
    );
  })}
</div>

<script>
  import { initAggiungiRapido } from '../scripts/aggiungi-rapido.js';
  initAggiungiRapido();
</script>

<style>
  .vetrina { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .vetrina--tre { grid-template-columns: 1fr 1fr 1fr; gap: 28px; }
  @media (max-width: 740px) { .vetrina, .vetrina--tre { grid-template-columns: 1fr; gap: 48px; } }

  /* Cornice sottile + ombra minima a riposo, leggermente più marcata
     all'hover (le card "si sollevano appena", non saltano — richiesta
     esplicita). Lo zoom è SOLO sulla foto (scale 1.03, 300ms), mai su
     tutta la scheda: overflow:hidden sul riquadro foto la contiene. */
  /* display:flex + colonna: i due riassunti prodotto hanno lunghezze
     diverse, senza questo i bottoni finivano ad altezze diverse fra le
     due schede. margin-top:auto sui bottoni li ancora in fondo. */
  .v-scheda {
    display: flex; flex-direction: column;
    border: 1px solid var(--sunk); border-radius: 4px; padding: 14px 14px 20px;
    box-shadow: 0 1px 4px rgba(33, 27, 23, .05);
    transition: box-shadow 220ms ease;
  }
  .v-scheda:hover { box-shadow: 0 6px 18px rgba(33, 27, 23, .10); }

  /* Stesso riquadro a proporzioni fisse di ProductCard.astro. */
  .v-scheda__foto {
    display: block; text-decoration: none;
    aspect-ratio: 4 / 5; overflow: hidden; background: var(--sunk);
    border-radius: 2px;
  }
  .v-scheda__foto picture, .v-scheda__foto img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: transform 300ms ease;
  }
  .v-scheda:hover .v-scheda__foto img { transform: scale(1.03); }
  /* Lo zoom correttivo sul solo Sottile (scale 1.08, 03/09/2026) è stato
     tolto il 06/10/2026 (D-031): le copertine nuove hanno la stessa
     inquadratura su tutti i colori (il portafoglio riempie il 91,7-93,2%
     della larghezza, misurato), come prevedeva il commento di allora. */

  .v-scheda__nome { font-size: 27px; font-weight: 500; margin: 12px 0 0; line-height: 1.1; }
  .v-scheda__nome a { text-decoration: none; color: inherit; }
  .v-scheda__nome a:hover { color: var(--brass); }
  .v-scheda__desc { color: var(--ink2); font-size: 15px; line-height: 1.5; margin: 10px 0 0; }

  .v-scheda__bottoni { display: grid; grid-template-columns: 1fr; gap: 12px; margin-top: auto; padding-top: 20px; }
  .v-scheda__bottoni--due { grid-template-columns: 1fr 1fr; }
  .v-scheda__bottoni .pulsante { text-align: center; }
</style>
