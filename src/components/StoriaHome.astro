---
import FotoSegnaposto from './FotoSegnaposto.astro';

// "La nostra storia" del redesign 15/09/2026. Non esiste ancora una foto
// vera di Stefano al lavoro o del laboratorio (verificato in
// FOTO_SITO/LEGGIMI.md). Prima qui c'era la macro della pelle marrone come
// ripiego provvisorio — il Founder ha chiesto di toglierla e mettere un
// segnaposto esplicito al suo posto ("ci andrà una foto di stefano che
// lavora, togli questa e metti una scritta segnaposto"): stesso componente
// FotoSegnaposto già usato in pagina prodotto quando manca uno scatto,
// non un secondo modo di segnalare "foto mancante". Quando arriva la foto
// vera, il chiamante mostra una <img> al suo posto (stessa convenzione
// documentata dentro FotoSegnaposto.astro).
//
// Testo: due frasi VERBATIM da Racconto.astro (capitoli "1992" e "2023 · Il
// proprio nome"), non riscritte. Link a /chi-siamo/ per il racconto intero,
// stesso pattern già in Citazione.astro.
---
<section class="storia-home">
  <FotoSegnaposto etichetta="Foto — Stefano al lavoro in laboratorio" ratio="1" class="storia-home__foto" />
  <div class="storia-home__testo">
    <p class="eyebrow">Dal 1992</p>
    <h2>La nostra storia</h2>
    <p class="lede">Stefano Barbi ha diciassette anni quando comincia a lavorare la pelle. Non è una scelta di carriera.</p>
    <p>Poi Stefano ha deciso di mettere il proprio nome sui pezzi che fa. Ha aperto la sua attività e il suo laboratorio, in Campania, e ha ricominciato da capo: senza un marchio noto alle spalle, senza vetrine, senza catalogo.</p>
    <a class="storia-home__link" href="/chi-siamo/">Scopri la nostra storia</a>
  </div>
</section>

<style>
  /* 45/55 (immagine/testo), richiesta esplicita — non più metà e metà. */
  .storia-home {
    display: grid; grid-template-columns: 45fr 55fr; gap: 56px; align-items: center;
    max-width: 1120px; margin: 0 auto; padding: 90px 22px;
  }
  .storia-home__foto { aspect-ratio: 1; overflow: hidden; border-radius: 4px; }
  .storia-home__foto img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .storia-home__testo h2 { margin: 6px 0 22px; }
  .storia-home__testo .lede { font-size: 19px; color: var(--ink); margin: 0 0 16px; font-style: italic; }
  .storia-home__testo p { color: var(--ink2); line-height: 1.7; margin: 0 0 16px; }
  .storia-home__link {
    display: inline-block; margin-top: 10px;
    font-family: var(--f-label); font-size: 11px; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; color: var(--brass-testo);
  }
  .storia-home__link:hover, .storia-home__link:focus-visible { color: var(--brass); }

  @media (max-width: 780px) {
    .storia-home { grid-template-columns: 1fr; gap: 32px; padding: 64px 22px; }
    .storia-home__foto { order: -1; }
  }
</style>
