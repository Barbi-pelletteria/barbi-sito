---
// Segnaposto foto: deve sembrare voluto, non rotto. Fondo incassato, un alone
// caldo al centro e un tratteggio diagonale appena percettibile, con la
// scritta che dice cosa ci andrà. Quando arriva lo scatto vero
// (src/data/immagini.js) il chiamante mostra una <img> al suo posto.
const { etichetta, ratio = '4 / 5', id, class: className = '' } = Astro.props;
---
<div class:list={['foto-segnaposto', className]} style={`aspect-ratio:${ratio}`} id={id}>
  <b>{etichetta}</b>
</div>

<style>
  .foto-segnaposto {
    background-color: var(--sunk);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
    background-image:
      radial-gradient(90% 70% at 50% 45%, rgba(var(--brass-rgb), .075), transparent 65%),
      repeating-linear-gradient(45deg, transparent 0 12px, rgba(var(--brass-rgb), .035) 12px 24px);
  }
  .foto-segnaposto b {
    font-family: var(--f-label);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--ink3);
  }
</style>
