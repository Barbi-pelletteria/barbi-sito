---
// Card della pagina collezione. Testi: gli stessi della home, D-029 § 4.1
// e § 4.2 (QG) — eyebrow, nome, prezzo "49 €" + "spedizione inclusa",
// testo, pulsante "Scopri il…" (+ "Aggiungi al carrello" a vendita
// accesa). La riga di specifiche che c'era sotto (tasche · spessore ·
// peso) non è nei testi del pacchetto: tolta. Le pastiglie colore
// restano: non sono testo, sono il bersaglio del filtro per colore di
// CategoriaTemplate.astro.
import { formatEuroBreve, MACRO_PELLE, VENDITA_ATTIVA } from '../data/prodotti.js';
import { copertinaProdotto, coloreVetrina } from '../data/immagini.js';
import FotoSegnaposto from './FotoSegnaposto.astro';

const { prodotto } = Astro.props;
const url = `/prodotto/${prodotto.slug}/`;

// Colore di vetrina se è ancora disponibile, altrimenti il primo che c'è.
const preferito = prodotto.colori.find(
  (c) => c.slug === coloreVetrina[prodotto.slug] && c.stock > 0
);
const coloreAttivo = preferito || prodotto.colori.find((c) => c.stock > 0) || prodotto.colori[0];
const fotoAttiva = copertinaProdotto(prodotto, coloreAttivo);
const fotoId = `foto-${prodotto.slug}`;

// Copertina di ogni colore, per lo scambio foto al click su una pastiglia.
const fotoPerColore = Object.fromEntries(
  prodotto.colori.map((c) => [c.slug, copertinaProdotto(prodotto, c)])
);

// PACCHETTO_AUDIT_SITO punto A2: a vendita spenta un numero di "disponibili"
// contraddirebbe il resto del sito — resta solo il nome del colore, il
// numero torna quando VENDITA_ATTIVA sarà vero.
const etichettaScorta = (c) =>
  VENDITA_ATTIVA ? (c.stock > 0 ? `${c.nome} · ${c.stock} ${c.stock === 1 ? 'disponibile' : 'disponibili'}` : `${c.nome} · esaurito`) : c.nome;
---
<div class="scheda" data-scheda>
  <a href={url} class:list={['scheda__foto', `scheda__foto--${prodotto.slug}`]} aria-hidden="true" tabindex="-1">
    {fotoAttiva ? (
      <picture id={fotoId}>
        <source srcset={fotoAttiva.webp} type="image/webp" />
        <img src={fotoAttiva.jpg} alt={fotoAttiva.alt} width={fotoAttiva.width} height={fotoAttiva.height} loading="lazy" />
      </picture>
    ) : (
      <FotoSegnaposto id={fotoId} etichetta={`Foto — ${prodotto.nome}, ${coloreAttivo.nome.toLowerCase()}`} />
    )}
  </a>

  <p class="p-kick">{prodotto.occhielloCard}</p>
  <h2 class="p-name"><a href={url}>{prodotto.nome}</a></h2>
  <div class="p-price">{formatEuroBreve(prodotto.prezzoCentesimi)}<em>spedizione inclusa</em></div>
  <p class="p-desc">{prodotto.sommario}</p>

  <div
    class="swatches"
    data-foto-target={fotoId}
    data-nome-prodotto={prodotto.nome}
    data-scorte={JSON.stringify(
      Object.fromEntries(prodotto.colori.map((c) => [c.slug, etichettaScorta(c)]))
    )}
    data-foto={JSON.stringify(fotoPerColore)}
  >
    {prodotto.colori.map((c) => (
      <button
        type="button"
        class:list={['sw', { on: c.slug === coloreAttivo.slug }]}
        data-c={c.slug}
        data-nome={c.nome}
        data-stock={c.stock}
        title={c.nome}
        disabled={c.stock === 0}
        aria-label={c.nome + (c.stock === 0 ? ' (esaurito)' : '')}
        aria-pressed={c.slug === coloreAttivo.slug ? 'true' : 'false'}
        style={MACRO_PELLE[c.slug] ? `background-image:url(${MACRO_PELLE[c.slug]})` : undefined}
      ></button>
    ))}
    <span class="sw-label">{etichettaScorta(coloreAttivo)}</span>
  </div>

  <div class:list={['scheda__bottoni', { 'scheda__bottoni--due': VENDITA_ATTIVA }]}>
    <a href={url} class="pulsante">{prodotto.scopri}</a>
    {VENDITA_ATTIVA && (
      <button
        type="button"
        class="pulsante v-aggiungi"
        data-slug={prodotto.slug}
        data-nome={prodotto.nome}
        data-colore={coloreAttivo.slug}
        data-colore-nome={coloreAttivo.nome}
        data-stock={coloreAttivo.stock}
      >Aggiungi al carrello</button>
    )}
  </div>
</div>

<style>
  .scheda { display: flex; flex-direction: column; color: inherit; }
  /* Riquadro a proporzioni fisse (Founder, 02/09/2026): senza, l'immagine
     rendeva alla sua dimensione intrinseca e una scheda arrivava a occupare
     quasi tutto lo schermo. object-fit:cover riempie senza mai deformare —
     ritaglia, non stira. */
  .scheda__foto {
    display: block; text-decoration: none;
    aspect-ratio: 4 / 5; overflow: hidden; background: var(--sunk);
  }
  .scheda__foto > * { display: block; width: 100%; height: 100%; }
  .scheda__foto img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Stessa correzione già applicata in VetrinaProdotti.astro (home,
     03/09/2026): le foto di copertina non sono state scattate alla stessa
     distanza dal soggetto — misurato sui pixel reali di QUESTA pagina, non
     a occhio: il portafoglio Sottile (blu) riempie il 70,3%×46,6% del
     riquadro, il Completo (marrone) il 76,9%×50,0%. Stesso zoom
     correttivo, solo sulla scheda più piccola. */
  .scheda__foto--sottile img { transform: scale(1.08); }
  @media (max-width: 680px) {
    /* Limite in vh, non solo aspect-ratio: su schermi molto stretti e alti
       4/5 da solo può comunque superare metà schermo. */
    .scheda__foto { max-height: 55vh; }
  }

  .p-name { font-size: 31px; margin: 8px 0 0; line-height: 1.1; }
  .p-name a { text-decoration: none; color: inherit; }
  .p-name a:hover { color: var(--brass); }
  .p-desc { margin: 14px 0 0; color: var(--ink2); font-size: 17.5px; line-height: 1.6; }

  .scheda__bottoni { display: grid; grid-template-columns: 1fr; gap: 12px; margin-top: auto; padding-top: 22px; }
  .scheda__bottoni--due { grid-template-columns: 1fr 1fr; }
  .scheda__bottoni .pulsante { text-align: center; }
</style>

<script>
  import { initAggiungiRapido } from '../scripts/aggiungi-rapido.js';

  document.querySelectorAll('.swatches[data-foto-target]').forEach((gruppo) => {
    const nomeProdotto = gruppo.getAttribute('data-nome-prodotto') || '';
    const scorte = JSON.parse(gruppo.getAttribute('data-scorte') || '{}');
    const fotoPerColore = JSON.parse(gruppo.getAttribute('data-foto') || '{}');
    const foto = document.getElementById(gruppo.getAttribute('data-foto-target') || '');
    const didascalia = foto?.querySelector('b');
    // Presenti solo quando fotoAttiva esisteva in build (<picture>, non il
    // segnaposto): sorgenteWebp e immagine restano null nell'altro caso, i
    // controlli sotto li saltano senza errori.
    const sorgenteWebp = foto?.querySelector('source[type="image/webp"]');
    const immagine = foto?.querySelector('img');
    const etichetta = gruppo.querySelector('.sw-label');

    gruppo.querySelectorAll('.sw').forEach((sw) => {
      sw.addEventListener('click', () => {
        if (sw.hasAttribute('disabled')) return;
        gruppo.querySelectorAll('.sw').forEach((x) => {
          x.classList.remove('on');
          x.setAttribute('aria-pressed', 'false');
        });
        sw.classList.add('on');
        sw.setAttribute('aria-pressed', 'true');
        const slug = sw.getAttribute('data-c') || '';

        const nuovaFoto = fotoPerColore[slug];
        if (nuovaFoto && immagine) {
          if (sorgenteWebp) sorgenteWebp.srcset = nuovaFoto.webp;
          immagine.src = nuovaFoto.jpg;
          immagine.alt = nuovaFoto.alt;
          immagine.width = nuovaFoto.width;
          immagine.height = nuovaFoto.height;
        }
        if (didascalia) {
          didascalia.textContent = `Foto — ${nomeProdotto}, ${(sw.getAttribute('data-nome') || '').toLowerCase()}`;
        }
        if (etichetta && scorte[slug]) etichetta.textContent = scorte[slug];
      });
    });
  });

  initAggiungiRapido();
</script>
