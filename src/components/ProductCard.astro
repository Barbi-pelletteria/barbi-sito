---
import { PLACEHOLDER } from '../data/prodotti.js';
const { prodotto } = Astro.props;
---
<a class="scheda-prodotto" href={`/prodotto/${prodotto.slug}/`}>
  <img src={prodotto.immagine} alt={prodotto.nome === PLACEHOLDER ? 'Immagine prodotto da caricare' : prodotto.nome} loading="lazy" />
  <div class="scheda-prodotto__corpo">
    <p class="scheda-prodotto__nome segnaposto">{prodotto.nome}</p>
    <p class="scheda-prodotto__prezzo segnaposto">{PLACEHOLDER}</p>
  </div>
</a>

<style>
  .scheda-prodotto {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--bordo);
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .scheda-prodotto:hover {
    box-shadow: 0 6px 18px rgba(43, 35, 24, 0.1);
    transform: translateY(-2px);
  }
  .scheda-prodotto img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    background: var(--crema-scuro);
  }
  .scheda-prodotto__corpo { padding: 1rem; }
  .scheda-prodotto__nome { margin: 0 0 0.3rem; font-weight: 500; }
  .scheda-prodotto__prezzo { margin: 0; }
</style>
