---
import { macroProdotto } from '../data/immagini.js';

// "Come nasce un portafoglio": cinque passi numerati 01-05.
// Testi verbatim dall'anteprima approvata.
//
// Il terzo passo dice che la cucitura è a macchina, e la rivendica. Non è una
// svista: nasconderlo è ciò che fa sembrare un sito insincero.
//
// Macro della pelle marrone (PACCHETTO_MACRO_PELLE, richiesta diretta del
// Founder) sul primo passo, "La pelle" — l'unico dei cinque il cui testo
// parla proprio del materiale. Marrone per scelta esplicita, non per
// disponibilità: le altre due macro (blu, bordeaux) sono comunque pronte,
// usate nella galleria prodotto.
const macroPelle = macroProdotto('marrone');
const passi = [
  {
    titolo: 'La pelle',
    testo: 'Capra conciata al vegetale, spessore 1,2-1,3 mm. Conciata e tinta con metodi naturali, senza protezioni chimiche: è un materiale vivo, e si comporta come tale.',
  },
  {
    titolo: 'Il taglio',
    testo: 'Ogni pelle ha zone più tese e zone più morbide. Da dove si taglia un pezzo decide come invecchierà: è la parte che non si può insegnare in fretta.',
  },
  {
    titolo: 'Il montaggio e la cucitura',
    testo: 'Le parti si montano a mano, la cucitura si fa a macchina — una macchina da pelletteria, guidata punto per punto. Non lo nascondiamo: è come si lavora in un laboratorio vero, e tiene meglio di una cucitura a mano fatta di fretta.',
  },
  {
    titolo: 'I bordi, a mano',
    testo: 'Tinti uno per uno, a pennello. È la lavorazione più lunga e quella che si vede di più: quando un portafoglio sembra fatto bene, quasi sempre stai guardando i bordi.',
  },
  {
    titolo: 'Le iniziali, se le vuoi',
    testo: 'Impresse sulla pelle in cinque minuti, prima che il pezzo esca dal laboratorio. Dieci euro, nessun giorno di attesa in più.',
  },
];
---
<div class="contenitore">
  <section class="sec">
    <div class="sec-top">
      <h2>Come nasce <em>un portafoglio</em></h2>
      <p>Due o tre ore di lavoro. Ecco dove finiscono.</p>
    </div>
    <div class="steps">
      {passi.map((p, i) => (
        <div class="step">
          <div>
            <h3>{p.titolo}</h3>
            <p>{p.testo}</p>
            {i === 0 && macroPelle && (
              <picture>
                <source srcset={macroPelle.webp} type="image/webp" />
                <img
                  class="step__macro"
                  src={macroPelle.jpg}
                  alt="Macrofotografia della pelle marrone conciata al vegetale, dettaglio della grana"
                  width={macroPelle.width}
                  height={macroPelle.height}
                  loading="lazy"
                />
              </picture>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</div>

<style>
  .steps { counter-reset: s; display: grid; gap: 16px; max-width: 760px; margin: 0 auto; }
  .step {
    counter-increment: s;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 26px;
    padding: 28px 26px;
    align-items: baseline;
    /* Cornice a cucitura: quattro trattini via gradiente ripetuto, non un
       bordo nativo (i dash di border-style:dashed non sono regolari fra i
       browser) e non un'immagine. */
    background:
      repeating-linear-gradient(90deg, rgba(var(--brass-rgb), .6) 0 4px, transparent 4px 8px) top / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, rgba(var(--brass-rgb), .6) 0 4px, transparent 4px 8px) bottom / 100% 1px no-repeat,
      repeating-linear-gradient(180deg, rgba(var(--brass-rgb), .6) 0 4px, transparent 4px 8px) left / 1px 100% no-repeat,
      repeating-linear-gradient(180deg, rgba(var(--brass-rgb), .6) 0 4px, transparent 4px 8px) right / 1px 100% no-repeat;
  }
  .step::before {
    content: counter(s, decimal-leading-zero);
    font-family: var(--f-label);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .12em;
    color: var(--brass-testo);
    padding-top: 6px;
  }
  /* Dettaglio angolare: due ribattini pieni. ::before sul riquadro è già il
     numero, quindi il secondo punto nasce sul div interno (senza position
     propria): si posiziona rispetto a .step lo stesso. */
  .step::after,
  .step > div::before {
    content: '';
    position: absolute;
    top: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brass);
  }
  .step::after { left: 9px; }
  .step > div::before { right: 9px; }
  .step h3 { margin: 0 0 6px; }
  .step p { margin: 0; color: var(--ink2); font-size: 17.5px; line-height: 1.6; }
  /* Macro pelle: un dettaglio a corredo del testo, non un'illustrazione a
     tutta larghezza — resta piccola e allineata a sinistra, dentro lo
     stesso riquadro a cucitura del passo "La pelle". */
  .step__macro { display: block; width: 132px; height: 132px; margin-top: 16px; object-fit: cover; border: 1px solid var(--line2); }
  @media (max-width: 560px) { .step { gap: 16px; padding: 24px 20px; } }
</style>
