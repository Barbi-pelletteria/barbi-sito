---
// "Come nasce un portafoglio Barbi": cinque passi numerati 01-05.
// Testi D-029 § 4.1 "Come nasce" (QG), non riscritti. Il numero "01 ·"
// davanti a ogni titolo viene dal contatore CSS (counter(s)), il titolo
// nel dato è la sola parte testuale.
//
// Il terzo passo dice che la cucitura è a macchina: non è una svista,
// nasconderlo è ciò che fa sembrare un sito insincero (divieto 15: mai
// "cucito a mano").
const passi = [
  {
    titolo: 'La pelle',
    testo: 'Capra conciata al vegetale, spessore 1,2-1,3 mm. Una concia lenta, senza protezioni chimiche: la pelle resta viva e con l’uso prende un tono che è solo tuo.',
  },
  {
    titolo: 'Il taglio',
    testo: 'Ogni pelle ha zone più tese e zone più morbide. Stefano sceglie da dove ricavare ogni pezzo: è da qui che dipende come invecchierà il portafoglio.',
  },
  {
    titolo: 'Montaggio e cucitura',
    testo: 'Le parti si montano a mano. La cucitura è eseguita con una macchina da pelletteria, guidata punto per punto: un punto regolare e serrato, fatto per durare.',
  },
  {
    titolo: 'I bordi',
    testo: 'Tinti a mano, uno per uno, a pennello. È il passaggio più lungo e il segno più chiaro di un lavoro fatto con cura.',
  },
  {
    titolo: 'Le iniziali',
    testo: 'Se le desideri, le tue iniziali vengono impresse sulla pelle prima della spedizione. 10 € in più, nessun giorno di attesa.',
  },
];
---
<div class="contenitore">
  <section class="sec">
    <div class="sec-top">
      <h2>Come nasce un portafoglio Barbi</h2>
      <p>Due o tre ore di lavoro, cinque passaggi, un solo standard.</p>
    </div>
    <div class="steps">
      {passi.map((p) => (
        <div class="step">
          <div>
            <h3>{p.titolo}</h3>
            <p>{p.testo}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</div>

<style>
  .steps { counter-reset: s; display: grid; gap: 16px; max-width: 760px; margin: 0 auto; }
  .step {
    counter-increment: s;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 26px;
    padding: 28px 26px;
    align-items: baseline;
    /* Cornice a cucitura: quattro trattini via gradiente ripetuto, non un
       bordo nativo (i dash di border-style:dashed non sono regolari fra i
       browser) e non un'immagine. */
    background:
      repeating-linear-gradient(90deg, rgba(var(--brass-rgb), .6) 0 4px, transparent 4px 8px) top / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, rgba(var(--brass-rgb), .6) 0 4px, transparent 4px 8px) bottom / 100% 1px no-repeat,
      repeating-linear-gradient(180deg, rgba(var(--brass-rgb), .6) 0 4px, transparent 4px 8px) left / 1px 100% no-repeat,
      repeating-linear-gradient(180deg, rgba(var(--brass-rgb), .6) 0 4px, transparent 4px 8px) right / 1px 100% no-repeat;
  }
  /* "01 ·" davanti al titolo, come nel pacchetto ("01 · La pelle"). */
  .step::before {
    content: counter(s, decimal-leading-zero) " ·";
    font-family: var(--f-label);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .12em;
    color: var(--brass-testo);
    padding-top: 6px;
  }
  /* Dettaglio angolare: due ribattini pieni. ::before sul riquadro è già il
     numero, quindi il secondo punto nasce sul div interno (senza position
     propria): si posiziona rispetto a .step lo stesso. */
  .step::after,
  .step > div::before {
    content: '';
    position: absolute;
    top: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brass);
  }
  .step::after { left: 9px; }
  .step > div::before { right: 9px; }
  .step h3 { margin: 0 0 6px; }
  .step p { margin: 0; color: var(--ink2); font-size: 17.5px; line-height: 1.6; }
  @media (max-width: 560px) { .step { gap: 16px; padding: 24px 20px; } }
</style>
