---
// Confronto reale dello spessore fra i modelli, in scala esatta fra loro.
// Il numero viene letto dalla voce "Spessore" già presente in specifiche —
// non è reinventato qui, solo disegnato. Nessun confronto con monete,
// telefoni o carte: non li abbiamo misurati.
const { prodotti, class: className = '' } = Astro.props;

function spessoreCm(prodotto) {
  const riga = prodotto.specifiche.find(([voce]) => voce === 'Spessore');
  const match = riga ? riga[1].match(/([\d,]+)/) : null;
  return match ? parseFloat(match[1].replace(',', '.')) : 0;
}

const righe = prodotti.map((p) => ({
  nome: p.nome,
  valore: spessoreCm(p),
  etichetta: p.specifiche.find(([voce]) => voce === 'Spessore')?.[1] || '',
}));
const max = Math.max(...righe.map((r) => r.valore), 0.01);

const BAR_X = 104;
const BAR_W = 232;
const BAR_H = 12;
const VALUE_X = BAR_X + BAR_W + 16;
const ROW_H = 36;
const PAD = 10;
const W = VALUE_X + 74;
const H = PAD * 2 + ROW_H * righe.length - (ROW_H - BAR_H);
---
<div class:list={['confronto-spessore', className]}>
  <p class="eyebrow confronto-spessore__titolo">Spessore a confronto</p>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Spessore a confronto: ${righe.map((r) => r.nome + ' ' + r.etichetta).join(', ')}`}>
    {righe.map((r, i) => {
      const y = PAD + i * ROW_H;
      const cy = y + BAR_H / 2;
      const w = (r.valore / max) * BAR_W;
      return (
        <g>
          <text x="0" y={cy} dominant-baseline="middle" class="ce-nome">{r.nome}</text>
          <rect x={BAR_X} y={y} width={BAR_W} height={BAR_H} class="ce-pista" />
          <rect x={BAR_X} y={y} width={w} height={BAR_H} class="ce-barra" />
          <text x={VALUE_X} y={cy} dominant-baseline="middle" class="ce-valore">{r.etichetta}</text>
        </g>
      );
    })}
  </svg>
</div>

<style>
  .confronto-spessore { max-width: 500px; }
  .confronto-spessore__titolo { margin-bottom: 16px; }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .ce-nome {
    font-family: var(--f-display); font-size: 17px; fill: var(--ink);
  }
  .ce-pista { fill: var(--sunk); }
  .ce-barra { fill: var(--brass); }
  .ce-valore {
    font-family: var(--f-label); font-size: 11px; letter-spacing: .09em;
    fill: var(--ink3); font-variant-numeric: tabular-nums;
  }
</style>
