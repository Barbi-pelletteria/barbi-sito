---
// Ricerca per nome e filtri (modello, colore) aggiunti il 27/08/2026
// (PACCHETTO_RIFINITURA + richiesta diretta del Founder). Filtrano solo su
// dati reali già nel catalogo — nessun attributo inventato (niente taglie,
// niente genere: quei dati non esistono in nessun documento del progetto).
import Layout from '../layouts/Layout.astro';
import ProductCard from './ProductCard.astro';
import { categorie, getProdottiByCategoria } from '../data/prodotti.js';

const { categoriaSlug } = Astro.props;
const categoria = categorie.find((c) => c.slug === categoriaSlug);
const prodottiCategoria = getProdottiByCategoria(categoriaSlug);

const modelli = [...new Set(prodottiCategoria.map((p) => p.nome))];
const coloriDisponibili = [...new Set(prodottiCategoria.flatMap((p) => p.colori.map((c) => c.nome)))];

// PACCHETTO_AUDIT_SITO blocco C: description specifica per categoria, non
// il default generico del sito. fatti/fatte si accorda a categoria.genere
// per lo stesso motivo del testo "pronti/pronte" qui sotto (C-16 in
// CORREZIONI.md — la stessa famiglia di bug, stavolta evitata da subito).
const fattoA = categoria.genere === 'f' ? 'fatte' : 'fatti';
const descrizioneCategoria = prodottiCategoria.length > 0
  ? `I ${categoria.nome.toLowerCase()} Barbi Pelletteria: pelle conciata al vegetale, ${fattoA} a mano a Casoria.`
  : `${categoria.nome} Barbi Pelletteria, in arrivo: pelle conciata al vegetale, ${fattoA} a mano a Casoria.`;
---
<Layout title={categoria.nome} description={descrizioneCategoria}>
  <div class="contenitore">
    <section class="sec">
      <div class="sec-top">
        <h1>{categoria.nome}</h1>
        <p>Quello che c’è davvero in laboratorio oggi. Non un catalogo: un banco di lavoro.</p>
      </div>

      {prodottiCategoria.length === 0 ? (
        <div class="categoria-vuota">
          <p class="segnaposto">Non ancora online: {categoria.nome.toLowerCase()} arriveranno nei prossimi mesi, quando {categoria.genere === 'f' ? 'saranno pronte' : 'saranno pronti'} in laboratorio.</p>
          <p><a class="pulsante pulsante-secondario" href="/portafogli/">Vedi i portafogli disponibili ora</a></p>
        </div>
      ) : (
        <>
          {(modelli.length > 1 || coloriDisponibili.length > 1) && (
            <details class="filtri-toggle" id="filtri-toggle">
              <summary class="filtri-toggle__riassunto">
                <span id="filtri-etichetta">Filtri</span>
              </summary>
              <div class="filtri" id="filtri-catalogo">
                <div class="filtri__cerca">
                  <label for="cerca-prodotto" class="sr-only">Cerca per nome</label>
                  <input type="search" id="cerca-prodotto" placeholder="Cerca per nome…" autocomplete="off" />
                </div>
                {modelli.length > 1 && (
                  <div class="filtri__gruppo" role="group" aria-label="Filtra per modello">
                    <span class="filtri__etichetta-gruppo">Modello</span>
                    <button type="button" class="filtro-chip is-attivo" data-filtro-modello="">Tutti</button>
                    {modelli.map((m) => <button type="button" class="filtro-chip" data-filtro-modello={m.toLowerCase()}>{m}</button>)}
                  </div>
                )}
                {coloriDisponibili.length > 1 && (
                  <div class="filtri__gruppo" role="group" aria-label="Filtra per colore">
                    <span class="filtri__etichetta-gruppo">Colore</span>
                    <button type="button" class="filtro-chip is-attivo" data-filtro-colore="">Tutti</button>
                    {coloriDisponibili.map((c) => <button type="button" class="filtro-chip" data-filtro-colore={c.toLowerCase()}>{c}</button>)}
                  </div>
                )}
              </div>
            </details>
          )}

          <p class="filtri__esito" id="filtri-esito" hidden>Nessun prodotto corrisponde alla ricerca.</p>

          <div class="grid2" id="griglia-prodotti">
            {prodottiCategoria.map((p) => (
              <div class="scheda-wrap" data-nome={p.nome.toLowerCase()} data-colori={p.colori.map((c) => c.nome.toLowerCase()).join(',')}>
                <ProductCard prodotto={p} />
              </div>
            ))}
          </div>

          {/* PACCHETTO_AUDIT_SITO punto B9: le altre categorie e il su
              misura restano una riga di testo, non un livello di
              navigazione — l'hub /prodotti/ è stato tolto. */}
          {categoriaSlug === 'portafogli' && (
            <p class="prossimamente">
              Presto anche <a href="/borse/">borse</a> e <a href="/portachiavi/">portachiavi</a>.
              Cerchi qualcosa su misura? <a href="/prodotto-personalizzato/">Chiedilo a Stefano</a>.
            </p>
          )}
        </>
      )}
    </section>
  </div>
</Layout>

<style>
  h1 { font-size: clamp(30px, 4.4vw, 44px); max-width: none; margin: 0 auto 12px; }

  .categoria-vuota { text-align: center; }
  .categoria-vuota .segnaposto { display: block; margin-bottom: 26px; }

  .prossimamente { text-align: center; margin: 48px 0 0; color: var(--ink3); font-size: 15px; }
  .prossimamente a { color: var(--brass-testo); }

  /* PACCHETTO_INTERFACCIA punto 4: chiusi di default ovunque (desktop e
     mobile, non solo sotto una soglia di larghezza), dietro <details>/
     <summary> — stato apri/chiudi nativo e accessibile, niente div con
     solo onclick. La spunta la fa il browser: nessun JS serve per
     aprire/chiudere, solo per il conteggio nell'etichetta. */
  .filtri-toggle { margin-bottom: 36px; }
  .filtri-toggle__riassunto {
    display: inline-flex; align-items: center; min-height: 44px;
    padding: 0 4px; cursor: pointer;
    font-family: var(--f-label); font-size: 12.5px; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink);
  }
  .filtri-toggle__riassunto::marker { color: var(--brass-testo); }
  .filtri-toggle__riassunto:hover { color: var(--brass-testo); }
  .filtri-toggle[open] .filtri-toggle__riassunto { margin-bottom: 4px; }

  /* Dimensioni ridotte del 10-15% rispetto a prima (gap, margini, padding
     dei controlli) ora che i filtri si aprono solo su richiesta — mai
     sotto min-height:44px sui controlli cliccabili, quello non si riduce. */
  .filtri {
    display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: flex-start;
    margin-bottom: 32px; padding: 24px 0 26px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .filtri__cerca { flex: 1 1 220px; }
  .filtri__cerca input {
    width: 100%; min-height: 44px; padding: 10px 14px; border: 1px solid var(--line2);
    background: var(--sunk); color: var(--ink); font-family: var(--f-text);
    /* font-size resta 16px, non ridotto: sotto 16px Safari iOS zooma la
       pagina al focus su un input — regressione peggiore di 2px risparmiati. */
    font-size: 16px;
  }
  .filtri__cerca input::placeholder { color: var(--ink3); }
  .filtri__gruppo { display: flex; flex-wrap: wrap; gap: 7px; align-items: center; }
  .filtri__etichetta-gruppo {
    font-family: var(--f-label); font-size: 9px; font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ink3); margin-right: 4px;
  }
  .filtro-chip {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--f-label); font-size: 10px; font-weight: 500; letter-spacing: .05em;
    padding: 6px 12px; border: 1px solid var(--line2); background: transparent; color: var(--ink2);
    cursor: pointer;
  }
  .filtro-chip.is-attivo { background: var(--brass); border-color: var(--brass); color: var(--ink); }
  .filtro-chip:hover:not(.is-attivo) { border-color: var(--brass); }

  .filtri__esito { color: var(--ink2); margin: 0 0 30px; }
  .scheda-wrap.is-nascosta { display: none; }
</style>

<script>
  const input = document.getElementById('cerca-prodotto');
  const contenitore = document.getElementById('filtri-catalogo');
  const griglia = document.getElementById('griglia-prodotti');
  const esito = document.getElementById('filtri-esito');
  const etichettaFiltri = document.getElementById('filtri-etichetta');

  if (griglia && esito) {
    const schede = Array.from(griglia.querySelectorAll('.scheda-wrap'));
    let filtroModello = '';
    let filtroColore = '';

    // PACCHETTO_INTERFACCIA punto 4: "Filtri (2)" quando ci sono filtri
    // attivi — altrimenti l'utente vede un catalogo filtrato senza sapere
    // perché. Testo di ricerca, modello e colore contano come un filtro
    // attivo ciascuno, indipendentemente dal risultato.
    function aggiornaEtichettaFiltri() {
      if (!etichettaFiltri) return;
      const testo = (input?.value || '').trim();
      const attivi = [testo.length > 0, !!filtroModello, !!filtroColore].filter(Boolean).length;
      etichettaFiltri.textContent = attivi > 0 ? `Filtri (${attivi})` : 'Filtri';
    }

    function applica() {
      const testo = (input?.value || '').trim().toLowerCase();
      let visibili = 0;
      schede.forEach((el) => {
        const nome = el.getAttribute('data-nome') || '';
        const colori = (el.getAttribute('data-colori') || '').split(',');
        const passaTesto = !testo || nome.includes(testo);
        const passaModello = !filtroModello || nome === filtroModello;
        const passaColore = !filtroColore || colori.includes(filtroColore);
        const mostra = passaTesto && passaModello && passaColore;
        el.classList.toggle('is-nascosta', !mostra);
        if (mostra) visibili++;

        // Filtrare per colore deve mostrare davvero quel colore sulla
        // scheda, non solo nascondere/mostrare la scheda intera: si
        // simula il click sulla stessa pastiglia già usata sulla scheda
        // (ProductCard.astro), così foto e scorte si aggiornano da sole.
        if (mostra && filtroColore) {
          const sw = el.querySelector(`.sw[data-c="${filtroColore}"]`);
          if (sw && !sw.disabled && !sw.classList.contains('on')) sw.click();
        }
      });
      esito.hidden = visibili > 0;
      aggiornaEtichettaFiltri();
    }

    input?.addEventListener('input', applica);

    contenitore?.querySelectorAll('[data-filtro-modello]').forEach((btn) => {
      btn.addEventListener('click', () => {
        filtroModello = btn.getAttribute('data-filtro-modello') || '';
        contenitore.querySelectorAll('[data-filtro-modello]').forEach((b) => b.classList.toggle('is-attivo', b === btn));
        applica();
      });
    });
    contenitore?.querySelectorAll('[data-filtro-colore]').forEach((btn) => {
      btn.addEventListener('click', () => {
        filtroColore = btn.getAttribute('data-filtro-colore') || '';
        contenitore.querySelectorAll('[data-filtro-colore]').forEach((b) => b.classList.toggle('is-attivo', b === btn));
        applica();
      });
    });
  }
</script>
