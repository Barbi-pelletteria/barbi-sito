---
// Tabella comparativa Sottile/Completo, aggiunta il 27/08/2026
// (PACCHETTO_VETRINA, punto 2). Ogni valore è letto da prodotti.js — nessun
// numero scritto qui. Spessore e peso si leggono da "specifiche" con lo
// stesso pattern già usato da ConfrontoSpessore.astro, per restare
// coerenti con l'unica fonte di verità di quei due valori.
const { prodotti, class: className = '' } = Astro.props;

function daSpecifiche(prodotto, voceCercata) {
  const riga = prodotto.specifiche.find(([voce]) => voce === voceCercata);
  return riga ? riga[1] : '—';
}

const righe = [
  { etichetta: 'Spessore da chiuso', valori: prodotti.map((p) => daSpecifiche(p, 'Spessore')) },
  { etichetta: 'Tasche per le carte', valori: prodotti.map((p) => `${p.tascheCarte}`) },
  { etichetta: 'Portamonete', valori: prodotti.map((p) => (p.portamonete ? 'Sì' : 'No')) },
  { etichetta: 'Peso', valori: prodotti.map((p) => daSpecifiche(p, 'Peso')) },
  { etichetta: 'Prezzo online', valori: prodotti.map((p) => `${(p.prezzoCentesimi / 100).toFixed(2).replace('.', ',')} €`) },
];
---
<div class:list={['tabella-confronto', className]}>
  <p class="eyebrow tabella-confronto__titolo">Sottile o Completo</p>
  <table>
    <thead>
      <tr>
        <th><span class="sr-only">Caratteristica</span></th>
        {prodotti.map((p) => <th>{p.nome}</th>)}
      </tr>
    </thead>
    <tbody>
      {righe.map((r) => (
        <tr>
          <th>{r.etichetta}</th>
          {r.valori.map((v) => <td>{v}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .tabella-confronto { max-width: 560px; }
  .tabella-confronto__titolo { margin-bottom: 16px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 12px 14px 12px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead th {
    font-family: var(--f-label); font-size: 9.5px; font-weight: 600; letter-spacing: .15em;
    text-transform: uppercase; color: var(--brass-testo);
  }
  thead th:first-child { width: 40%; }
  tbody th {
    font-family: var(--f-label); font-size: 13px; font-weight: 500; letter-spacing: .02em;
    color: var(--ink3);
  }
  td { color: var(--ink); font-size: 17px; font-variant-numeric: tabular-nums; }
  @media (max-width: 480px) {
    th, td { padding: 10px 8px 10px 0; font-size: 15px; }
    tbody th { font-size: 12px; }
  }
</style>
